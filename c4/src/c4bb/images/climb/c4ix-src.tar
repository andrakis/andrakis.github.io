C4TAR1
src/c4ix/boot.c 2526
//
// C4IX: boot.
//
// Twelve .c4o objects (boot, console, va, host, sl4b, task, sched,
// vfs, sys, c4ke, loader, init) compiled by c4lc -O -c and linked by
// c4rlink. Boots under c4m with preemptive scheduling and protected
// user tasks. C4IX images use C4CY, PUTC, JSRI and JSRS, which plain
// c4 lacks, so plain c4 runs C4IX through c4m itself
// (c4 -> c4m.c -> C4IX, `make test-c4ix-c4`) and C4IX still sees a c4m
// host. A host that is not c4m-compatible, with its trap machinery, is
// refused at boot: the cooperative, no-boundary path there once was for
// one was never reached, and went in docs/c4ix-cpu.md step 10.
//
// User tasks run behind protected mode, so their IO reaches the kernel
// whether they ask through libc4ix or just call printf and get trapped.
//

#include "c4ix.h"

// Cycles in a time slice: between hard IRQs (c4m), and the software slice
// sched_trap keeps on the syscall path. Measured on C4IX (docs/c4ix-cpu.md,
// step 5): against 10000, C4KE's, a syscall-bound task makes 6% more calls
// and 9% more under the desktop, and 100000 adds only 1% more for twice
// the wait. 0.5 ms at the browser's 100 MHz.
enum { PREEMPT_INTERVAL = 50000 };

int main(int argc, char **argv) {
    struct task *t;
    int info;

    sched_early();
    kprintf("C4IX booting, %d cycles spent loading the kernel image\n", __c4_cycles());
    info = host_detect();
    kprintf("c4ix: host %s, info 0x%x\n", host_name(), info);
    if (!host_has(C4IX_I_C4M)) {
        kputs("c4ix: panic: this host is not c4m: C4IX needs its traps and cycle interrupt\n");
        return 1;
    }
    kprintf("c4ix: protected mode %s, preemption on\n",
        host_has(C4IX_I_PROT) ? "on for user tasks" : "unavailable");

    // The VFS first: adopting the kernel task opens its console fds.
    vfs_init();
    sched_init(PREEMPT_INTERVAL);

    if (!(t = task_create("init", (int)&init_main, argc, (int)argv))) {
        kputs("c4ix: panic: cannot create init task\n");
        return 1;
    }
    // Cycles from VM start to the moment userland first runs. This
    // is the boot cost, and it is the one number that can be
    // compared with C4KE on equal terms: same VM, same counter, same
    // meaning (see docs/c4ix-design.md 7).
    kprintf("c4ix: task %d '%s' created, scheduling after %d cycles\n",
        t->id, t->name, __c4_cycles());

    sched_run();
    sched_stop();

    task_shutdown();
    sl4b_stats();
    kprintf("c4ix: shutdown complete, %d tasks remain\n", task_count());
    return 0;
}
src/c4ix/console.c 10692
//
// C4IX console: kputc, kputs, kprintf, and console input.
//
// All kernel output funnels through kputc, which uses only the PUTC
// opcode -- implemented by c4m and plain c4 alike. A task's output
// (con_write_task) goes a run of bytes at a time through the host's
// printf("%s"), as one PRTF; nothing else in C4IX calls it. Userland
// printf is a library over write(fd), and this is the kernel-side sink.
//
// Input does not go through fd 0. A read on fd 0 blocks the HOST,
// which means it blocks the whole virtual machine: every task stops
// while one of them waits for a keystroke, no signal is noticed, and
// the scheduler cannot run. Instead the kernel opens a second
// descriptor on the same terminal with O_NONBLOCK, and a read that
// finds nothing simply says so. c4sh does this too, and it works on
// both hosts -- measured on a delayed pipe, native c4m spun two
// million times without blocking, and the c4-hosted chain spun a
// quarter million before the data arrived.
//

#include "c4ix.h"

// Flag values as the host sees them. O_NONBLOCK is 0x800 on Linux;
// this is the same pair of constants c4sh defines for itself,
// because neither compiler has a header to get them from.
enum { CON_O_RDONLY = 0, CON_O_NONBLOCK = 0x800 };

enum { CON_BUF = 256 };

// Polling costs a host read() every time it is asked, and the
// scheduler asks -- once per blocked reader, at every scheduling
// decision. A compute-bound task traps thousands of times a second,
// so an ungated poll turns one shell sitting at a prompt into
// thousands of host syscalls a second, waiting on input that arrives
// at human speed. The gate allows at most one host read per
// CON_POLL_CYCLES of virtual time. Buffered bytes are always served
// first, so nothing already read is ever held back, and the worst
// case a reader can see is half a millisecond of extra latency.
enum { CON_POLL_CYCLES = 100000 };

static int  con_fd;             // the non-blocking descriptor, -1 = none
static char con_buf[CON_BUF];   // bytes read but not yet consumed
static int  con_len;
static int  con_pos;
static int  con_eof;
static int  con_gate;           // cycle count of the last host read
// /log/kernel (below): the file, what waits for it, and whether tasks'
// output is still logged -- declared up here, ahead of con_init
enum { CON_PRE = 2048, CON_LOG_MAX = 262144 };
static struct vnode *con_log;
static char con_pre[CON_PRE];
static int  con_npre;
static int  con_booting;

// Called once at boot. If the reopen fails -- no /dev/stdin, or a
// host that will not give us one -- con_fd stays -1 and everything
// below falls back to a blocking read on fd 0, which is what C4IX
// did before. Losing responsiveness is better than losing input.
void con_init() {
    con_booting = 1;
    con_fd = open("/dev/stdin", CON_O_RDONLY | CON_O_NONBLOCK);
    con_len = 0;
    con_pos = 0;
    con_eof = 0;
    con_gate = 0;
}

// Open the gate. Virtual cycles are the right clock while tasks are
// running and exactly the wrong one when the machine is asleep -- the
// counter stops during the idle nap, so a purely cycle-based gate
// would never reopen and a prompt with nothing else running would
// never see a keystroke. The idle loop calls this after each nap.
void con_wake() {
    con_gate = 0;
}

// 1 if a console read can be answered without stopping the machine.
// End of file counts: a read there returns 0 immediately.
//
// Polling has to do the reading, because a non-blocking read is the
// only way to ask "is there anything?" and it consumes what it finds.
// So what it finds is buffered here and con_read serves from that.
int con_poll() {
    int n, now;

    if (con_pos < con_len) return 1;
    if (con_eof) return 1;
    if (con_fd < 0) return 1;      // blocking fallback: pretend, then block

    now = __c4_cycles();
    if (con_gate && now - con_gate < CON_POLL_CYCLES) return 0;
    con_gate = now ? now : 1;      // 0 means "open", so never store it

    con_pos = 0;
    con_len = 0;
    n = read(con_fd, con_buf, CON_BUF);
    if (n > 0) { con_len = n; return 1; }
    if (n == 0) { con_eof = 1; return 1; }
    return 0;                      // nothing there yet
}

int con_read(char *buf, int len) {
    int n, i;

    if (con_fd < 0) return read(0, buf, len);
    if (con_pos >= con_len) {
        if (con_eof) return 0;
        if (!con_poll()) return 0;
        if (con_pos >= con_len) return 0;
    }
    n = con_len - con_pos;
    if (n > len) n = len;
    i = 0;
    while (i < n) { buf[i] = con_buf[con_pos + i]; ++i; }
    con_pos = con_pos + n;
    return n;
}

// /log/kernel: what the console said. The kernel's own lines always;
// the tasks' only while booting (until init starts the shell), or top's
// redraws would fill it within minutes. Lines from before the VFS exists
// wait in con_pre. It stops at CON_LOG_MAX: a log, not a ring.

static void con_logc(int c) {
    if (con_log) vfs_logc(con_log, c, CON_LOG_MAX);
    else if (con_npre < CON_PRE) { con_pre[con_npre] = c; ++con_npre; }
}
static int con_out(int c) {
    putchar(c);
    con_logc(c);
    return c;
}

// The VFS is up: make /log/kernel and put what was said so far in it.
void con_logopen() {
    int i;
    if (!(con_log = vfs_klog())) return;
    i = 0;
    while (i < con_npre) { vfs_logc(con_log, con_pre[i], CON_LOG_MAX); ++i; }
    con_npre = 0;
}

// Boot is over: tasks' output is no longer logged.
void con_booted() { con_booting = 0; }

// A task's bytes to the console (vfs_write): up to CON_RUN at a time as
// one host printf("%s"), where putchar is one host call a byte. Under
// libjs's parallel CPUs a host call another CPU makes is a request to
// CPU 0, made holding the kernel lock: top on CPU 1 drew its screen a
// byte a request, and a game on CPU 0, which needs the lock for every
// syscall, stalled once a second. A NUL, which would end the string,
// goes by putchar.
enum { CON_RUN = 256 };
void con_write_task(char *buf, int len) {
    char run[CON_RUN + 1];
    int i, n;

    i = 0;
    while (i < len) {
        n = 0;
        while (i < len && n < CON_RUN && buf[i]) { run[n] = buf[i]; ++n; ++i; }
        if (n) { run[n] = 0; printf("%s", run); }
        if (i < len && !buf[i]) { putchar(0); ++i; }
    }
    if (con_booting) { i = 0; while (i < len) { con_logc(buf[i]); ++i; } }
}

int kputc(int c) {
    con_out(c);
    return c;
}

int kputs(char *s) {
    int n;
    n = 0;
    if (!s) s = "(null)";
    while (*s) { con_out(*s); ++s; ++n; }
    return n;
}

// Digits of v in base: decimal signed, with a minus sign; hex unsigned,
// as printf's %x (the shift's top nibble masked, as kputptr does, so a
// word above 0x80000000 is its digits, not a minus sign). WIDTH pads to
// that many characters: with zeros after the sign when ZERO, with spaces
// on the right when LEFT, else spaces on the left. Returns the character
// count. (Most-negative int wraps on negation; kernel prints don't go
// there.)
static int kputnum(int v, int base, int width, int zero, int left) {
    char buf[24];
    char *digits;
    int i, n, neg, mask;

    digits = "0123456789abcdef";
    i = 0;
    neg = 0;
    if (base == 16) {
        mask = ~(15 << (sizeof(int) * 8 - 4));
        if (v == 0) { buf[i] = '0'; ++i; }
        while (v) { buf[i] = digits[v & 15]; ++i; v = (v >> 4) & mask; }
    } else {
        if (v < 0) { neg = 1; v = -v; }
        if (v == 0) { buf[i] = '0'; ++i; }
        while (v) {
            buf[i] = digits[v % base]; ++i;
            v = v / base;
        }
    }
    n = i + neg;
    if (!left && !zero) while (n < width) { con_out(' '); ++n; }
    if (neg) con_out('-');
    if (!left && zero) while (n < width) { con_out('0'); ++n; }
    while (i) { --i; con_out(buf[i]); }
    if (left) while (n < width) { con_out(' '); ++n; }
    return n;
}

// s, padded to WIDTH with spaces, on the right when LEFT
static int kputpad(char *s, int width, int left) {
    int n, len;
    len = 0;
    while (s[len]) ++len;
    n = len;
    if (!left) while (n < width) { con_out(' '); ++n; }
    kputs(s);
    if (left) while (n < width) { con_out(' '); ++n; }
    return n;
}

// A pointer, as glibc's %p prints it and c4m's PRTF with it: 0x and
// its hex digits, unsigned, or (nil). The shift's top nibble is masked
// off so a pointer above 0x80000000 does not sign-extend forever.
static int kputptr(int v) {
    char buf[24];
    char *digits;
    int i, n, mask;

    if (!v) return kputs("(nil)");
    digits = "0123456789abcdef";
    mask = ~(15 << (sizeof(int) * 8 - 4));
    i = 0;
    while (v) { buf[i] = digits[v & 15]; ++i; v = (v >> 4) & mask; }
    con_out('0'); con_out('x');
    n = i + 2;
    while (i) { --i; con_out(buf[i]); }
    return n;
}

// %d %x %p %s %c %%, with printf's width and its 0 and - flags on %d,
// %x and %s: "0x%08x" is eight hex digits, zeros first; "%-12s" a name
// in twelve columns. Anything else prints verbatim. Returns characters
// written, printf-style.
//
// va_end must see ap exactly where va_start left it -- it re-reads
// the count slot from there to pop the va area. So the format loop
// walks a copy and ap itself never moves.
//
// The body runs under sched_lock: a line is atomic against
// preemption, so no cycle interrupt can interleave two tasks' lines.
int kprintf(char *fmt, ...) {
    va_list ap;    // one declarator per line: va_list is `int *`, so
    va_list walk;  // `va_list a, b` would make b a plain int
    int n, c, width, zero, left;

    sched_lock();
    va_start(ap, fmt);
    walk = ap;
    n = 0;
    while (*fmt) {
        c = *fmt; ++fmt;
        if (c != '%') { con_out(c); ++n; }
        else if (*fmt == 0) { con_out('%'); ++n; }
        else {
            // flags and a width: %08x, %-12s
            zero = 0; left = 0; width = 0;
            while (*fmt == '0' || *fmt == '-') { if (*fmt == '0') zero = 1; else left = 1; ++fmt; }
            while (*fmt >= '0' && *fmt <= '9') { width = width * 10 + (*fmt - '0'); ++fmt; }
            if (left) zero = 0;
            c = *fmt;
            if (c) ++fmt;
            if (c == 'd')      n = n + kputnum(va_arg(walk, int), 10, width, zero, left);
            else if (c == 'x') n = n + kputnum(va_arg(walk, int), 16, width, zero, left);
            else if (c == 'p') n = n + kputptr(va_arg(walk, int));
            else if (c == 's') n = n + kputpad(va_arg(walk, char *), width, left);
            else if (c == 'c') { con_out(va_arg(walk, int)); ++n; }
            else if (c == '%') { con_out('%'); ++n; }
            else if (c) { con_out('%'); con_out(c); n = n + 2; }
            else { con_out('%'); ++n; }
        }
    }
    va_end(ap);
    sched_unlock();
    return n;
}
src/c4ix/va.c 2874
//
// C4IX varargs: the one va area for the whole image.
//
// See c4ix.h for why this is a module of its own: the stock stdarg.h
// makes everything static, and statics never merge across objects,
// so caller and callee would account against different counters.
//

#include "c4ix.h"

enum { VA_STACK = 256 };

static int *va_stack;
static int  va_vptr;

// __c4cc_make_va runs while the outer call's arguments are already
// on the stack, so it keeps its working state in globals, exactly
// like the stock stdarg.h implementation it replaces.
static int *va_m_ptr;
static int *va_m_arg;
static int  va_m_n;

// The compiler inserts a call to this at every variadic call site;
// its result rides in the variadic fake slot that va_start reads.
//
// It takes sched_lock and does NOT release it: the matching release
// is in __c4ix_va_adj, which va_end calls. The lock therefore spans
// the whole variadic call, and it has to.
//
// The area is one shared LIFO, but a variadic call is not atomic:
// the compiler emits "push args; call make_va; call the function",
// and va_end runs inside the callee. Let preemption in anywhere
// between and two tasks interleave push/pop on one stack. Pops go by
// COUNT, not position, so a task popping its own arguments can
// rewind the cursor BELOW another task's still-live arguments -- the
// next push then overwrites them, and the victim reads a %s pointer
// that is now an integer. That fault looks like a wild load in the
// VM, nowhere near the kprintf that caused it.
//
// Holding the lock across the call makes every variadic call atomic
// against preemption, which also gives kprintf its line atomicity.
// The contract: a variadic callee MUST use va_start/va_end, or the
// lock leaks. In this kernel kprintf is the only one.
int *__c4cc_make_va(int count) {
    sched_lock();
    va_m_n   = count;
    va_m_arg = &count + count;
    va_m_ptr = &va_stack[va_vptr];

    // The count first (va_end pops it and the args in one adjust),
    // then the arguments in source order.
    va_stack[va_vptr] = count; ++va_vptr;
    while (va_m_n--) {
        va_stack[va_vptr] = *va_m_arg; ++va_vptr;
        --va_m_arg;
    }
    return va_m_ptr;   // lock stays held until __c4ix_va_adj
}

// va_end's release half, extern so every module pops the same
// counter -- and the release of the lock __c4cc_make_va took.
void __c4ix_va_adj(int n) {
    va_vptr = va_vptr - n;
    sched_unlock();
}

static void __attribute__((constructor)) va_ctor() {
    int bytes;
    if (!(va_stack = malloc(bytes = sizeof(int) * VA_STACK))) {
        // kprintf needs this module, so the panic path is putchar-only
        kputs("c4ix: panic: va area allocation failed\n");
        exit(-1);
    }
    memset(va_stack, 0, bytes);
    va_vptr = 0;
}

static void __attribute__((destructor)) va_dtor() {
    if (va_stack) free(va_stack);
}
src/c4ix/host.c 1196
//
// C4IX host detection.
//
// One INFO opcode tells the kernel what it is standing on: c4m returns
// its C4I_* feature bits. (Plain c4 has no INFO at all; it runs C4IX
// only through c4m.c, and then C4IX sees c4m.) Anything that depends on
// a feature asks this module instead of probing.
//

#include "c4ix.h"

static int hinfo;
static int detected;

int host_detect() {
    hinfo = __c4_info();
    detected = 1;
    return hinfo;
}

int host_info() {
    if (!detected) host_detect();
    return hinfo;
}

// What a TASK is told. host_info() was read at boot, before the kernel
// installed its trap handler, so it lacks C4I_TRAPH (0x400) -- and that
// bit is the machine's promise that probing a custom opcode is safe,
// which for a task under C4IX it is: every one of them lands in this
// kernel. C4KE's tools test it before asking for OP_VFS_PUT, so without
// it c4cc could not write what it compiled. Everything else verbatim.
int task_info() {
    return host_info() | 0x400;
}

int host_has(int bit) {
    return (host_info() & bit) == bit;
}

// The only host C4IX runs on (boot.c refuses any other).
char *host_name() {
    return host_has(C4IX_I_C4M) ? "c4m" : "not c4m";
}
src/c4ix/sl4b.c 2620
//
// SL4B: the C4IX slab allocator.
//
// Fixed-size kernel objects (task structs first; fds and vnodes will
// join in X3) come from per-type caches instead of malloc-per-object.
// A cache grows by malloc'ing a slab of `perslab` objects and
// threading them onto a freelist; alloc pops, free pushes. Slabs are
// never returned to the host -- freed objects stay cached for reuse,
// which is the point.
//

#include "c4ix.h"

static struct sl4b_cache *caches;   // all caches, for sl4b_stats

static void sl4b_namecpy(char *dst, char *src) {
    int i;
    i = 0;
    while (src[i] && i < SL4B_NAME_MAX - 1) { dst[i] = src[i]; ++i; }
    dst[i] = 0;
}

// Add one slab's worth of objects to the freelist.
static int sl4b_grow(struct sl4b_cache *c) {
    struct sl4b_slab *s;
    char *obj;
    int i;

    if (!(s = (struct sl4b_slab *)malloc(sizeof(struct sl4b_slab) + c->objsize * c->perslab)))
        return 0;
    s->next = c->slabs;
    c->slabs = s;
    ++c->nslabs;

    obj = (char *)s + sizeof(struct sl4b_slab);
    i = 0;
    while (i < c->perslab) {
        *(int *)obj = (int)c->freelist;
        c->freelist = (int *)obj;
        obj = obj + c->objsize;
        ++i;
    }
    return 1;
}

struct sl4b_cache *sl4b_cache_create(char *name, int objsize, int perslab) {
    struct sl4b_cache *c;

    if (!(c = (struct sl4b_cache *)malloc(sizeof(struct sl4b_cache)))) return 0;
    // round the object size up to whole words: the freelist threads a
    // pointer through the first word of every free object
    c->objsize = (objsize + 7) / 8 * 8;
    if (c->objsize < 8) c->objsize = 8;
    c->perslab = perslab;
    c->slabs = 0;
    c->freelist = 0;
    c->nallocs = 0;
    c->nfrees = 0;
    c->nslabs = 0;
    sl4b_namecpy(c->name, name);
    c->next = caches;
    caches = c;
    return c;
}

char *sl4b_alloc(struct sl4b_cache *c) {
    int *obj;

    sched_lock();
    if (!c->freelist) {
        if (!sl4b_grow(c)) { sched_unlock(); return 0; }
    }
    obj = c->freelist;
    c->freelist = (int *)*obj;
    ++c->nallocs;
    sched_unlock();
    memset(obj, 0, c->objsize);
    return (char *)obj;
}

void sl4b_free(struct sl4b_cache *c, char *obj) {
    sched_lock();
    *(int *)obj = (int)c->freelist;
    c->freelist = (int *)obj;
    ++c->nfrees;
    sched_unlock();
}

void sl4b_stats() {
    struct sl4b_cache *c;
    c = caches;
    while (c) {
        kprintf("sl4b: cache '%s' objsize %d perslab %d slabs %d allocs %d frees %d live %d\n",
            c->name, c->objsize, c->perslab, c->nslabs,
            c->nallocs, c->nfrees, c->nallocs - c->nfrees);
        c = c->next;
    }
}
src/c4ix/task.c 16755
//
// C4IX tasks: a singly linked task list with no fixed capacity.
// Task structs come from an SL4B cache (the user's requirement:
// no malloc-per-task); 64KB stacks and loaded images stay plain
// malloc -- variable-size things are not slab material.
//
// task_head is shared extern data: sched.c walks the list directly
// through the L8 extern-data link support. task_next() wraps from
// the tail back to the head -- the round-robin walk the scheduler
// context-switches along.
//

#include "c4ix.h"

struct task *task_head;
int task_last_syscalls;      // syscalls made by the most recently reaped task
static struct task *task_tail;
static struct sl4b_cache *task_cache;
static int ntasks;
static int nextid;

static void namecpy(char *dst, char *src) {
    int i;
    i = 0;
    while (src[i] && i < TASK_NAME_MAX - 1) { dst[i] = src[i]; ++i; }
    dst[i] = 0;
}

static struct task *task_alloc(char *name) {
    struct task *t;
    if (!task_cache)
        if (!(task_cache = sl4b_cache_create("task", sizeof(struct task), 16)))
            return 0;
    if (!(t = (struct task *)sl4b_alloc(task_cache))) return 0;
    t->id = nextid;
    namecpy(t->name, name);
    return t;
}

static void task_append(struct task *t) {
    sched_lock();
    ++nextid;
    ++sched_nlive;
    if (task_tail) task_tail->next = t; else task_head = t;
    task_tail = t;
    ++ntasks;
    sched_unlock();
}

struct task *task_create(char *name, int entry, int argc, int argv) {
    struct task *t;
    struct task *parent;
    if (!(t = task_alloc(name))) return 0;
    t->entry = entry;
    t->state = TS_READY;
    if (!sched_forge(t, entry, argc, argv)) {
        sl4b_free(task_cache, (char *)t);
        return 0;
    }
    // Inherit the creator's descriptors, sharing the open file
    // descriptions -- a redirected fd 1 stays redirected in the
    // child, which is redirection without fork.
    sched_lock();
    if ((parent = sched_current())) {
        fd_clone(t, parent);
        t->cwd = parent->cwd;      // children start where the parent is
        t->parent = parent->id;
        // and with its environment, as execve last gave it
        if (parent->env_vec) task_strvec((char **)parent->env_vec, -1, &t->env_vec, &t->env_data);
    }
    else fd_init_console(t);
    task_append(t);
    sched_unlock();
    return t;
}

// The vfork child (sched_vfork). Its stack is its own: the parent's frames
// below the one that called vfork must survive the child's calls, which
// is the one thing a stack machine's vfork cannot share (sched.c).
struct task *task_vchild(struct task *p) {
    struct task *t;
    if (!(t = task_alloc(p->name))) return 0;
    t->state = TS_READY;
    if (!sched_forge(t, 0, 0, 0)) {
        sl4b_free(task_cache, (char *)t);
        return 0;
    }
    sched_lock();
    fd_clone_all(t, p);
    t->cwd = p->cwd;
    t->parent = p->id;
    t->privs = p->privs;
    t->cpumask = p->cpumask;
    t->nice = p->nice;
    t->spawn_stack = p->spawn_stack;
    t->img_libs = p->img_libs;
    t->img_nlibs = p->img_nlibs;
    t->vfparent = p;
    if (p->env_vec) task_strvec((char **)p->env_vec, -1, &t->env_vec, &t->env_data);
    task_append(t);
    sched_unlock();
    return t;
}

// Its execve or its exit: the parent's memory is the parent's again,
// and the parent goes on from its vfork, which returns the child's id
// (already in its saved accumulator).
void task_unborrow(struct task *t) {
    struct task *p;
    if (!(p = t->vfparent)) return;
    t->vfparent = 0;
    t->img_libs = 0;
    t->img_nlibs = 0;
    if (p->state == TS_VFORK && p->wait_for == t->id) p->state = TS_READY;
}

int task_strvec(char **v, int n, int *pvec, int *pdata) {
    char **vec;
    char *blob, *p;
    int i, k, bytes;

    *pvec = 0;
    *pdata = 0;
    if (!v) return 0;
    if (n < 0) { n = 0; while (v[n]) ++n; }
    bytes = 1;
    i = 0;
    while (i < n) {
        if (v[i]) { k = 0; while (v[i][k]) ++k; bytes = bytes + k + 1; }
        else bytes = bytes + 1;
        ++i;
    }
    if (!(vec = (char **)malloc((n + 1) * sizeof(int)))) return -1;
    if (!(blob = (char *)malloc(bytes))) { free((int *)vec); return -1; }
    p = blob;
    i = 0;
    while (i < n) {
        vec[i] = p;
        if (v[i]) { k = 0; while (v[i][k]) { *p = v[i][k]; ++p; ++k; } }
        *p = 0; ++p;
        ++i;
    }
    vec[n] = 0;
    *pvec = (int)vec;
    *pdata = (int)blob;
    return n;
}

// Turn the currently running context (boot) into a task: no forged
// stack, nothing saved until the first switch away.
struct task *task_adopt(char *name) {
    struct task *t;
    if (!(t = task_alloc(name))) return 0;
    t->state = TS_RUNNING;
    t->sv = SV_NONE;
    fd_init_console(t);
    task_append(t);
    return t;
}

void task_unlink(struct task *t) {
    struct task *p;
    sched_lock();
    if (task_head == t) task_head = t->next;
    else {
        p = task_head;
        while (p) {
            if (p->next == t) { p->next = t->next; p = 0; }
            else p = p->next;
        }
    }
    if (task_tail == t) {
        task_tail = task_head;
        while (task_tail && task_tail->next) task_tail = task_tail->next;
    }
    --ntasks;
    sched_unlock();
}

struct task *task_reaplist;   // released, waiting to be freed (sched_trap checks it)

// ---- reaping, and remembering what was reaped ----
//
// A zombie used to be released only by whoever waited on it, or by
// the shutdown drain. Nothing else reaped, so a parent that never
// waits leaves its children on the list for the whole run -- and one
// exists: C4KE's innerbench spawns several benches, can only wait on
// one (C4KE has no group wait), and polls the rest instead. Under
// C4IX they simply accumulated.
//
// So the idle loop sweeps them, which is what C4KE's idle task does
// and what task_release's own comment already pointed at. The race
// that makes it delicate is a parent that waits AFTER its child has
// been swept: task_get returns nothing and the wait yields -1 instead
// of the exit code. This table closes it -- the last few exit statuses
// outlive their tasks, so a late wait still gets the right answer.
//
// A ghost the sweep made also keeps its parent, for a waitpid(-1) that
// comes later; one collected by a wait does not (-1), so it is not
// handed out twice.
enum { TASK_GHOSTS = 32 };
static int ghost_id[TASK_GHOSTS];
static int ghost_code[TASK_GHOSTS];
static int ghost_parent[TASK_GHOSTS];
static int ghost_sig[TASK_GHOSTS];
static int ghost_next;

static void task_remember(struct task *t) {
    ghost_id[ghost_next] = t->id;
    ghost_code[ghost_next] = t->exitcode;
    ghost_parent[ghost_next] = -1;
    ghost_sig[ghost_next] = t->killsig;
    ghost_next = (ghost_next + 1) % TASK_GHOSTS;
}

int task_ghost_child(int parent, int pid, int *pcode, int *psig) {
    int i;
    i = 0;
    while (i < TASK_GHOSTS) {
        if (ghost_parent[i] == parent && ghost_id[i] && (pid == -1 || ghost_id[i] == pid)) {
            ghost_parent[i] = -1;
            *pcode = ghost_code[i];
            *psig = ghost_sig[i];
            return ghost_id[i];
        }
        ++i;
    }
    return 0;
}

// 1 if ID was a task we reaped, with its exit code out through PCODE.
int task_ghost(int id, int *pcode) {
    int i;
    i = 0;
    while (i < TASK_GHOSTS) {
        if (ghost_id[i] == id) { *pcode = ghost_code[i]; return 1; }
        ++i;
    }
    return 0;
}

// ---- a task's own memory ----
//
// SYS_SBRK (libc4ix's ualloc) and malloc behind protected mode (sys.c's
// C4IX_OP_MALC) are kernel malloc. They used to be nothing more, so what
// a program did not free outlived it: every run of crc32 or cc left its
// tables behind, and a b4ke build inside C4IX climbed towards the top of
// the arena. Each block now carries a header that puts it on its task's
// list, and task_destroy frees the list.
//
//   h[0] next block's header        h[2] bytes asked for
//   h[1] address of the word that   h[3] UBLOCK_MAGIC, so a free can
//        points here (&t->ublocks        tell its blocks from anything
//        or the previous h[0])           else (0 once freed)
//
// The back link is to a WORD, not a block, so a block unlinks without
// knowing whose it is. Four words keep the caller's pointer as aligned as
// malloc's.
//
// Only a protected task's blocks are listed. An unprotected one executes
// FREE on the host itself, which would be handed h + 4 rather than h.
//
// A program cannot pass its memory on: a child's argv is the kernel's
// copy (ck_argv_copy), and pipes, files and the console copy what is
// written. The one thing that keeps a pointer is libjs's display, which
// writes events into a ring the task attached and should have detached
// on its way out -- task_ufree_all detaches it instead of letting the
// host write into freed memory.
//
// The lists have a lock of their own (docs/c4ix-smp.md, finer locks): a
// program's malloc and free come here from sched_trap's light path,
// without the kernel lock, on whichever CPU runs it. Everything that
// walks or changes a list holds umem_lock while it does.
enum { UBLOCK_WORDS = 4, UBLOCK_MAGIC = 0x55424c4b };
static int umem_lock[2];

// What a task holds in blocks, headers included (sched.c's task_mem)
int task_umem(struct task *t) {
    int b, *u;
    b = 0;
    klock_take(umem_lock);
    u = (int *)t->ublocks;
    while (u) { b = b + u[2] + UBLOCK_WORDS * sizeof(int); u = (int *)u[0]; }
    klock_drop(umem_lock);
    return b;
}

// A vfork child allocates for its parent: the heap is part of the memory
// it borrows, and libc's allocator, in the shared library data, carves
// up what it gets for both of them.
int task_ualloc(struct task *t, int bytes) {
    int *h;
    if (!t || t->privs != PRIV_USER) return (int)malloc(bytes);
    while (t->vfparent) t = t->vfparent;
    if (bytes < 0 || !(h = (int *)malloc(bytes + UBLOCK_WORDS * sizeof(int)))) return 0;
    sched_lock();
    klock_take(umem_lock);
    h[0] = t->ublocks;
    h[1] = (int)&t->ublocks;
    h[2] = bytes;
    h[3] = UBLOCK_MAGIC;
    if (h[0]) ((int *)h[0])[1] = (int)h;
    t->ublocks = (int)h;
    klock_drop(umem_lock);
    sched_unlock();
    return (int)(h + UBLOCK_WORDS);
}

void task_ufree(int p) {
    int *h;
    if (!p) return;
    h = (int *)p - UBLOCK_WORDS;
    if (h[3] != UBLOCK_MAGIC) { free((int *)p); return; }
    sched_lock();
    klock_take(umem_lock);
    // looked at again under the lock: another CPU may have freed it
    if (h[3] != UBLOCK_MAGIC) { klock_drop(umem_lock); sched_unlock(); return; }
    *(int *)h[1] = h[0];
    if (h[0]) ((int *)h[0])[1] = h[1];
    h[3] = 0;
    klock_drop(umem_lock);
    sched_unlock();
    free(h);
}

static void task_ufree_all(struct task *t) {
    int *h, *n;
    int ring;
    ring = host_has(C4IX_I_GUI) ? *(int *)C4IX_GUI_RING : 0;
    klock_take(umem_lock);
    h = (int *)t->ublocks;
    t->ublocks = 0;
    while (h) {
        n = (int *)h[0];
        if (ring && ring >= (int)(h + UBLOCK_WORDS) && ring < (int)(h + UBLOCK_WORDS) + h[2]) {
            *(int *)C4IX_GUI_RING = 0;
            ring = 0;
        }
        h[3] = 0;
        free(h);
        h = n;
    }
    klock_drop(umem_lock);
}

// Free what a task owns. Only ever called for a task nobody is
// standing on -- see task_release.
static void task_destroy(struct task *t) {
    ck_task_free(t);
    task_drop_image(t);
    if (t->stack) free((int *)t->stack);
    if (t->env_vec) free((int *)t->env_vec);
    if (t->env_data) free((char *)t->env_data);
    sl4b_free(task_cache, (char *)t);
}

// Its image, its libraries' code and data and its heap: what a task
// gives up to execve, and with everything else when it is reaped. A
// vfork child that has neither exec'd nor exited is borrowing all of it
// and owns none of it.
void task_drop_image(struct task *t) {
    int i;
    task_unborrow(t);
    task_ufree_all(t);
    if (t->img_code) free((int *)t->img_code);
    if (t->img_data) free((char *)t->img_data);
    if (t->img_cons) free((int *)t->img_cons);
    if (t->img_des) free((int *)t->img_des);
    if (t->img_libs) {
        i = 0;
        while (i < t->img_nlibs) {
            // code is 0 for a shared (-fpic) library: the loader's cache keeps it
            if (((int *)t->img_libs)[3 * i]) free((int *)((int *)t->img_libs)[3 * i]);
            free((char *)((int *)t->img_libs)[3 * i + 1]);
            ++i;
        }
        free((int *)t->img_libs);
    }
    t->img_code = 0; t->img_data = 0;
    t->img_cons = 0; t->img_ncons = 0;
    t->img_des = 0; t->img_ndes = 0;
    t->img_libs = 0; t->img_nlibs = 0;
    t->img_bytes = 0;
}

// Detach a task and free it -- unless it is the one currently
// running, which happens on the ordinary exit path: a task calls
// exit(), the trap handler services it, and the handler's own frame
// is ON THAT TASK'S STACK. Freeing it there means executing the rest
// of the handler, and the context switch at its end, on returned
// memory. So the corpse goes on a list and task_reap frees it once
// the kernel is standing somewhere else. (C4KE learned the same
// lesson: its idle task reaps zombies for exactly this reason.)
void task_release(struct task *t) {
    sched_lock();
    task_last_syscalls = t->nsyscalls;
    task_remember(t);
    fd_closeall(t);
    task_unlink(t);
    sched_retire(t);
    if (task_busy(t)) {
        t->next = task_reaplist;
        task_reaplist = t;
        sched_unlock();
        return;
    }
    task_destroy(t);
    sched_unlock();
}

// Called from safe points -- the top of a trap, a cooperative
// switch, the idle loop -- where the kernel is no longer running on
// a dead task's stack.
void task_reap() {
    struct task *t, *keep;
    sched_lock();
    keep = 0;
    while (task_reaplist) {
        t = task_reaplist;
        task_reaplist = t->next;
        if (task_busy(t)) { t->next = keep; keep = t; }
        else task_destroy(t);
    }
    task_reaplist = keep;
    sched_unlock();
}

// Release zombies nobody is waiting on. Called from the idle loop,
// where the kernel is not standing on any task's stack. No zombie has a
// waiter any more: task_zombify hands a dying task straight to the one
// waiting on it, and a wait that comes later reaps the zombie at once.
//
// Only children of USER tasks are swept, and that restriction is not
// caution -- it is the difference between working and a double free.
// Kernel code waits by POINTER (task_wait takes a struct task *), and
// holds those pointers across waits: init creates ping and pong, then
// waits on each in turn, so sweeping pong while it waits on ping
// hands the second task_wait a dangling pointer into freed slab
// memory. Userland only ever names a task by id, and an id that has
// been reaped is answered from the ghost table above. So: if the
// parent is userland, nobody is holding a pointer, and it is safe.
//
// A parent that is GONE holds nothing either -- and a zombie whose parent
// exited first (c4ix-tar, which vfsload starts and does not wait for) was
// otherwise never collected. Kernel code only holds its own children, and
// a kernel parent is still there while it holds them.
//
// A parent that waits the POSIX way (vfork, waitpid) is left its zombies:
// its waitpid(-1) has to find them, as a Unix parent's does, and one that
// never waits leaves them until it exits, as there too. A zombie swept
// before its parent first asked leaves a ghost with its parent's id.
static int task_parent_is_user(struct task *t) {
    struct task *p;
    if (!(p = task_get(t->parent))) return 1;
    return p->privs == PRIV_USER && !p->posix;
}

int task_reap_orphans() {
    struct task *t, *w;
    int freed, parent;

    freed = 0;
    sched_lock();
    t = task_head;
    while (t) {
        if (t->state == TS_ZOMBIE && !task_busy(t)
            && task_parent_is_user(t)) {
            w = t->next;
            parent = t->parent;
            task_release(t);
            ghost_parent[(ghost_next + TASK_GHOSTS - 1) % TASK_GHOSTS] = parent;
            ++freed;
            t = w;
            continue;
        }
        t = t->next;
    }
    sched_unlock();
    return freed;
}

struct task *task_get(int id) {
    struct task *t;
    t = task_head;
    while (t) {
        if (t->id == id) return t;
        t = t->next;
    }
    return 0;
}

struct task *task_first() {
    return task_head;
}

// Round-robin successor: after the tail comes the head again.
struct task *task_next(struct task *t) {
    if (t && t->next) return t->next;
    return task_head;
}

int task_count() {
    return ntasks;
}

// Free the whole list -- the tail end of a clean shutdown, after
// sched_run() has drained every other task.
void task_shutdown() {
    while (task_head) task_release(task_head);
}
src/c4ix/sched.c 65360
//
// C4IX scheduler.
//
// Every switch runs inside a trap handler -- the soft trap that
// sched_yield raises, or the cycle interrupt that gives preemption.
// c4m's trap() builds the handler an ordinary frame whose ARGUMENTS
// are the interrupted registers; assigning to those parameters and
// returning (through TLEV) IS the context switch.
//
// (There was a second backend, for plain c4, which has no traps: a
// cooperative switch through a trampoline LEV. No host ever reached it
// -- plain c4 runs C4IX only through c4m.c, so C4IX always sees c4m --
// and it went, with the systable it needed, in docs/c4ix-cpu.md step 10.
// src/tests/test_coop_switch.c still shows the trick.)
//
// Fresh tasks are forged SV_FRAME states: the fake pair sends control
// into task_shim, which calls the real entry and turns its return
// value into task_exit.
//

#include "c4ix.h"


// Idle backoff, in microseconds: how long the idle task sleeps when
// every other task is parked waiting on the outside world.
// With nobody reading the console, nothing can come from outside that a
// task is waiting for, and the idle task naps straight to the next
// deadline -- but no longer than IDLE_NAP_LONG, so a Ctrl-C, or a host
// whose sleep does not end early for one, is still seen promptly.
enum { IDLE_NAP_MIN = 100, IDLE_NAP_MAX = 20000, IDLE_NAP_LONG = 100000 };

// The context the machine booted in, which waits for the end once the
// scheduler runs (sched_run), and the task that runs when nothing else
// can (sched_idle). The idle task is never in the round-robin: sched_pick
// gives it the machine only when no other task can have it, so a busy
// task's syscalls do not each pass through it on the way back.
// (CPU 0's. Every other CPU has an idle task of its own: cpu_self->idle.)
static struct task *kernel_task;
static struct task *idle_task;
static int sched_idle(int argc, int argv);
static int sched_unblocked(struct task *n);
static void sched_banner();
static int sched_interval;   // preemption interval, 0 = none

// ---- processors (docs/c4ix-smp.md S3) ----
//
// What was the scheduler's own state -- the running task, the trap
// flag, the mask depth, the accounting stamps -- is each CPU's: struct
// cpu (c4ix.h), at cpu_self. On one CPU that is cpu_boot, and nothing
// else here changes: every test below of smp_ncpu fails, and the code
// is the code it was. Under SMP cpu_self is the CPU-local window, and:
//
// - The KERNEL LOCK (bkl_*) serializes the kernel. The trap handler
//   holds it from entry to exit; sched_lock takes it outside the
//   handler; a kernel task holds it the whole time it runs, since
//   kernel tasks call the kernel directly. User tasks run without it,
//   at once, one per CPU. Idle tasks run without it too, and take
//   sched_lock where they look at the kernel.
// - Kernel tasks run on CPU 0 only; each idle task on its own CPU.
// - A task that some CPU may still be standing on (oncpu) is neither
//   resumed elsewhere nor freed. A CPU is on the stack of the task it
//   switches out until its trap returns, so the mark is cleared at that
//   CPU's next trap, or when its idle loop next looks (smp_settle).
// - A CPU with nothing to run parks, CPU 0 in its idle task's nap and
//   the others in CWAI; a trap that leaves work some idle CPU could do
//   sends it an IPI (smp_kick), which arrives as a cycle interrupt.
#define sched_lockdepth (cpu_self->lockdepth)
#define acct_in (cpu_self->acct_in)
#define acct_out (cpu_self->acct_out)
#define sched_slice0 (cpu_self->slice0)
#define sched_resched (cpu_self->resched)
#define sched_dying (cpu_self->dying)
#define sched_dying_code (cpu_self->dying_code)

struct cpu *cpu_self;
static struct cpu cpu_boot;
int smp_ncpu;
static int smp_idle[CPU_MAX];        // 1: that CPU runs its idle task
static int smp_park[CPU_MAX];        // what an idle CPU parks on: only an IPI wakes it
static int smp_stack[CPU_MAX];       // each other CPU's boot stack, its idle task's
static struct task *smp_idle_t[CPU_MAX];   // ... and that idle task
static int smp_stopping;             // shutdown: the other CPUs halt
static int smp_halted;               // ... and count themselves out
static int smp_slots;                // library slots given out (loader.c)
// Spins before a CPU parks on a lock: a hold is usually a syscall's
// worth, much less than a park and a wake.
enum { BKL_SPIN = 64, SMP_STACK_BYTES = 65536 };

void sched_early() {
    cpu_self = &cpu_boot;
}

// ---- locks ----
//
// A kernel lock is two words: 1 + the CPU holding it (0 if none), and
// its holds, nested, so a CPU can take one it has. A CPU spins a little
// on one held elsewhere, then parks in CWAI until the holder lets go.
// On one CPU there is nothing to lock against, and these do nothing.
void klock_take(int *lk) {
    int me, o, spin;
    if (smp_ncpu < 2) return;
    me = cpu_self->id + 1;
    if (lk[0] == me) { ++lk[1]; return; }
    spin = 0;
    while ((o = __c4_cas((int)lk, 0, me))) {
        if (++spin > BKL_SPIN) { __c4_wait((int)lk, o); spin = 0; }
    }
    lk[1] = 1;
}

void klock_drop(int *lk) {
    if (smp_ncpu < 2) return;
    if (--lk[1]) return;
    __c4_xchg((int)lk, 0);
    __c4_wake((int)lk, 1);
}

// The big one, the KERNEL LOCK: everything in the kernel but what has a
// lock of its own -- so far, the tasks' memory (task.c, umem_lock), which
// a program's malloc and free reach without it (sched_trap's light path).
static int bkl[2];
static void bkl_take() { klock_take(bkl); }
static void bkl_drop() { klock_drop(bkl); }

// Whether N may run on CPU K by its mask (pin, SYS_AFFINITY). A mask
// naming no CPU this machine has is no mask at all.
static int sched_allows(struct task *n, int k) {
    int m;
    if (!n->cpumask) return 1;
    m = n->cpumask & ((1 << smp_ncpu) - 1);
    return !m || (m & (1 << k)) != 0;
}

// Whether this CPU may run N: not while another CPU is on its stack,
// an idle task only on its own CPU, a kernel task only on CPU 0, and a
// pinned task only on its CPUs.
static int sched_mine(struct task *n) {
    int me;
    if (smp_ncpu < 2) return 1;
    me = cpu_self->id + 1;
    if (n->oncpu && n->oncpu != me) return 0;
    if (n->cpuidle) return n->cpuidle == me;
    if (n->privs == PRIV_KERNEL) return me == 1;
    return sched_allows(n, me - 1);
}

// This CPU is off the stack of the task it last switched out. Under the
// lock: at a trap's start, or in an idle loop.
static void smp_settle() {
    struct task *p;
    if (!(p = cpu_self->prev)) return;
    if (p != sched_cur && p->oncpu == cpu_self->id + 1) p->oncpu = 0;
    cpu_self->prev = 0;
}

int task_busy(struct task *t) {
    if (smp_ncpu < 2) return t == sched_cur;
    return t->oncpu != 0;
}

// what ps and top say a task runs on
int task_cpu(struct task *t) {
    if (t->state != TS_RUNNING) return 0 - 1;
    if (smp_ncpu < 2) return 0;
    return t->oncpu - 1;
}

// A shared library's __c4_dbase slot, one word of the window: every CPU
// points it at the data of the task it runs (loader_switch)
int smp_slot_alloc() {
    if (smp_slots >= CPU_SLOTS) return 0;
    ++smp_slots;
    return CPU_WINDOW + (CPU_SLOT0 + smp_slots - 1) * sizeof(int);
}

// An idle CPU other than this one that N may run on, the highest, or -1
static int smp_idlefor(struct task *n) {
    int k;
    k = smp_ncpu - 1;
    while (k >= 0) {
        if (k != cpu_self->id && smp_idle[k] && sched_allows(n, k)) return k;
        --k;
    }
    return 0 - 1;
}

// Work some idle CPU could do: an IPI to one for each task ready, among
// the CPUs it may run on. Kernel tasks are CPU 0's. Under the lock, at
// the end of every trap; only when some CPU is idle does it look.
static void smp_kick() {
    struct task *n;
    int k, me, kern, idle;
    me = cpu_self->id;
    idle = 0;
    k = 0;
    while (k < smp_ncpu) { if (k != me && smp_idle[k]) ++idle; ++k; }
    if (!idle) return;
    kern = 0;
    n = task_head;
    while (n && !kern) {
        if (n->privs == PRIV_KERNEL && !n->cpuidle && !n->oncpu &&
            (n->state == TS_READY || sched_unblocked(n))) kern = 1;
        n = n->next;
    }
    if (kern && me != 0 && smp_idle[0]) { __c4_ipi(0); smp_idle[0] = 0; --idle; }
    n = task_head;
    while (n && idle > 0) {
        if (n->privs != PRIV_KERNEL && !n->cpuidle && !n->oncpu &&
            (n->state == TS_READY || sched_unblocked(n)) && (k = smp_idlefor(n)) >= 0) {
            __c4_ipi(k); smp_idle[k] = 0; --idle;
        }
        n = n->next;
    }
}

// Something this CPU could run now: an idle loop asks, under the lock,
// before it parks
static int sched_ready_here() {
    struct task *n;
    n = task_head;
    while (n) {
        if (!n->cpuidle && sched_mine(n) && (n->state == TS_READY || sched_unblocked(n))) return 1;
        n = n->next;
    }
    return 0;
}

// ---- accounting ----
//
// Every cycle belongs to someone (docs/c4ix-cpu.md). From the end of one
// trap to the start of the next, the running task ran its own code; from
// the start of a trap to its end the kernel ran on behalf of the task that
// trapped. So the handler reads the counter twice, and the two differences
// are the whole of it: no per-switch stamps, and nothing the kernel does
// goes to whichever task happened to be switched in afterwards.
//
// The idle loop's cycles are idle time, and so is the time it naps, during
// which the counter stands still: that is counted in machine milliseconds,
// so System Monitor can weigh the two together.
//
// The differences are words, and the VM's counter wraps -- a difference
// is right modulo the word as long as it is less than half of it, and a
// trap at least every preemption slice sees to that.
// (acct_in and acct_out, the two readings, are each CPU's: struct cpu)
static int acct_napms;
// And by CPU (docs/c4ix-smp.md S4): the cycles each ran, busy (every
// task but its idle task) or idle, and the machine ms it parked, which
// for CPU 0 are acct_napms. Added to with the tasks' own, under the
// kernel lock; a parked CPU adds its own ms.
static long long acct_cbusy[CPU_MAX];
static long long acct_cidle[CPU_MAX];
static int acct_cnap[CPU_MAX];

static void acct_cpu(struct task *t, int d) {
    if (t->cpuidle) acct_cidle[cpu_self->id] = acct_cidle[cpu_self->id] + d;
    else acct_cbusy[cpu_self->id] = acct_cbusy[cpu_self->id] + d;
}

// Under SMP an idle CPU's park or nap ends when it is woken, which is an
// IPI: its trap switches to the work at once, before the idle loop's next
// line, so the park is closed in the trap, or by that line if it comes
// first. (Closed by the loop alone, it was charged the time the CPU then
// spent running tasks too.) A park still going is the snapshot's to count
// as far as it has got -- a CPU can park for many seconds -- so where each
// stands is here, where every CPU can read it, not in the CPU's window.
static int acct_parked[CPU_MAX];
static int acct_parked_at[CPU_MAX];

static void acct_park() {
    acct_parked_at[cpu_self->id] = __time();
    acct_parked[cpu_self->id] = 1;
}
static void acct_unpark() {
    int d, k;
    k = cpu_self->id;
    if (!acct_parked[k]) return;
    acct_parked[k] = 0;
    d = __time() - acct_parked_at[k];
    if (k) acct_cnap[k] = acct_cnap[k] + d;
    else acct_napms = acct_napms + d;
}

// CPU k's parked ms since boot, the park it is in included
static int acct_napped(int k) {
    int n;
    n = k ? acct_cnap[k] : acct_napms;
    if (smp_ncpu > 1 && acct_parked[k]) n = n + (__time() - acct_parked_at[k]);
    return n;
}
static long long acct_gone_user, acct_gone_kernel;

// An accumulator past 2^30 (or, impossibly, negative) folds now, long
// before it could overflow; -2^30 is that mask at either word size.
enum { ACCT_FOLD_AT = -1073741824 };

static void acct_fold(struct task *t) {
    t->ucycles = t->ucycles + t->uacc;
    t->kcycles = t->kcycles + t->kacc;
    t->uacc = 0;
    t->kacc = 0;
}

// Read, not folded: under SMP the CPU running a task adds to its
// accumulators without the kernel lock (sched_trap's light path), so only
// that CPU folds them, and a task that has stopped.
long long task_cycles(struct task *t) {
    return t->ucycles + t->uacc + t->kcycles + t->kacc;
}

// A task leaving the table takes its cycles to the reaped totals, so the
// sum of everything ever run never goes backwards.
void sched_retire(struct task *t) {
    if (t->state == TS_ZOMBIE) --sched_nzombies;
    else if (t != kernel_task && !t->cpuidle) --sched_nlive;
    if (t == idle_task) idle_task = 0;   // shutdown: sched_pick must not fall back on it
    acct_fold(t);
    acct_gone_user = acct_gone_user + t->ucycles;
    acct_gone_kernel = acct_gone_kernel + t->kcycles;
}

// The snapshot behind System Monitor and top: one trap, so nothing runs
// between the first record and the last.
// The bytes a task holds: its image, its stack, and what it allocated
// (its ublocks, each with its header, task.c)
static int task_mem(struct task *t) {
    int b;
    b = t->img_bytes;
    if (t->stack) b = b + t->stack_words * sizeof(int);
    return b + task_umem(t);
}

int sched_cpustat(struct cpustat *h, struct cpustat_task *r, int max) {
    struct task *t;
    struct cpustat_task *p;
    int n, i;

    n = 0;
    t = task_head;
    while (t && n < max) {
        p = &r[n];
        p->id = t->id;
        p->parent = t->parent;
        p->state = t->state;
        p->privs = t->privs;
        p->nsyscalls = t->nsyscalls;
        p->user = t->ucycles + t->uacc;       // read, not folded (task_cycles)
        p->kernel = t->kcycles + t->kacc;
        p->mem = task_mem(t);
        p->cpu = task_cpu(t);
        i = 0;
        while (i < TASK_NAME_MAX) { p->name[i] = t->name[i]; ++i; }
        ++n;
        t = t->next;
    }
    h->ntasks = n;
    h->ms = __time();
    h->napms = acct_napms;
    h->idle = idle_task ? idle_task->id : -1;
    h->gone_user = acct_gone_user;
    h->gone_kernel = acct_gone_kernel;
    // the heap, where the host says (libjs: ANNOUNCED, so never probed)
    h->heap = 0;
    h->heapused = 0;
    if (host_has(C4IX_I_C4MJS)) {
        h->heap = *(int *)C4IX_HEAP_END - *(int *)C4IX_HEAP_BASE;
        h->heapused = *(int *)C4IX_HEAP_USED;
    }
    // the processors, CPU 0's naps as its parking
    h->ncpu = smp_ncpu > 1 ? smp_ncpu : 1;
    i = 0;
    while (i < CPU_MAX) {
        h->idles[i] = 0 - 1;
        h->cnap[i] = acct_napped(i);
        h->cbusy[i] = acct_cbusy[i];
        h->cidle[i] = acct_cidle[i];
        ++i;
    }
    h->idles[0] = h->idle;
    i = 1;
    while (i < h->ncpu) { if (smp_idle_t[i]) h->idles[i] = smp_idle_t[i]->id; ++i; }
    return n;
}

int sched_switches;          // context switches since boot
// (sched_reload, sched_stale_stack, sched_slice0, sched_resched and
// sched_dying are each CPU's: struct cpu)

// ---- preemption masking (nestable) ----
//
// The depth belongs to the TASK, not to the machine. It has to: the
// mask says "do not preempt me", and if it were global then a task
// that held it across a context switch would hand the next task an
// interrupt-masked machine. A compute-bound task landing in that
// state never traps again -- it just runs, burning cycles, while
// nothing else is scheduled and nothing can stop it. (C4KE shows the
// same failure: a rogue benchmark with a cycle count thousands of
// times everyone else's, issuing no traps.) So the switch saves the
// outgoing depth and restores the incoming one, and the re-arm at
// the end of the handler reflects whoever is about to run.

// Inside the trap handler the interrupt is already off and the
// handler re-arms it on the way out, so the hardware half is skipped
// there -- re-arming mid-handler would invite a nested interrupt.
//
// Under SMP the mask is also the kernel lock, outside the handler: the
// handler holds that already. Masked first, so that nothing preempts a
// CPU holding it.
void sched_lock() {
    if (!sched_intrap) {
        if (sched_lockdepth == 0 && sched_interval) __c4_configure(C4IX_CONF_INTERVAL, 0);
        bkl_take();
    }
    ++sched_lockdepth;
}

void sched_unlock() {
    --sched_lockdepth;
    if (!sched_intrap) {
        bkl_drop();
        if (sched_lockdepth == 0 && sched_interval) __c4_configure(C4IX_CONF_INTERVAL, sched_interval);
    }
}

// The running task's slice starts again now: after a service that
// spent its slice in the kernel on the task's behalf (SYS_SPAWN).
void sched_new_slice() {
    sched_slice0 = __c4_cycles();
}

// ---- picking the next task ----

// What a parked task is waiting for, asked as sched_pick passes it. (A
// TS_WAITING task is not asked: task_zombify wakes it when its target
// dies, below.)
// A TS_BLOCKED task is parked on a vnode -- an empty pipe. It wakes
// when the data it wanted arrives, or when the last writer closes
// and the emptiness becomes end-of-file instead.
// A TS_SLEEPING task is parked on the clock. Subtract rather than
// compare the raw values -- the habit that survives a wrap.
static int sched_unblocked(struct task *n) {
    if (n->state == TS_SLEEPING) {
        if (__time() - n->ck_wake < 0 && !(n->ev_wait && sched_events(n))) return 0;
        n->ev_wait = 0;
        n->state = TS_READY;
        n->woke = 1;
        return 1;
    }
    if (n->state != TS_BLOCKED) return 0;
    if (!vfs_readable(n->block_vn, n->block_pos)) return 0;
    n->state = TS_READY;
    n->woke = 1;
    return 1;
}

// What SYS_EVWAIT waits for besides the clock: an event in the task's GUI
// ring, whose header is [capacity, head, tail] -- the host moves the head,
// the task the tail -- or data, or end of file, on a pipe it reads.
int sched_events(struct task *t) {
    struct file *f;
    int fd, *ring;
    if (t->ev_wait & 1) {
        ring = (int *)t->ev_ring;
        if (ring && ring[1] != ring[2]) return 1;
    }
    if (t->ev_wait & 2) {
        fd = 0;
        while (fd < FD_MAX) {
            f = (struct file *)t->fds[fd];
            if (f && f->vn->type == VN_PIPE && (f->flags & 3) == C4IX_O_RDONLY
                && (f->vn->size > f->vn->rpos || !f->vn->writers)) return 1;
            ++fd;
        }
    }
    return 0;
}

// The earliest deadline among sleeping tasks, or 0 if none. The idle
// loop uses it to cap its nap so a short sleep is not served late.
int sched_sleep_due(int *pms) {
    struct task *t;
    int found;

    found = 0;
    t = task_head;
    while (t) {
        if (t->state == TS_SLEEPING) {
            if (!found || t->ck_wake - *pms < 0) { *pms = t->ck_wake; found = 1; }
        }
        t = t->next;
    }
    return found;
}

// ---- the living and the dead ----
//
// Both counted as they change, so that nothing scans the table to find
// out. sched_nlive is the tasks still to finish: all but the kernel and
// idle tasks and the zombies (background jobs too), and shutdown is when
// it reaches 0. sched_nzombies says whether the orphan reaper has
// anything to look for. task.c counts a task in as it joins the table;
// task_zombify and sched_retire count them out.
int sched_nlive;
int sched_nzombies;

// Every death comes through here: a task's exit, a Ctrl-C, a signal's
// default action. Whoever waits on the task is woken now, with its code,
// and reaps it -- the event sched_pick used to look for, on every pick,
// by asking each waiting task whether its target had died yet. A task
// that starts waiting later finds the zombie and reaps it itself.
//
// A waitpid waiter (wait_posix) is only woken: its syscall runs again and
// reaps whichever child it finds, so waiting for any child (-1) works too.
//
// A vfork child's death gives its parent its memory back; a vfork
// parent's takes the child with it, since what it was running in goes.
void task_zombify(struct task *t, int code) {
    struct task *w;
    int was;
    if (t->state == TS_ZOMBIE) return;
    was = t->state;
    t->exitcode = code;
    t->state = TS_ZOMBIE;
    ++sched_nzombies;
    if (t != kernel_task && !t->cpuidle) --sched_nlive;
    task_unborrow(t);
    sys_display_drop(t->id);      // the desktop has the display back
    if (was == TS_VFORK && (w = task_get(t->wait_for)) && w->vfparent == t) task_zombify(w, code);
    w = task_head;
    while (w) {
        if (w->state == TS_WAITING && w->wait_posix &&
            (w->wait_for == t->id || (w->wait_for == -1 && t->parent == w->id))) {
            w->wait_posix = 0;
            w->state = TS_READY;
            w->woke = 1;
            return;
        }
        if (w->state == TS_WAITING && w->wait_for == t->id && !w->wait_posix) {
            // into wait_result for a kernel caller in task_wait, and into
            // sv_a for a user task parked mid-syscall: the switch restores
            // sv_a into the accumulator, where SYS_WAIT's result belongs
            w->wait_result = code;
            w->sv_a = code;
            w->state = TS_READY;
            w->woke = 1;
            task_release(t);
            return;
        }
        w = w->next;
    }
}

// Round-robin after t: the next runnable task; else t itself, if it can
// still run; else the idle task, which never takes a turn of its own.
// A task that has just died may be off the list already -- its waiter
// reaped it -- so the walk starts from the head for a zombie, and stops
// when it comes back round to where it started.
// Under SMP, only what this CPU may run (sched_mine), and the idle task
// is this CPU's.
static struct task *sched_pick(struct task *t) {
    struct task *n, *start, *idle;
    idle = cpu_self->idle;
    start = (t->state == TS_ZOMBIE) ? task_head : task_next(t);
    n = start;
    while (n) {
        if (n != t && n != idle && !n->cpuidle && sched_mine(n)) {
            if (n->state == TS_READY) return n;
            if (sched_unblocked(n)) return n;
        }
        n = task_next(n);
        if (n == start) n = 0;
    }
    if ((t->state == TS_RUNNING || t->state == TS_READY || sched_unblocked(t)) &&
        (t == idle || t->cpuidle || sched_mine(t))) return t;
    return idle ? idle : t;
}

// ---- the c4m backend: switching inside a trap handler ----

// The kernel's single trap entry: yields, preemption, syscalls and
// protected-mode violations all arrive here. Assigning to the
// a/bp/sp/returnpc/mode parameters changes what TLEV resumes with --
// that is both the context switch and the syscall return path.
//
// c4m enters a handler unprotected with the cycle interrupt off, so
// the kernel always runs privileged; the mode assignment on the way
// out is what puts a user task back behind the boundary.
//
// The leading `interval` parameter is the frame slot c4m saves the
// cycle interrupt interval into, and it is a register like the rest:
// assigning to it says what the interrupt state should be for the
// context this trap returns to. That is the only safe way to re-arm
// preemption. Doing it with __c4_configure before returning arms the
// machine while the switch is still only half done -- sched_cur has
// moved but the registers have not, because they do not change until
// TLEV runs -- and an interrupt in that window saves the outgoing
// task's registers into the incoming task and restores the incoming
// task's stale ones. The two contexts trade places, one then rebuilds
// a trap frame over the frame the other is parked on, and the machine
// ends up spinning on a TLEV that returns to itself forever.
// ---- priority: nice ----
//
// A task's nice is -10, the most favoured, to 10; 0 for most, and when
// every task has 0 -- until something sets one -- scheduling is the round
// robin it always was. A favoured task is served sooner and longer, but
// never to the exclusion of the rest, which a game drawing in a window
// needs as much as anyone, since the desktop draws it:
// - sooner: when it wakes, from a sleep or a wait, it preempts a less
//   favoured task at once, instead of waiting out that task's slice;
// - longer: a turn of 1 - nice slices in a row, where the others' is one.
// The turns still go round, so a favoured task that never sleeps cannot
// starve the others; a task with a positive nice is only ever preempted
// by a woken task with a lower one. A child starts with its parent's.
static int sched_niced;          // some task has had a nice set

// the cycles a task runs before its turn passes
static int sched_turn(struct task *t) {
    return t->nice < 0 ? sched_interval * (1 - t->nice) : sched_interval;
}

// A task that has woken and is more favoured than T, this CPU's to run:
// the most favoured, or 0
static struct task *sched_waker(struct task *t) {
    struct task *n, *best;
    best = 0;
    n = task_head;
    while (n) {
        if (n != t && !n->cpuidle && n->nice < t->nice && (!best || n->nice < best->nice) &&
            sched_mine(n) && (n->state == TS_READY || sched_unblocked(n)) && n->woke) best = n;
        n = n->next;
    }
    return best;
}

// SYS_NICE: task ID's nice; one outside -10..10 only asks. The one it had,
// or -100: no such task, or one that is not a program's.
int sched_nice(int id, int nice) {
    struct task *t;
    int old;
    sched_lock();
    t = task_get(id);
    if (!t || t->cpuidle || t->privs == PRIV_KERNEL) { sched_unlock(); return 0 - 100; }
    old = t->nice;
    if (nice >= 0 - 10 && nice <= 10) {
        t->nice = nice;
        if (nice) sched_niced = 1;
    }
    sched_unlock();
    return old;
}

// Under SMP, may this trap be served without the kernel lock? A protected
// program's malloc or free -- a compile makes thousands -- touches only
// the heap, whose books are the host's and every thread's (libjs sheap.js),
// and the program's own list of blocks, under its own lock (task.c,
// umem_lock). So it may, as long as nothing else is to be done in this
// trap: the task runs on with its slice left, nothing is pending for it,
// and this CPU has nothing to settle. Everything else takes the lock, and
// does what the light path leaves for later -- the reaping, the stack
// guard -- at the next trap.
static int sched_light(int trap, int param) {
    struct task *t;
    t = sched_cur;
    return trap == C4IX_TRAP_PM && (param == C4IX_OP_MALC || param == C4IX_OP_FREE) &&
        t && t->state == TS_RUNNING && t->privs == PRIV_USER && !t->ck_sigpend &&
        !sched_dying && !sched_resched && !sched_reload && !cpu_self->prev &&
        (!sched_interval || acct_in - sched_slice0 < sched_turn(t));
}

static void sched_trap(int interval, int trap, int param, int mode, int a, int bp, int sp, int returnpc) {
    struct task *t, *n, *me, *fv;
    int reload, hold;

    // Re-entry guard. c4m disables the cycle interrupt when IT takes
    // a trap, but not when user code raises one (the syscall gateway
    // and __c4_trap), so an interrupt can still land in the window
    // between entering this handler and the line below. The handler
    // keeps its state in globals and is not re-entrant, so a nested
    // invocation returns immediately: TLEV then resumes the outer
    // handler exactly where it was, and the interrupt stays disabled
    // (c4m's own cycle path clears the interval) until the outer
    // handler re-arms it on the way out.
    if (sched_intrap) return;
    // Claim the handler BEFORE anything else, including the mask
    // below. Neither the syscall gateway nor __c4_trap disables the
    // cycle interrupt on the way in, so an interrupt can land in the
    // few instructions between entry and that __c4_configure -- and
    // if the flag were still clear it would run this whole handler
    // recursively, on top of the switch already in progress. Setting
    // it first makes that window a no-op instead of corruption.
    //
    // In-trap services also read this flag: yield and exit become
    // state changes the switch below acts on, rather than re-entering
    // the trap machinery.
    sched_intrap = 1;
    // Until now the task's own code ran; from here, the kernel on its
    // behalf (accounting, above). It is the one charged on the way out
    // too, whoever that switches to.
    acct_in = __c4_cycles();
    if (smp_ncpu > 1) {
        // The kernel is one CPU's at a time; then this CPU is off the
        // stack of the task it last switched out. (A task's accumulators
        // are its CPU's alone: a snapshot reads them, folds nothing.)
        __c4_configure(C4IX_CONF_INTERVAL, 0);
        // The light path: a program's malloc or free that leaves it
        // running is served without the kernel lock (sched_light)
        if (sched_light(trap, param)) {
            me = sched_cur;
            ++me->ntraps;
            me->uacc = me->uacc + (acct_in - acct_out);
            acct_cpu(me, acct_in - acct_out);
            sys_pmviolation(param, (int *)sp, (int *)returnpc, &a);
            acct_out = __c4_cycles();
            me->kacc = me->kacc + (acct_out - acct_in);
            acct_cpu(me, acct_out - acct_in);
            if ((me->uacc | me->kacc) & ACCT_FOLD_AT) acct_fold(me);
            mode = C4IX_MODE_PROTECTED;
            interval = (sched_interval && sched_lockdepth == 0) ? sched_interval : 0;
            sched_intrap = 0;
            return;
        }
        bkl_take();
        smp_settle();
        acct_unpark();
        // Killed by another CPU while it ran here: nothing of it is to be
        // served, only switched away from
        if (sched_cur && sched_cur->state == TS_ZOMBIE) trap = C4IX_TRAP_SOFT_IRQ;
    }
    if ((me = sched_cur)) {
        ++me->ntraps;
        me->uacc = me->uacc + (acct_in - acct_out);
        acct_cpu(me, acct_in - acct_out);
    }

    // no nested switches while kernel structures move
    __c4_configure(C4IX_CONF_INTERVAL, 0);

    // Safe point: we are on the trapped task's stack, so any corpse
    // left over from an earlier exit can finally be freed. Usually
    // there is none, and then not even the call.
    if (task_reaplist) task_reap();
    // the stack an execve left, which its handler was standing on
    if (sched_stale_stack) { free((int *)sched_stale_stack); sched_stale_stack = 0; }
    // The stack guard. A task whose stack pointer is inside the guard,
    // or whose top guard word has been written, ran off the end of its
    // stack: kill it here, before what it wrote under the stack -- some
    // other allocation -- takes the machine down in some other task.
    if (sched_cur && sched_cur->stack && sched_cur->privs == PRIV_USER && sched_cur->state != TS_ZOMBIE &&
        (sp < sched_cur->stack + C4IX_STACK_GUARD * sizeof(int) ||
         ((int *)sched_cur->stack)[C4IX_STACK_GUARD - 1] != C4IX_STACK_POISON)) {
        kprintf("c4ix: task %d (%s) overran its %d-byte stack; killing it\n",
            sched_cur->id, sched_cur->name, sched_cur->stack_words * sizeof(int));
        task_exit(-1);
        trap = C4IX_TRAP_SOFT_IRQ;   // nothing left to service: just switch
    }
    // a task_exit from outside the handler (above) takes effect here
    if (sched_dying && me) {
        sched_dying = 0;
        task_zombify(me, sched_dying_code);
        trap = C4IX_TRAP_SOFT_IRQ;
    }
    if (trap == C4IX_TRAP_ILLOP) {
        if (param >= SYS_BASE && param < SYS_TOP) {
            // OPCD leaves the syscall number at *sp with the
            // arguments above it. Cast BEFORE the offset: sp is an
            // int parameter, so "sp + 1" would step one byte.
            // vfork needs the trap's frame pointer, so it is served here
            if (param == SYS_VFORK) a = sched_vfork(bp);
            else a = sys_dispatch(param, (int *)sp + 1);
        } else if (param >= CK_BASE && param < CK_TOP) {
            // A C4KE program. Same door, same argument shape --
            // C4KE's ABI puts the opcode at sp[0] too.
            a = ck_dispatch(param, (int *)sp + 1);
        } else {
            kprintf("c4ix: task %d hit illegal opcode %d\n",
                sched_cur ? sched_cur->id : -1, param);
            task_exit(-1);
        }
    } else if (trap == C4IX_TRAP_OPV) {
        // c4m raises this when OPCD is handed a number below ADJ --
        // in practice, opcode 0, which is what a C4KE program ends up
        // executing when a symbol lookup failed and it stored the 0.
        // Without this branch the task would sail on with a wrong
        // result and the real fault would surface somewhere useless.
        kprintf("c4ix: task %d executed opcode %d via OPCD "
                "(an unresolved C4KE symbol?); killing it\n",
            sched_cur ? sched_cur->id : -1, param);
        task_exit(-1);
    } else if (trap == C4IX_TRAP_PM) {
        sys_pmviolation(param, (int *)sp, (int *)returnpc, &a);
    } else if (trap == C4IX_TRAP_SIGNAL) {
        sched_interrupt();
    }

    // The syscall could not finish because the task had to block.
    // Rewind one word so it re-executes the syscall opcode when it
    // wakes: the arguments are still on its own stack, untouched, so
    // the call simply happens again. (Both doors trap one word past
    // a single-word opcode, so the arithmetic is the same for the
    // gateway and for an emulated host opcode.)
    if (sys_restart) {
        returnpc = returnpc - sizeof(int);
        sys_restart = 0;
    }

    // The fast path. A syscall, or an opcode emulated for a protected
    // task, that left the task able to run and asked for no switch goes
    // straight back to it while its slice lasts. Picking costs the same
    // whether anything changed or not, and most syscalls change nothing:
    // a task they wake waits at most the rest of a slice. The slice is
    // kept here, in software, because c4m's cycle interrupt fires only
    // when the counter is a multiple of the interval, and every multiple
    // that falls inside the kernel is lost -- without this a task making
    // a syscall at the wrong moments would never be preempted.
    t = sched_cur;
    // a favoured task that has woken goes first (nice, above)
    fv = (sched_niced && sched_lockdepth == 0 && t->state == TS_RUNNING && !t->cpuidle)
        ? sched_waker(t) : 0;
    if (fv) {
        n = fv;
        sched_slice0 = acct_in;
    }
    else if ((trap == C4IX_TRAP_ILLOP || trap == C4IX_TRAP_PM) && !sched_resched
        && t->state == TS_RUNNING && (t->cpuidle || sched_mine(t))
        && (!sched_interval || acct_in - sched_slice0 < sched_turn(t)))
        n = t;
    // An IPI arrives whatever the mask: a task that masked preemption (an
    // idle loop under sched_lock, a C4KE program's exclusive section)
    // keeps the CPU. What it was sent for is found when the mask lifts.
    else if (trap == C4IX_TRAP_HARD_IRQ && sched_lockdepth > 0 && t->state == TS_RUNNING)
        n = t;
    // a favoured task's turn is several slices
    else if (trap == C4IX_TRAP_HARD_IRQ && t->nice < 0 && t->state == TS_RUNNING && !sched_resched &&
             sched_mine(t) && acct_in - sched_slice0 < sched_turn(t))
        n = t;
    else {
        n = sched_pick(t);
        // Several CPUs: a task preempted while another CPU idles keeps
        // this one, and what is ready goes to the idle one (smp_kick).
        // Switched out here, it could not: it would be this CPU's until its
        // next trap, which would switch the two back, and so on, one CPU
        // taking turns between them while the other parked. (Preempted: its
        // slice ran out, at the cycle interrupt or in a syscall; not a yield.)
        if (smp_ncpu > 1 && n != t && t->state == TS_RUNNING && !t->cpuidle && n->privs == PRIV_USER &&
            sched_mine(t) &&
            (trap == C4IX_TRAP_HARD_IRQ || ((trap == C4IX_TRAP_ILLOP || trap == C4IX_TRAP_PM) && !sched_resched)) &&
            smp_idlefor(n) >= 0) n = t;
        sched_slice0 = acct_in;
    }
    sched_resched = 0;
    // An execve forged the running task a new context: it is resumed
    // from that even if it is picked again, and the trap's registers,
    // the old image's, are not saved over it.
    reload = sched_reload;
    sched_reload = 0;
    if (n != t || reload) {
        if (!reload) {
            t->sv = SV_REGS;
            t->sv_a = a; t->sv_bp = bp; t->sv_sp = sp; t->sv_pc = returnpc;
        }
        if (t->state == TS_RUNNING) t->state = TS_READY;
        if (n->sv == SV_REGS) {
            a = n->sv_a; bp = n->sv_bp; sp = n->sv_sp; returnpc = n->sv_pc;
        } else {
            // SV_FRAME: registers derive from the pair. sp lands just
            // past it, exactly where the frame's LEV would have left it.
            a = 0;
            bp = n->sv_bp;
            sp = n->sv_sp + 2 * sizeof(int);
            returnpc = n->sv_pc;
        }
        // the mask travels with the task, not with the machine
        t->lockdepth = sched_lockdepth;
        sched_lockdepth = n->lockdepth;
        n->state = TS_RUNNING;
        n->woke = 0;
        sched_cur = n;
        if (smp_ncpu > 1) {
            // this CPU stays on t's stack until the trap returns
            if (n != t) cpu_self->prev = t;
            n->oncpu = cpu_self->id + 1;
            smp_idle[cpu_self->id] = (n == cpu_self->idle);
        }
        loader_switch(n);
        ++sched_switches;
    } else if (t->state == TS_ZOMBIE) {
        // The task died and nothing else is runnable: with no context
        // to resume, the kernel cannot return from this trap.
        kputs("c4ix: panic: last task exited with nothing to switch to\n");
        exit(-1);
    }

    // A user task resumes behind the boundary; the kernel does not.
    mode = (sched_cur->privs == PRIV_USER)
        ? C4IX_MODE_PROTECTED : C4IX_MODE_UNPROTECTED;

    // Preemption for whoever is about to run. sched_lockdepth was
    // swapped above, so it already belongs to the incoming task: a
    // task that trapped while holding the mask gets it back, and one
    // that did not gets a running clock. Writing the frame slot rather
    // than the machine leaves the interrupt off until TLEV has finished
    // installing the context -- there is no half-switched window for it
    // to land in.
    interval = (sched_interval && sched_lockdepth == 0) ? sched_interval : 0;

    // If the task about to run has a signal waiting, enter its handler
    // instead -- by rewriting the very registers just settled on.
    //
    // This is the ONLY delivery point, and it is here for a reason.
    // Above, a SV_FRAME task has already been turned into real
    // registers, so this never sees a forged frame; and whether or not
    // a switch happened, a/bp/sp/returnpc now describe the incoming
    // context, so the same code serves both. The mode and interval
    // just computed are handed over to be stored in the frame the
    // handler returns through, while this frame keeps them -- which is
    // what runs the handler itself in the task's own mode. Almost no
    // task has a signal waiting, and the count says so without a call.
    if (sched_cur->ck_sigpend)
        ck_signal_deliver(sched_cur, &a, &bp, &sp, &returnpc, mode, interval);

    acct_out = __c4_cycles();
    if (me) {
        me->kacc = me->kacc + (acct_out - acct_in);
        acct_cpu(me, acct_out - acct_in);
        if ((me->uacc | me->kacc) & ACCT_FOLD_AT) acct_fold(me);
    }

    // The lock: work for an idle CPU first, while it is still held; then
    // a kernel task keeps a hold of its own while it runs, and the
    // handler lets go of its.
    if (smp_ncpu > 1) {
        smp_kick();
        hold = sched_cur->privs == PRIV_KERNEL && !sched_cur->cpuidle;
        if (cpu_self->bkl_task && !hold) { bkl_drop(); cpu_self->bkl_task = 0; }
        else if (!cpu_self->bkl_task && hold) { bkl_take(); cpu_self->bkl_task = 1; }
        bkl_drop();
    }

    // The flag stays set for the WHOLE handler, not just the service
    // call: everything below it -- task_release, the slab allocator,
    // any kprintf -- takes sched_lock, and an unlock outside the flag
    // would re-arm the cycle interrupt while the handler is still
    // mid-switch, letting a nested trap corrupt the switch it was
    // performing.
    sched_intrap = 0;
}

// Ctrl-C. c4m catches the host signal, records it, and raises
// TRAP_SIGNAL at the next instruction boundary with whatever handler
// was registered -- so it arrives here like any other trap.
//
// What should die is the program that is running, not the machine,
// and not whichever task the signal happened to land on. Since the
// console stopped blocking the host, the idle loop runs alongside
// user work, so "the current task" is as likely to be the kernel's
// idle loop as the program the person meant to stop.
//
// C4IX has no process groups and does not need them. A terminal picks
// its foreground job from a structure that is already here: init waits
// on the program it launched, a shell waits on the job it is running,
// so DESCEND THE WAIT CHAIN and the innermost task is the one in
// front. C4KE asks its programs to declare themselves instead
// (c4ke_set_focus), which is why the compat layer accepts that call
// and ignores it -- this answer is derived, and cannot go stale.
// Whom a parked task is waiting on: its vfork child, the task its wait
// names, or for a waitpid(-1) its newest child still alive.
static struct task *sched_waitee(struct task *t) {
    struct task *n, *c;
    if (t->state != TS_WAITING && t->state != TS_VFORK) return 0;
    if (t->wait_for != -1) return task_get(t->wait_for);
    c = 0;
    n = task_head;
    while (n) {
        if (n->parent == t->id && n->state != TS_ZOMBIE) c = n;
        n = n->next;
    }
    return c;
}

static struct task *sched_foreground() {
    struct task *t, *n;
    int guard;

    // The session's top-level program: whatever a kernel task waits on
    // -- other than the kernel itself, which waits on the idle task.
    t = 0;
    n = task_head;
    while (n) {
        if (n != kernel_task && n->privs == PRIV_KERNEL && n->state == TS_WAITING) {
            if ((t = task_get(n->wait_for))) break;
        }
        n = n->next;
    }
    if (!t) return 0;
    // Then inwards, one job at a time. The guard is paranoia about a
    // wait cycle, which should be impossible.
    guard = 0;
    while (guard < 32) {
        if (!(n = sched_waitee(t))) break;
        t = n;
        ++guard;
    }
    return (t->state == TS_ZOMBIE) ? 0 : t;
}

// A task parked on console input is a shell waiting to be typed at,
// which means the Ctrl-C was typed AT it. Nothing to cancel -- and in
// particular not a background job, which is not in front of anything.
static int sched_reading_console(struct task *t) {
    return t && t->state == TS_BLOCKED && t->block_vn
        && t->block_vn->type == VN_CONSOLE;
}

// Interrupt the foreground job below one task -- a terminal's own Ctrl-C.
// The console's Ctrl-C starts from the session's top-level program; a
// terminal window (c4ix-desktop) starts from the shell it runs, and
// descends the same wait chain from there. Nothing is printed: the caller
// is the terminal, and it shows ^C in its own window. 1 if a job was
// cancelled or signalled, 0 if the root was not waiting on anything.
int sched_intr_below(struct task *root) {
    struct task *t, *n;
    int guard;
    if (!root) return -1;
    t = root;
    guard = 0;
    while (guard < 32) {
        if (!(n = sched_waitee(t))) break;
        t = n;
        ++guard;
    }
    if (t == root || t->state == TS_ZOMBIE || t->privs != PRIV_USER) return 0;
    if (ck_has_handler(t, CK_SIGINT)) { ck_kill(t->id, CK_SIGINT); return 1; }
    t->killsig = CK_SIGINT;
    task_zombify(t, C4IX_EXIT_INTERRUPTED);
    return 1;
}

// Kernel tasks are spared (killing init or kernel ends everything). The
// victim becomes a zombie with a distinguishable status, so whoever
// waits on it learns it was interrupted.
static void sched_interrupt() {
    struct task *t;

    t = sched_foreground();
    if (sched_reading_console(t)) t = 0;
    // No foreground job: fall back to the running task, which covers a
    // program with nothing above it at all.
    if (!t) t = sched_cur;
    if (!t || t->privs != PRIV_USER) {
        kputs("\nc4ix: interrupt (nothing running to cancel)\n");
        return;
    }
    // A C4KE program that installed a SIGINT handler gets to shut
    // itself down; that is the whole point of installing one.
    if (ck_has_handler(t, CK_SIGINT)) {
        kprintf("\nc4ix: interrupt: SIGINT to task %d '%s'\n", t->id, t->name);
        ck_kill(t->id, CK_SIGINT);
        return;
    }
    kprintf("\nc4ix: interrupt: cancelling task %d '%s'\n", t->id, t->name);
    t->killsig = CK_SIGINT;
    task_zombify(t, C4IX_EXIT_INTERRUPTED);
}

// ---- the common face ----

// SYS_AFFINITY: the CPUs task ID may run on, bit k for CPU k, 0 for any;
// MASK < 0 only asks. Its mask before, or -1: no such task, or one that
// is not a program's (kernel tasks are CPU 0's, idle tasks their own
// CPU's). A task running where it may no longer goes at its next trap --
// at once, if it is the caller.
int sched_affinity(int id, int mask) {
    struct task *t;
    int old;
    sched_lock();
    t = task_get(id);
    if (!t || t->cpuidle || t->privs == PRIV_KERNEL) { sched_unlock(); return 0 - 1; }
    old = t->cpumask;
    if (mask >= 0) {
        t->cpumask = mask;
        if (t == sched_cur) sched_resched = 1;
    }
    sched_unlock();
    return old;
}

void sched_yield() {
    if (!sched_cur) return;
    // Already inside the trap handler: it switches on the way out,
    // which IS the yield -- once it knows not to take the fast path.
    // Raising another trap here would nest.
    if (sched_intrap) { sched_resched = 1; return; }
    // A user task gets here in its own context: task_shim, once its entry
    // has returned, dying through task_exit. That is protected mode, and
    // __c4_trap does not leave it (on c4m or libjs), so the handler would
    // run protected, every host opcode in it a nested trap that the
    // re-entry guard drops. It reaps there, so a dead task's frees were
    // all dropped: each cc left c4sc's stack (4 MB then) and its image behind.
    // The syscall gate raises the trap unprotected.
    if (sched_cur->privs == PRIV_USER) { __c4_opcode(0, 0, 0, SYS_YIELD); return; }
    __c4_trap(C4IX_TRAP_SOFT_IRQ, 0);
}

// ---- task start and end ----

static int task_lost() {
    kputs("c4ix: panic: task escaped its shim\n");
    exit(-1);
    return 0;
}

// Every task starts here (via the forged frame): run the image's
// constructors, call the real entry, run its destructors, and turn
// the return value into an exit.
//
// The constructors run HERE rather than at load time because this is
// the first code that executes as the new task. The loader runs in
// the SPAWNING task's context -- the new task does not exist yet, so
// a constructor asking who it is would be told the parent. C4KE's u0
// caches its pid and its parent's and installs eight signal handlers
// in its constructor, so every one of them would have been wired to
// the wrong task.
//
// Destructors run in reverse, the C convention, and it matters here:
// u0's own destructor frees the table the others might use. This is
// the first time C4IX has run them at all -- an X1 debt, closed by
// having somewhere to run them that still has the image mapped.
static int task_shim(int entry, int argc, int argv) {
    struct task *t;
    int e, r, i;

    t = sched_cur;
    i = 0;
    while (i < t->img_ncons) {
        e = ((int *)t->img_cons)[i];
        // The one argument is u0's `int *c4r` module pointer, which it
        // stores and never dereferences. A constructor declared with
        // no parameters simply never reads it.
        e(0);
        ++i;
    }
    e = entry;
    r = e(argc, argv);
    i = t->img_ndes;
    while (i) {
        --i;
        e = ((int *)t->img_des)[i];
        e();
    }
    task_exit(r);
    return 0;   // unreachable
}

// Inside the trap handler a death is a state change, which the switch
// on the way out acts on: someone else is picked, and the zombie never
// comes back. Outside it -- a task whose entry returned, in task_shim --
// the dying task is still running its own code on its own stack, a user
// task behind protected mode, and that is no place to die from:
// task_zombify releases the task to its waiter there and then, and the
// release takes the scheduler lock, which from protected mode is itself
// a trap, out of which the zombie is never picked again, half released.
// So it leaves the code in sched_dying and dies in the trap it raises next.

void task_exit(int code) {
    if (sched_intrap) {
        task_zombify(sched_cur, code);
        return;
    }
    sched_dying_code = code;
    sched_dying = 1;
    // a zombie is never picked again
    while (1) sched_yield();
}

// Block until t exits. No spinning: the caller parks in TS_WAITING
// and task_zombify wakes it with the exit code when t dies (and has
// reaped t by then -- t must not be touched after waking).
int task_wait(struct task *t) {
    struct task *me;
    int code;

    if (t->state == TS_ZOMBIE) {
        code = t->exitcode;
        task_release(t);
        return code;
    }
    me = sched_cur;
    me->wait_for = t->id;
    me->wait_posix = 0;
    me->state = TS_WAITING;
    while (me->state == TS_WAITING) sched_yield();
    return me->wait_result;
}

// Build the stack + fake frame that makes a never-run task resumable:
// sched_trap turns it into registers. Layout (see test_coop_switch.c):
//   X[0] saved bp (junk; the entry's ENT overwrites X[1], not this)
//   X[1] return pc -> task_shim
//   X[2] where task_shim's own LEV would land -> task_lost
//   X[3..5] task_shim's args, last first: argv, argc, entry
int sched_next_stack_words;

int sched_forge(struct task *t, int entry, int argc, int argv) {
    int *stk, *x;
    int i, words;

    words = sched_next_stack_words > C4IX_STACK_WORDS ? sched_next_stack_words : C4IX_STACK_WORDS;
    if (!(stk = (int *)malloc(words * sizeof(int)))) return 0;
    memset(stk, 0, words * sizeof(int));
    x = stk + words - 8;              // slack above, as C4KE leaves
    t->stack_words = words;
    // the guard: the stack grows down towards it
    i = 0;
    while (i < C4IX_STACK_GUARD) { stk[i] = C4IX_STACK_POISON; ++i; }

    x[0] = 0;
    x[1] = (int)&task_shim;
    x[2] = (int)&task_lost;
    x[3] = argv;
    x[4] = argc;
    x[5] = entry;

    t->stack = (int)stk;
    t->sv = SV_FRAME;
    t->sv_sp = (int)x;
    t->sv_bp = 0;
    t->sv_pc = (int)&task_shim;
    return 1;
}

// ---- vfork ----
//
// The child borrows the parent's image, library data and heap until it
// execs or exits, and the parent waits in TS_VFORK meanwhile: one address
// space, as on any machine without an MMU. What it cannot borrow is the
// parent's stack. On a register machine the child runs on it, below the
// frame that called vfork, and that frame's state is in registers the
// kernel saved. Here the stack IS the registers: the caller F of vfork
// has its expression temporaries pushed below its locals -- in `pid =
// vfork()`, the address of pid -- and the child's first call would write
// its own frame over them, and over vfork's return address.
//
// So the child gets a stack of its own, and the trap returns it from
// vfork straight into F: pc is vfork's return address, bp is F's frame,
// in the parent's stack, so F's locals are the parent's own -- which is
// what vfork promises, and what Busybox's spawn() uses, a child's
// failed = errno that the parent reads -- and sp is in the new stack,
// over a copy of everything between vfork's frame and F's, its
// temporaries among it. A function the child calls builds its frame
// there, and the parent's stack below F is never touched.
//
// BP is the frame of the function that executed SYS_VFORK, libc's vfork:
// it must call nothing, so that its caller is F. The usual rule then
// holds as it does everywhere: the child must not return from F, which
// would put it back on the parent's stack, and must leave by execve or
// _exit.
int sched_vfork(int bp) {
    struct task *p, *c;
    int *w;
    int n, top;

    p = sched_cur;
    ++p->nsyscalls;
    if (p->privs != PRIV_USER) return -1;
    w = (int *)bp;
    // [w + 2, F's bp): what F had pushed when it called, and its locals
    n = w[0] - (bp + 2 * sizeof(int));
    if (n < 0 || n > C4IX_STACK_WORDS * sizeof(int) / 2) return -1;
    if (!(c = task_vchild(p))) return -1;
    top = c->stack + (c->stack_words - 8) * sizeof(int);   // sched_forge's slack
    c->sv = SV_REGS;
    c->sv_a = 0;
    c->sv_bp = w[0];
    c->sv_pc = w[1];
    c->sv_sp = top - n;
    memcpy((char *)c->sv_sp, (char *)(bp + 2 * sizeof(int)), n);
    p->posix = 1;
    p->wait_for = c->id;
    p->state = TS_VFORK;
    return c->id;
}

// Point a not-yet-started task's argv somewhere else. The forged frame
// holds whatever the spawner passed, which for a C4KE program is a
// borrowed pointer the caller is about to reuse or free -- so the
// compat layer copies it and then patches the copy in here. Only
// valid while the task is still SV_FRAME; once it has run, argv is
// wherever its own frame put it.
void sched_forge_argv(struct task *t, int argv) {
    int *x;
    if (!t || t->sv != SV_FRAME) return;
    x = (int *)t->sv_sp;
    x[3] = argv;
}

// ---- lifecycle ----

// This CPU's traps: the handler, and preemption. Every CPU's own.
static void sched_arm(int interval) {
    install_trap_handler((int)&sched_trap);
    if (interval) {
        __c4_configure(C4IX_CONF_TRAP_RESTORES_INTERVAL, 1);
        __c4_configure(C4IX_CONF_HANDLER, (int)&sched_trap);
        __c4_configure(C4IX_CONF_INTERVAL, interval);
    }
}

// Another CPU, from __c4_cpu_start: its struct cpu is its own copy of
// the window, so it says who it is there, arms its traps, and becomes
// its idle task, which the task list already has. That parks until an
// IPI says there is work, which arrives as a cycle interrupt and is a
// switch like any other. At shutdown it halts.
static void smp_ap() {
    struct task *me;
    int k, r;
    k = __c4_cpu_id();
    me = smp_idle_t[k];
    cpu_self->id = k;             // the rest of the window starts zeroed
    cpu_self->cur = me;
    cpu_self->idle = me;
    acct_out = __c4_cycles();
    sched_arm(sched_interval);
    while (!smp_stopping) {
        sched_lock();
        smp_settle();
        r = sched_ready_here();
        if (!r) smp_idle[k] = 1;
        sched_unlock();
        if (r) sched_yield();
        else {
            // parked: idle time that counts no cycles, as CPU 0's naps
            acct_park();
            __c4_wait((int)&smp_park[k], 0);
            acct_unpark();
        }
    }
    __c4_fadd((int)&smp_halted, 1);
    __c4_wake((int)&smp_halted, 0);
    __c4_cpu_halt();
}

void sched_init(int interval) {
    struct task *t;
    char name[TASK_NAME_MAX];
    int k;

    // The idle task first, so it is task 0, as NT's idle
    // is; then the context we are running in becomes the kernel task.
    if (!(idle_task = task_create("idle", (int)&sched_idle, 0, 0))) {
        kputs("c4ix: panic: cannot create the idle task\n");
        exit(-1);
    }
    idle_task->cpuidle = 1;
    cpu_self->idle = idle_task;
    kernel_task = task_adopt("kernel");
    kernel_task->state = TS_RUNNING;
    idle_task->parent = kernel_task->id;
    // Processors: libjs's SMP, which has the window. Each other CPU's
    // idle task is in the list now, running, so nothing picks it, and
    // the CPU becomes it when it starts (smp_ap).
    smp_ncpu = 1;
    if (host_has(C4IX_I_C4MJS) && host_has(C4IX_I_SMP)) {
        smp_ncpu = __c4_cpu_count();
        if (smp_ncpu > CPU_MAX) smp_ncpu = CPU_MAX;
    }
    kprintf("c4ix: %d processor%s\n", smp_ncpu, (smp_ncpu > 1) ? "s" : "");
    if (smp_ncpu > 1) {
        // The boot CPU's state moves into the window, where it is its
        // own: a word at a time, since memcpy is the host's and writes the
        // memory under the window, not this CPU's copy
        cpu_self = (struct cpu *)CPU_WINDOW;
        k = 0;
        while (k < sizeof(struct cpu) / sizeof(int)) {
            ((int *)cpu_self)[k] = ((int *)&cpu_boot)[k];
            ++k;
        }
        kernel_task->oncpu = 1;
        cpu_self->bkl_task = 1;
        bkl_take();               // the kernel task's: it runs, and holds the lock
        k = 1;
        while (k < smp_ncpu) {
            name[0] = 'i'; name[1] = 'd'; name[2] = 'l'; name[3] = 'e';
            name[4] = '0' + k % 10; name[5] = 0;
            if (k >= 10) { name[4] = '0' + k / 10; name[5] = '0' + k % 10; name[6] = 0; }
            if (!(t = task_adopt(name))) {
                kputs("c4ix: panic: cannot create an idle task\n");
                exit(-1);
            }
            t->cpuidle = k + 1;
            t->oncpu = k + 1;
            t->parent = kernel_task->id;
            smp_idle_t[k] = t;
            ++k;
        }
    }
    sched_nlive = 0;   // the ones that are always there are not still to finish
    sched_cur = kernel_task;
    acct_out = __c4_cycles();

    install_trap_handler((int)&sched_trap);
    // Ctrl-C arrives as a trap through the same handler.
    __c4_signal(__c4_sigint(), (int)&sched_trap);
    if (interval) {
        // Ask c4m to treat the interrupt mask as part of the
        // trapped context, restored by TLEV. That is what lets
        // sched_trap set preemption for the incoming task through
        // its `interval` parameter instead of arming the machine
        // mid-switch -- and it also tells c4m that a zero interval
        // means "masked", so signals are deferred to the next
        // unmasked instruction rather than delivered into a
        // handler that cannot accept them.
        //
        // Only meaningful with preemption: without it the interval
        // is always zero and nothing would ever be delivered.
        __c4_configure(C4IX_CONF_TRAP_RESTORES_INTERVAL, 1);
        sched_interval = interval;
        __c4_configure(C4IX_CONF_HANDLER, (int)&sched_trap);
        __c4_configure(C4IX_CONF_INTERVAL, interval);
        kprintf("c4ix: cycle interval set to %dk\n", interval / 1024);
    }

    // and the other CPUs, each on a stack of its own
    k = 1;
    while (k < smp_ncpu) {
        if (!(smp_stack[k] = (int)malloc(SMP_STACK_BYTES))) {
            kputs("c4ix: panic: cannot start the other processors\n");
            exit(-1);
        }
        __c4_cpu_start(k, (int)&smp_ap, smp_stack[k] + SMP_STACK_BYTES);
        kprintf("c4ix: CPU %d stack allocated: 0x%08x, CPU booting\n", k, smp_stack[k]);
        ++k;
    }
    sched_banner();
}

// What the machine is, said once at boot, where libjs says it: the
// memory and its layout, and the processors -- which share all of it and
// the one heap, each with nothing of its own but its window (and, past
// CPU 0, its idle task's stack, from the heap).
static void sched_banner() {
    int hb, he, mb, bs;
    if (host_has(C4IX_I_C4MJS)) {
        hb = *(int *)C4IX_HEAP_BASE;
        he = *(int *)C4IX_HEAP_END;
        // the heap ends a megabyte below the top, under the boot stack
        bs = (he + 2 * 1048576 - 1);
        mb = bs / 1048576;
        kprintf("c4ix: %d MB of memory:\n", mb);
        kprintf("  [mem 0x%08x-0x%08x] Kernel\n", 0, hb - 1);
        kprintf("  [mem 0x%08x-0x%08x] Heap (%d MB)\n", hb, he - 1, ((he - hb) / 1024) / 1024);
        kprintf("  [mem 0x%08x-0x%08x] Boot stack (%d MB)\n", he, bs, (((bs + 1) - he) / 1024) / 1024);
    }
    
    if (smp_ncpu > 1) {
        kprintf("  %s\n  CPUs share all memory and the heap\n  each with a %d-byte window of its own at 0x%08x\n",
            host_has(C4IX_I_PAR) ? "a thread each, all at once" : "simulated, taking turns on one thread",
            256, CPU_WINDOW);
    }
}

// Shutdown, from the kernel task: the other CPUs halt. Each takes the
// lock on its way out, so the kernel task lets go of its own meanwhile,
// masked -- an IPI could still arrive, and must not switch it away.
static void smp_stop() {
    int k, h;
    if (smp_ncpu < 2) return;
    __c4_configure(C4IX_CONF_INTERVAL, 0);
    ++sched_lockdepth;
    if (cpu_self->bkl_task) { cpu_self->bkl_task = 0; bkl_drop(); }
    smp_stopping = 1;
    k = 1;
    while (k < smp_ncpu) { __c4_ipi(k); ++k; }
    while ((h = smp_halted) < smp_ncpu - 1) __c4_wait((int)&smp_halted, h);
    bkl_take();
    cpu_self->bkl_task = 1;
    --sched_lockdepth;
    if (sched_interval) __c4_configure(C4IX_CONF_INTERVAL, sched_interval);
    k = 1;
    while (k < smp_ncpu) { free((int *)smp_stack[k]); smp_stack[k] = 0; ++k; }
}

// Disarm the trap machinery: after this the scheduler is inert and
// the task list can be torn down. Without it the cycle interrupt
// would fire after main returns, into a freed task list.
// (No CPU is on any task's stack now: the others have halted.)
void sched_stop() {
    struct task *t;
    __c4_configure(C4IX_CONF_INTERVAL, 0);
    install_trap_handler(0);
    sched_interval = 0;
    sched_cur = 0;
    t = smp_ncpu > 1 ? task_head : 0;
    while (t) { t->oncpu = 0; t = t->next; }
}

// A task parked on console input: what a keystroke would wake.
static int sched_console_reader() {
    struct task *t;
    t = task_head;
    while (t) {
        if (sched_reading_console(t)) return 1;
        t = t->next;
    }
    return 0;
}

// The idle task: what runs when nothing else can, which is to say
// almost always on an idle desktop. It returns -- and the machine shuts
// down -- once no task is left alive but the kernel, which waits on it.
static int sched_idle(int argc, int argv) {
    int nap, due, budget, ms, ready;

    nap = 0;
    while (sched_nlive > 0) {
        // Sweep zombies nobody is waiting on. This is where C4KE reaps
        // too, and it is the only thing that collects a child whose
        // parent never waits -- innerbench spawns several benches and
        // can only wait on one.
        if (sched_nzombies) task_reap_orphans();
        // Under SMP the idle task looks at the kernel under its lock, as
        // the other CPUs' idle tasks do, and says it idles (smp_kick)
        // -- and does not nap when there is work after all: the IPI that
        // said so came while it held the lock, and changed nothing then
        ready = 0;
        if (smp_ncpu > 1) {
            sched_lock();
            smp_settle();
            ready = sched_ready_here();
            smp_idle[0] = !ready;
        }
        // The idle task runs only when nothing else can: everything alive
        // is parked on something that has not arrived, and nothing can
        // make progress until the clock or the outside world moves.
        //
        // A task reading the console is waiting for a keystroke, which
        // comes with no deadline to sleep to, so then the nap backs off
        // the way c4sh does: double it up to a ceiling well inside human
        // reaction time, so the prompt still feels immediate. (It used to
        // drop back to the floor when a pass found a task ready, which
        // since the idle task runs only when none is, it never does.)
        // Nobody reading it, the next thing that can happen is a
        // sleeper's deadline, and the nap goes straight there: one pass
        // where the backoff took seven to cover a desktop's 15 ms sleep.
        if (sched_console_reader()) {
            nap = nap ? nap * 2 : IDLE_NAP_MIN;
            if (nap > IDLE_NAP_MAX) nap = IDLE_NAP_MAX;
        } else nap = IDLE_NAP_LONG;
        // A sleeping task has a deadline, so the backoff must not
        // overshoot it: a 1ms sleep should not wait out a 20ms
        // nap. Milliseconds in, microseconds out.
        if (sched_sleep_due(&due)) {
            budget = (due - __time()) * 1000;
            if (budget < 0) budget = 0;
            if (budget < nap) nap = budget;
        }
        // (an IPI ends the nap early: another CPU left work for this one)
        if (smp_ncpu > 1) sched_unlock();
        // the counter stands still meanwhile: idle time in ms instead
        ms = __time();
        if (smp_ncpu > 1) {
            if (!ready) { acct_park(); __c4_usleep(nap); acct_unpark(); }
        } else {
            __c4_usleep(nap);
            acct_napms = acct_napms + (__time() - ms);
        }
        // The cycle counter stood still while we slept, so the
        // console's own rate limit has no way to know that real
        // time passed. Tell it.
        if (smp_ncpu > 1) sched_lock();
        con_wake();
        if (smp_ncpu > 1) sched_unlock();
        sched_yield();
    }
    return 0;
}

// The kernel task's part once everything is set up: wait for the idle
// task, which ends when nothing else is alive, then reap anything nobody
// waited for.
void sched_run() {
    struct task *t;
    int live;

    task_wait(idle_task);
    smp_stop();
    // The idle task was released while it ran, so it waits on the reap
    // list for a safe point -- and with nothing left there may not be
    // another trap. Here, on the kernel's own stack, is one. (Under SMP
    // the switch away from it left its mark: this CPU is off its stack.)
    smp_settle();
    task_reap();
    live = 1;
    while (live) {
        live = 0;
        t = task_head;
        while (t) {
            if (t->state == TS_ZOMBIE) { task_wait(t); live = 1; t = 0; }
            else t = t->next;
        }
    }
}
src/c4ix/vfs.c 30173
//
// C4IX VFS: vnodes, open file descriptions, per-task fd tables.
//
// Three layers, because that is what dup2 and pipes need:
//
//   vnode   the thing itself -- console, RAM file, host file, pipe
//   file    an open description: flags plus the seek position
//   fd      an index in a per-task table, pointing at a description
//
// dup2 points two fds at ONE description, so they share a position;
// two separate opens of the same file get two descriptions and two
// positions. Spawning clones the table (bumping description refs),
// which is what makes redirection work without fork: set fd 1 up,
// spawn, put fd 1 back.
//
// RAM files are the only writable storage: this VM has no write()
// syscall, so host files stay read-only. That is not a limitation
// worth fighting -- the RAM filesystem is where a shell's `>` will
// point in X4.
//

#include "c4ix.h"

// A note on locking. Kernel TASKS (init, boot) run kernel code with
// preemption enabled, while user tasks reach this file from inside
// the trap handler, where interrupts are already off. So every entry
// point below that mutates shared state -- reference counts above
// all -- brackets itself with sched_lock. Without it a preemption
// between "--refs" and the test that follows can free a description
// another task still holds, and the corruption surfaces much later
// as a task resuming with a garbage program counter. sched_lock is
// nestable and skips the hardware entirely inside the handler, so
// this is close to free on the syscall path.

static struct sl4b_cache *vn_cache;
static struct sl4b_cache *file_cache;
static struct vnode *rootdir;      // "/" -- the RAM filesystem's root
static struct vnode *console;      // the one console vnode
static int vfs_ino;                // the last vnode number given out (stat's st_ino)

static void vfs_namecpy(char *dst, char *src) {
    int i;
    i = 0;
    while (src[i] && i < VN_NAME_MAX - 1) { dst[i] = src[i]; ++i; }
    dst[i] = 0;
}

static void vfs_namecpy2(char *dst, char *src, int len) {
    int i;
    i = 0;
    while (i < len && i < VN_NAME_MAX - 1) { dst[i] = src[i]; ++i; }
    dst[i] = 0;
}

static int vfs_nameeq(char *a, char *b) {
    int i;
    i = 0;
    while (a[i] && b[i]) {
        if (a[i] != b[i]) return 0;
        ++i;
    }
    return a[i] == b[i];
}

static int vn_grow(struct vnode *vn, int need);

// ---- /proc/uptime ----
//
// The clock, as a file: Linux's format, which is what c4m.c reads from
// its host when plain c4 runs it (c4_time_host) -- so `c4 c4m.c`, and
// innerbench -c with it, has a clock here as it has on Linux. Two
// numbers, seconds with two decimals. The first is how long the kernel
// has been up. The second is Linux's idle time summed over its CPUs;
// here it is the same clock in tenths of a second, because that is how
// c4m's default reading takes it (the integer part times 100 is
// milliseconds). `c4m -a` reads the first number instead, and oisc4
// the first with its fraction, so every reader's clock runs at the
// right speed. The bytes are made when the file is read from its start
// (vfs_read), stat'd or fetched whole (vfs_getdata), so two reads a
// second apart see two times.
static int vfs_boot_ms;            // __time() when the VFS came up

// WHOLE.CC into P; the length
static int vfs_fmt(char *p, int whole, int cents) {
    char d[16];
    int n, i;
    n = 0;
    d[n] = '0' + whole % 10; ++n; whole = whole / 10;
    while (whole) { d[n] = '0' + whole % 10; ++n; whole = whole / 10; }
    i = 0;
    while (n) { --n; p[i] = d[n]; ++i; }
    p[i] = '.';
    p[i + 1] = '0' + cents / 10;
    p[i + 2] = '0' + cents % 10;
    return i + 3;
}

static void vfs_proc(struct vnode *vn) {
    int ms, n;
    if (!vn_grow(vn, 64)) return;
    ms = __time() - vfs_boot_ms;
    if (ms < 0) ms = 0;
    n = vfs_fmt(vn->data, ms / 1000, ms % 1000 / 10);
    vn->data[n] = ' '; ++n;
    n = n + vfs_fmt(vn->data + n, ms / 100, ms % 100);
    vn->data[n] = '\n'; ++n;
    vn->data[n] = 0;
    vn->size = n;
}

void vfs_init() {
    struct vnode *vn;
    con_init();
    vn_cache = sl4b_cache_create("vnode", sizeof(struct vnode), 8);
    file_cache = sl4b_cache_create("file", sizeof(struct file), 16);
    console = (struct vnode *)sl4b_alloc(vn_cache);
    console->type = VN_CONSOLE;
    console->refs = 1;
    vfs_namecpy(console->name, "console");

    rootdir = (struct vnode *)sl4b_alloc(vn_cache);
    rootdir->type = VN_DIR;
    rootdir->refs = 1;
    rootdir->parent = rootdir;        // ".." at the root is the root
    vfs_namecpy(rootdir->name, "/");
    console->ino = 1;
    rootdir->ino = 2;
    vfs_ino = 2;

    // /tmp exists from boot, for scratch files (init's demo, cc's
    // objects, the IDE's one-file build). The whole tree is writable,
    // so there is no /ram as C4KE and C4DOS have. Intermediate
    // directories are NOT created implicitly -- open() does not do
    // that in any Unix -- so this one is made here rather than
    // silently conjured on first use.
    vfs_mkdir("/tmp");
    // /proc/uptime, the clock (vfs_proc)
    vfs_boot_ms = __time();
    vfs_mkdir("/proc");
    if ((vn = vfs_ramfile("/proc/uptime"))) vn->type = VN_PROC;
    // /log/kernel: the console, logged (console.c)
    con_logopen();
}

// /log/kernel, made at boot. The kernel holds a reference, so it cannot
// be unlinked from under the console.
struct vnode *vfs_klog() {
    struct vnode *vn;
    vfs_mkdir("/log");
    if ((vn = vfs_ramfile("/log/kernel"))) ++vn->refs;
    return vn;
}

void vfs_logc(struct vnode *vn, int c, int max) {
    if (vn->size >= max || !vn_grow(vn, vn->size + 1)) return;
    vn->data[vn->size] = c;
    ++vn->size;
}

struct vnode *vfs_root() { return rootdir; }

int vfs_isdir(struct vnode *vn) {
    if (!vn) return 0;
    return vn->type == VN_DIR;
}

// The task's working directory, defaulting to the root for anything
// that has not set one (the boot task, or a task created before the
// VFS was up).
struct vnode *vfs_cwd() {
    struct task *t;
    if (!(t = sched_current())) return rootdir;
    if (!t->cwd) t->cwd = rootdir;
    return t->cwd;
}

// ---- path resolution ----
//
// One component at a time, which is the whole point of having
// directories: "." and ".." mean something, and a name is only ever
// matched against the entries of one directory.

static struct vnode *vfs_child(struct vnode *dir, char *name, int len) {
    struct vnode *vn;
    int i;
    if (!vfs_isdir(dir)) return 0;
    vn = dir->child;
    while (vn) {
        i = 0;
        while (i < len) {
            if (vn->name[i] != name[i]) { i = -1; break; }
            ++i;
        }
        if (i == len) { if (!vn->name[len]) return vn; }
        vn = vn->next;
    }
    return 0;
}

static struct vnode *vn_alloc(int type);

// What a directory entry names: a link's file, or the entry itself.
static struct vnode *vn_res(struct vnode *vn) {
    if (vn && vn->type == VN_LINK) return vn->target;
    return vn;
}

static struct vnode *vfs_walk2(char *path, int create, int mkdir);

// Walk PATH. When CREATE is set the final component is made as a
// file (or as a directory when MKDIR is set); intermediate
// components must already exist either way. A link at the end is
// followed to its file; vfs_walk2 is the walk that stops at the entry.
static struct vnode *vfs_walk(char *path, int create, int mkdir) {
    return vn_res(vfs_walk2(path, create, mkdir));
}

static struct vnode *vfs_walk2(char *path, int create, int mkdir) {
    struct vnode *dir;
    struct vnode *vn;
    int i, start, len;

    dir = (path[0] == '/') ? rootdir : vfs_cwd();
    i = 0;
    if (path[0] == '/') ++i;

    while (path[i]) {
        start = i;
        while (path[i]) { if (path[i] == '/') break; ++i; }
        len = i - start;
        while (path[i] == '/') ++i;              // collapse separators

        if (!len) continue;                       // trailing or doubled '/'
        if (len == 1) { if (path[start] == '.') continue; }
        if (len == 2) {
            if (path[start] == '.') {
                if (path[start + 1] == '.') { dir = dir->parent; continue; }
            }
        }

        vn = vfs_child(dir, path + start, len);
        if (!vn) {
            // only the LAST component may be created
            if (!create) return 0;
            if (path[i]) return 0;
            if (!(vn = vn_alloc(mkdir ? VN_DIR : VN_RAMFILE))) return 0;
            vfs_namecpy2(vn->name, path + start, len);
            vn->parent = dir;
            vn->next = dir->child;
            dir->child = vn;
            return vn;
        }
        if (!path[i]) return vn;                  // last component
        dir = vn;                                 // descend
    }
    return dir;                                   // "/" or "." etc.
}

static struct vnode *vn_alloc(int type) {
    struct vnode *vn;
    if (!(vn = (struct vnode *)sl4b_alloc(vn_cache))) return 0;
    vn->type = type;
    vn->refs = 0;
    vfs_ino = vfs_ino + 1;
    vn->ino = vfs_ino;
    vfs_touch(vn);
    return vn;
}

// Modification order. Not a clock -- this machine's clocks differ by
// host, and some hosts have none -- but a counter every create and
// every write takes the next value of. That orders any two changes,
// which is all a build tool needs to know which file is stale.
static int vfs_clock;

void vfs_touch(struct vnode *vn) {
    vfs_clock = vfs_clock + 1;
    vn->mtime = vfs_clock;
}

// Growable storage for RAM files and pipes. c4m's realloc opcode is
// the known-broken one, so this is malloc + copy + free by hand.
static int vn_grow(struct vnode *vn, int need) {
    char *nd;
    int cap;

    if (vn->cap >= need) return 1;
    cap = vn->cap ? vn->cap : 64;
    while (cap < need) cap = cap * 2;
    if (!(nd = (char *)malloc(cap))) return 0;
    memset(nd, 0, cap);
    if (vn->size) memcpy(nd, vn->data, vn->size);
    if (vn->data) free(vn->data);
    vn->data = nd;
    vn->cap = cap;
    return 1;
}

static void vn_release(struct vnode *vn) {
    --vn->refs;
    if (vn->refs > 0) return;
    if (vn->type == VN_HOSTFILE) { close(vn->host); }
    // RAM files and directories outlive their descriptors: they ARE
    // the filesystem.
    if (vn->type == VN_RAMFILE) return;
    if (vn->type == VN_PROC) return;
    if (vn->type == VN_DIR) return;
    if (vn->type == VN_CONSOLE) return;
    if (vn->data) free(vn->data);
    sl4b_free(vn_cache, (char *)vn);
}

struct vnode *vfs_lookup(char *path) {
    return vfs_walk(path, 0, 0);
}

struct vnode *vfs_ramfile(char *path) {
    struct vnode *vn;
    sched_lock();
    vn = vfs_walk(path, 1, 0);
    sched_unlock();
    return vn;
}

// A RAM file whose bytes stay on the host until something needs them.
// vfsload makes these at boot instead of copying every file in its
// manifest: on a host that fetches files over a network (libjs in a
// browser) that is the difference between a boot that downloads the
// whole disk and one that downloads what it runs. The size is known
// now, so stat and ls are right before anything is read.
int vfs_lazyfile(char *path, char *host, int size) {
    struct vnode *vn;
    int n;
    sched_lock();
    if (!(vn = vfs_walk(path, 1, 0)) || vn->type != VN_RAMFILE) { sched_unlock(); return -1; }
    n = 0; while (host[n]) ++n;
    if (vn->hostname) free(vn->hostname);
    if (!(vn->hostname = (char *)malloc(n + 1))) { sched_unlock(); return -1; }
    memcpy(vn->hostname, host, n + 1);
    if (vn->data) { free(vn->data); vn->data = 0; vn->cap = 0; }
    vn->size = size;
    vn->lazy = 1;
    sched_unlock();
    return 0;
}

// Read a lazy file's bytes in from the host, once. After this it is an
// ordinary RAM file. A host file that has gone leaves it empty.
int vfs_fill(struct vnode *vn) {
    int fd, n;
    if (!vn || !vn->lazy) return 1;
    vn->lazy = 0;
    n = vn->size;
    vn->size = 0;
    if ((fd = open(vn->hostname, 0)) < 0) return 0;
    if (!vn_grow(vn, n > 0 ? n : 64)) { close(fd); return 0; }
    while (1) {
        if (vn->size + 4096 > vn->cap && !vn_grow(vn, vn->cap * 2)) break;
        n = read(fd, vn->data + vn->size, vn->cap - vn->size);
        if (n <= 0) break;
        vn->size = vn->size + n;
    }
    close(fd);
    return 1;
}

// What a path is, for a file browser: out[0] is 1 for a directory, 2 for
// a RAM file, 3 for anything else (the console, a pipe); out[1] is the
// size in bytes of a RAM file. -1 when there is no such entry.
// Is this file a program? A loaded file by its C4R signature; a lazy
// one by the host name behind it, so asking never fetches the file (a
// file browser asks for a whole folder at a time).
static int vn_is_program(struct vnode *vn) {
    int n;
    if (vn->type != VN_RAMFILE) return 0;
    if (vn->lazy) {
        n = 0;
        while (vn->hostname[n]) ++n;
        return n > 4 && vn->hostname[n - 4] == '.' && vn->hostname[n - 3] == 'c' &&
               vn->hostname[n - 2] == '4' && vn->hostname[n - 1] == 'r';
    }
    return vn->size >= 13 && vn->data[0] == 'C' && vn->data[1] == '4' && vn->data[2] == 'R';
}

// The first N words of the ST_* record (c4ix.h): out[0] 1 dir, 2 file,
// 3 other; out[1] bytes; out[2] 1 for a program; out[3] mtime; then the
// number, the names, a mode and a device. N is 4 for the callers from
// before there were more. The modes are made up -- there are no owners
// or permissions -- but say what ls and cp need: directories and
// programs are 0755, files 0644, the console and pipes 0666.
void vn_stat(struct vnode *vn, int *out, int n) {
    int st[ST_WORDS];
    int i;
    if (vn->type == VN_PROC) {
        // a file to anything that asks, read-only, as long as it is now
        vfs_proc(vn);
        st[ST_TYPE] = 2; st[ST_SIZE] = vn->size; st[ST_PROG] = 0; st[ST_MTIME] = vn->mtime;
        st[ST_INO] = vn->ino; st[ST_NLINK] = 1; st[ST_MODE] = 33060; st[ST_DEV] = 1;   // S_IFREG|0444
        if (n <= 0) n = 4;
        if (n > ST_WORDS) n = ST_WORDS;
        i = 0;
        while (i < n) { out[i] = st[i]; ++i; }
        return;
    }
    st[ST_TYPE] = vn->type == VN_DIR ? 1 : (vn->type == VN_RAMFILE ? 2 : 3);
    st[ST_SIZE] = vn->type == VN_RAMFILE ? vn->size : 0;
    st[ST_PROG] = vn_is_program(vn);
    st[ST_MTIME] = vn->mtime;
    st[ST_INO] = vn->ino;
    st[ST_NLINK] = 1 + vn->nlinks;
    st[ST_MODE] = vn->type == VN_DIR ? 16877 : vn->type == VN_RAMFILE ? (st[ST_PROG] ? 33261 : 33188)
                : vn->type == VN_PIPE ? 4534 : 8630;   // S_IFDIR|0755, S_IFREG|0755 or 0644, S_IFIFO|0666, S_IFCHR|0666
    st[ST_DEV] = (vn->type == VN_RAMFILE || vn->type == VN_DIR) ? 1 : vn->type == VN_HOSTFILE ? 2 : 0;
    if (n <= 0) n = 4;
    if (n > ST_WORDS) n = ST_WORDS;
    i = 0;
    while (i < n) { out[i] = st[i]; ++i; }
}

int vfs_stat(char *path, int *out, int n) {
    struct vnode *vn;
    sched_lock();
    if (!(vn = vfs_walk(path, 0, 0))) { sched_unlock(); return -1; }
    vn_stat(vn, out, n);
    sched_unlock();
    return 0;
}

// ---- links and truncation ----

// A second name, NEWPATH, for the RAM file PATH: a VN_LINK entry in
// NEWPATH's directory. Only files: a directory with two parents would
// make ".." mean two things. NEWPATH must not exist.
int vfs_link(char *path, char *newpath) {
    struct vnode *vn, *l;
    sched_lock();
    if (!(vn = vfs_walk(path, 0, 0)) || vn->type != VN_RAMFILE || vfs_walk2(newpath, 0, 0)) {
        sched_unlock();
        return -1;
    }
    if (!(l = vfs_walk2(newpath, 1, 0))) { sched_unlock(); return -1; }   // its directory is not there
    l->type = VN_LINK;
    l->target = vn;
    l->lnext = vn->links;
    vn->links = l;
    ++vn->nlinks;
    sched_unlock();
    return 0;
}

// LEN bytes: what was past it goes, and a file grown gets zeros
int vfs_truncate(struct vnode *vn, int len) {
    if (!vn || vn->type != VN_RAMFILE || len < 0) return -1;
    sched_lock();
    if (vn->lazy) vfs_fill(vn);
    if (len > vn->size) {
        if (!vn_grow(vn, len)) { sched_unlock(); return -1; }
        memset(vn->data + vn->size, 0, len - vn->size);
    }
    vn->size = len;
    vfs_touch(vn);
    sched_unlock();
    return 0;
}

// Take VN out of its directory's list
static void vn_detach(struct vnode *vn) {
    struct vnode *p, *q;
    p = vn->parent;
    if (p->child == vn) p->child = vn->next;
    else {
        q = p->child;
        while (q && q->next != vn) q = q->next;
        if (q) q->next = vn->next;
    }
    vn->next = 0;
}

// ---- C4KE's kernel RAM filesystem, over this one ----
//
// C4KE's compilers (c4cc, c4rlink, c4sp's c4lc) write what they build
// with OP_VFS_PUT and read with OP_VFS_GET, because the VM has no write
// opcode. C4KE's table is flat; here a name is a path, so a bare name
// lands in the task's working directory, which is where C4KE's flat
// names meant it. GET hands back the kernel's own bytes, NUL-terminated
// after the end, as C4KE's does: one address space, so the task reads
// them in place.

int vfs_put(char *path, char *buf, int len) {
    struct vnode *vn;
    if (len < 0) return -1;
    sched_lock();
    vn = vfs_walk(path, 1, 0);
    if (!vn || vn->type != VN_RAMFILE) { sched_unlock(); return -1; }
    vn->lazy = 0;
    vn->size = 0;
    if (!vn_grow(vn, len + 1)) { sched_unlock(); return -1; }
    memcpy(vn->data, buf, len);
    vn->data[len] = 0;
    vn->size = len;
    vfs_touch(vn);
    sched_unlock();
    return 0;
}

char *vfs_getdata(char *path, int *plen) {
    struct vnode *vn;
    sched_lock();
    vn = vfs_walk(path, 0, 0);
    if (vn && vn->type == VN_PROC) vfs_proc(vn);
    else if (!vn || vn->type != VN_RAMFILE) { sched_unlock(); return 0; }
    if (vn->lazy) vfs_fill(vn);
    if (!vn_grow(vn, vn->size + 1)) { sched_unlock(); return 0; }
    vn->data[vn->size] = 0;
    if (plen) *plen = vn->size;
    sched_unlock();
    return vn->data;
}

// The files (not folders) of the working directory, for COUNT and NAME.
static int vn_isfile(struct vnode *vn) {
    return vn->type == VN_RAMFILE || vn->type == VN_PROC;
}

static struct vnode *vfs_nth_file(int i) {
    struct vnode *vn;
    vn = vfs_cwd()->child;
    while (vn) {
        if (vn_isfile(vn_res(vn))) { if (!i) return vn; --i; }
        vn = vn->next;
    }
    return 0;
}

int vfs_nfiles() {
    struct vnode *vn;
    int n;
    n = 0;
    vn = vfs_cwd()->child;
    while (vn) { if (vn_isfile(vn_res(vn))) ++n; vn = vn->next; }
    return n;
}

char *vfs_fname(int i) {
    struct vnode *vn;
    if (i < 0 || !(vn = vfs_nth_file(i))) return 0;
    return vn->name;
}

// Take an entry out of its directory. A directory must be empty, and a
// file must not be open. A removed file's storage is freed; a removed
// directory's vnode is not, because some task may still have it as its
// working directory -- it lives on, detached, and costs one small struct.
//
// A name of a file that has others (SYS_LINK) goes, and the file stays.
// A link entry is simply dropped. The file's own entry, its first name,
// is the vnode itself, so the file moves into its first link's place and
// takes that link's name; open descriptors, which point at the vnode,
// never notice.
int vfs_unlink(char *path) {
    struct vnode *vn, *l;
    sched_lock();
    vn = vfs_walk2(path, 0, 0);
    if (!vn || vn == rootdir || !vn->parent ||
        (vn->type == VN_DIR && vn->child) ||
        (vn->type != VN_DIR && vn->type != VN_RAMFILE && vn->type != VN_LINK)) { sched_unlock(); return -1; }
    if (vn->type == VN_LINK) {
        vn_detach(vn);
        l = vn->target;
        if (l->links == vn) l->links = vn->lnext;
        else {
            l = l->links;
            while (l->lnext != vn) l = l->lnext;
            l->lnext = vn->lnext;
        }
        --vn->target->nlinks;
        sl4b_free(vn_cache, (char *)vn);
        sched_unlock();
        return 0;
    }
    if (vn->nlinks) {
        l = vn->links;
        vn->links = l->lnext;
        --vn->nlinks;
        vn_detach(vn);
        vn_detach(l);
        vfs_namecpy(vn->name, l->name);
        vn->parent = l->parent;
        vn->next = vn->parent->child;
        vn->parent->child = vn;
        sl4b_free(vn_cache, (char *)l);
        sched_unlock();
        return 0;
    }
    if (vn->refs > 0) { sched_unlock(); return -1; }
    vn_detach(vn);
    if (vn->type == VN_RAMFILE) {
        if (vn->data) free(vn->data);
        if (vn->hostname) free(vn->hostname);
        sl4b_free(vn_cache, (char *)vn);
    }
    sched_unlock();
    return 0;
}

// A new name in the same directory. NEWNAME is one component: no '/',
// not "." or "..", and not a name the directory already has.
int vfs_rename(char *path, char *newname) {
    struct vnode *vn;
    int n;
    n = 0;
    while (newname[n]) { if (newname[n] == '/') return -1; ++n; }
    if (!n || n >= VN_NAME_MAX) return -1;
    if (newname[0] == '.' && (n == 1 || (n == 2 && newname[1] == '.'))) return -1;
    sched_lock();
    vn = vfs_walk2(path, 0, 0);   // a link is renamed, not its file
    if (!vn || vn == rootdir || !vn->parent || vn->type == VN_PROC || vfs_child(vn->parent, newname, n)) { sched_unlock(); return -1; }
    vfs_namecpy(vn->name, newname);
    sched_unlock();
    return 0;
}

struct vnode *vfs_mkdir(char *path) {
    struct vnode *vn;
    sched_lock();
    if ((vn = vfs_walk(path, 0, 0))) { sched_unlock(); return 0; }  // exists
    vn = vfs_walk(path, 1, 1);
    sched_unlock();
    return vn;
}

int vfs_chdir(char *path) {
    struct vnode *vn;
    struct task *t;
    if (!(vn = vfs_lookup(path))) return -1;
    if (!vfs_isdir(vn)) return -1;
    if (!(t = sched_current())) return -1;
    t->cwd = vn;
    return 0;
}

// Entry INDEX of DIR. Returns 1 if there was one, 0 past the end.
int vfs_direntry(struct vnode *dir, int index, char *name, int *isdir) {
    struct vnode *vn;
    int i;
    if (!vfs_isdir(dir)) return 0;
    sched_lock();
    vn = dir->child;
    i = 0;
    while (vn) {
        if (i == index) {
            vfs_namecpy(name, vn->name);
            *isdir = vfs_isdir(vn_res(vn));
            sched_unlock();
            return 1;
        }
        ++i;
        vn = vn->next;
    }
    sched_unlock();
    return 0;
}

struct vnode *vfs_pipe() {
    return vn_alloc(VN_PIPE);
}

// Wrap an already-open host descriptor. Read-only by nature: the VM
// has no write() syscall to offer.
struct vnode *vn_hostfile(int host) {
    struct vnode *vn;
    if (!(vn = vn_alloc(VN_HOSTFILE))) return 0;
    vn->host = host;
    vfs_namecpy(vn->name, "host");
    return vn;
}

// ---- reading and writing through a description ----

// A pipe read blocks when the buffer is drained and a writer is
// still around; once the last writer closes, the same emptiness
// means end of file instead.
//
// The console answers the same question, which is what lets a task
// waiting for a keystroke park in TS_BLOCKED like any other blocked
// reader instead of stopping the machine inside a host read.
int vfs_readable(struct vnode *vn, int pos) {
    if (vn->type == VN_CONSOLE) return con_poll();
    if (vn->type != VN_PIPE) return 1;
    if (vn->size > vn->rpos) return 1;
    return vn->writers == 0;
}

int vfs_read(struct file *f, char *buf, int len) {
    struct vnode *vn;
    int n, i;

    sched_lock();
    vn = f->vn;
    if (vn->type == VN_CONSOLE) { sched_unlock(); return con_read(buf, len); }
    if (vn->type == VN_HOSTFILE) { sched_unlock(); return read(vn->host, buf, len); }

    if (vn->type == VN_PIPE) {
        n = vn->size - vn->rpos;
        if (n <= 0) { sched_unlock(); return 0; }   // caller checked readable
        if (n > len) n = len;
        memcpy(buf, vn->data + vn->rpos, n);
        vn->rpos = vn->rpos + n;
        if (vn->rpos == vn->size) { vn->rpos = 0; vn->size = 0; }
        sched_unlock();
        return n;
    }

    // RAM file: read from the description's own position. /proc/uptime
    // is one too, made again whenever it is read from the start.
    if (vn->type == VN_PROC && !f->pos) vfs_proc(vn);
    if (vn->lazy) vfs_fill(vn);
    n = vn->size - f->pos;
    if (n <= 0) { sched_unlock(); return 0; }
    if (n > len) n = len;
    memcpy(buf, vn->data + f->pos, n);
    f->pos = f->pos + n;
    sched_unlock();
    return n;
}

int vfs_write(struct file *f, char *buf, int len) {
    struct vnode *vn;
    int i, end;

    sched_lock();
    vn = f->vn;
    if (vn->type == VN_CONSOLE) {
        con_write_task(buf, len);
        sched_unlock();
        return len;
    }
    if (vn->type == VN_HOSTFILE) { sched_unlock(); return -1; }  // no write()
    if (vn->type == VN_DIR || vn->type == VN_PROC) { sched_unlock(); return -1; }

    if (vn->type == VN_PIPE) {
        // Compact first: a drained pipe reuses its buffer instead of
        // growing forever under a steady producer.
        if (vn->rpos && vn->rpos == vn->size) { vn->rpos = 0; vn->size = 0; }
        if (!vn_grow(vn, vn->size + len)) { sched_unlock(); return -1; }
        memcpy(vn->data + vn->size, buf, len);
        vn->size = vn->size + len;
        sched_unlock();
        return len;
    }

    // RAM file: write at the description's position, extending as
    // needed, or at the end for O_APPEND.
    if (vn->lazy) vfs_fill(vn);
    if (f->flags & C4IX_O_APPEND) f->pos = vn->size;
    end = f->pos + len;
    if (!vn_grow(vn, end)) { sched_unlock(); return -1; }
    // past the end (lseek): the gap reads as zeros, whatever a truncate left in the buffer
    if (f->pos > vn->size) memset(vn->data + vn->size, 0, f->pos - vn->size);
    memcpy(vn->data + f->pos, buf, len);
    vfs_touch(vn);
    f->pos = end;
    if (end > vn->size) vn->size = end;
    sched_unlock();
    return len;
}

// Bytes currently stored in a RAM file, or -1 if there is no such file.
int vfs_size(char *name) {
    struct vnode *vn;
    if (!(vn = vfs_lookup(name))) return -1;
    return vn->size;
}

// Kernel-side convenience: print a RAM file's contents to the
// console, used by init to show that redirection captured something.
void vfs_dump(char *name) {
    struct vnode *vn;
    int i;
    if (!(vn = vfs_lookup(name))) { kprintf("(no such ram file: %s)\n", name); return; }
    if (vn->lazy) vfs_fill(vn);
    i = 0;
    while (i < vn->size) { kputc(vn->data[i]); ++i; }
}

// ---- open file descriptions ----

static struct file *file_alloc(struct vnode *vn, int flags) {
    struct file *f;
    if (!(f = (struct file *)sl4b_alloc(file_cache))) return 0;
    sched_lock();
    f->vn = vn;
    f->flags = flags;
    f->pos = 0;
    f->refs = 1;
    ++vn->refs;
    if (vn->type == VN_PIPE) {
        if ((flags & 3) != C4IX_O_RDONLY) ++vn->writers;
    }
    sched_unlock();
    return f;
}

static void file_unref(struct file *f) {
    sched_lock();
    --f->refs;
    if (f->refs > 0) { sched_unlock(); return; }
    if (f->vn->type == VN_PIPE) {
        if ((f->flags & 3) != C4IX_O_RDONLY) --f->vn->writers;
    }
    vn_release(f->vn);
    sl4b_free(file_cache, (char *)f);
    sched_unlock();
}

// ---- per-task descriptor tables ----

struct file *fd_get(struct task *t, int fd) {
    if (fd < 0 || fd >= FD_MAX) return 0;
    return (struct file *)t->fds[fd];
}

int fd_install(struct task *t, struct file *f) {
    int fd;
    sched_lock();
    fd = 0;
    while (fd < FD_MAX) {
        if (!t->fds[fd]) { t->fds[fd] = (int)f; sched_unlock(); return fd; }
        ++fd;
    }
    sched_unlock();
    return -1;
}

int fd_open_vnode(struct task *t, struct vnode *vn, int flags) {
    struct file *f;
    int fd;
    if (!(f = file_alloc(vn, flags))) return -1;
    if ((fd = fd_install(t, f)) < 0) { file_unref(f); return -1; }
    return fd;
}

int fd_close(struct task *t, int fd) {
    struct file *f;
    sched_lock();
    if (!(f = fd_get(t, fd))) { sched_unlock(); return -1; }
    t->fds[fd] = 0;
    t->fdcloexec[fd] = 0;
    file_unref(f);
    sched_unlock();
    return 0;
}

// Point newfd at oldfd's description: same flags, same position.
int fd_dup2(struct task *t, int oldfd, int newfd) {
    struct file *f;
    sched_lock();
    if (!(f = fd_get(t, oldfd))) { sched_unlock(); return -1; }
    if (newfd < 0 || newfd >= FD_MAX) { sched_unlock(); return -1; }
    if (oldfd == newfd) { sched_unlock(); return newfd; }
    if (t->fds[newfd]) fd_close(t, newfd);
    ++f->refs;
    t->fds[newfd] = (int)f;
    t->fdcloexec[newfd] = 0;          // a dup is inherited unless asked otherwise
    sched_unlock();
    return newfd;
}

void fd_init_console(struct task *t) {
    fd_open_vnode(t, console, C4IX_O_RDONLY);   // 0
    fd_open_vnode(t, console, C4IX_O_WRONLY);   // 1
    fd_open_vnode(t, console, C4IX_O_WRONLY);   // 2
}

// Inherit the parent's table -- descriptions are shared, not copied,
// so a redirected fd 1 stays redirected in the child. A descriptor the
// parent marked close-on-spawn (SYS_CLOEXEC) is left out: the desktop
// keeps its end of each terminal's pipes that way, so no shell holds the
// write end of its own stdin (it would never see end of file) or any
// other terminal's pipes.
void fd_clone(struct task *dst, struct task *src) {
    struct file *f;
    int fd;
    sched_lock();
    fd = 0;
    while (fd < FD_MAX) {
        if ((f = fd_get(src, fd)) && !src->fdcloexec[fd]) {
            ++f->refs;
            dst->fds[fd] = (int)f;
        }
        ++fd;
    }
    sched_unlock();
}

// vfork: the child has every descriptor the parent has, close-on-exec
// ones too, and with the same marks; its execve closes them.
void fd_clone_all(struct task *dst, struct task *src) {
    struct file *f;
    int fd;
    sched_lock();
    fd = 0;
    while (fd < FD_MAX) {
        if ((f = fd_get(src, fd))) {
            ++f->refs;
            dst->fds[fd] = (int)f;
            dst->fdcloexec[fd] = src->fdcloexec[fd];
        }
        ++fd;
    }
    sched_unlock();
}

void fd_close_on_exec(struct task *t) {
    int fd;
    sched_lock();
    fd = 0;
    while (fd < FD_MAX) {
        if (t->fds[fd] && t->fdcloexec[fd]) fd_close(t, fd);
        ++fd;
    }
    sched_unlock();
}

void fd_closeall(struct task *t) {
    int fd;
    sched_lock();
    fd = 0;
    while (fd < FD_MAX) {
        if (t->fds[fd]) fd_close(t, fd);
        ++fd;
    }
    sched_unlock();
}
src/c4ix/sys.c 34736
//
// C4IX syscalls: the kernel side of the userland boundary.
//
// Two doors lead here, and both end in sys_dispatch:
//
//   1. The syscall gateway. Userland executes custom opcode SYS_*
//      (>= 200), which c4m does not implement, so it raises
//      TRAP_ILLOP into sched.c's handler. On plain c4 there is no
//      trap machinery at all, so libc4ix calls sys_dispatch through
//      the systable the loader injected -- same function, same
//      numbers, different door.
//
//   2. A protected task executing a host syscall opcode directly.
//      c4m raises TRAP_PM_VIOLATION instead of running it, and
//      sys_pmviolation emulates the opcode ON TOP OF the syscall
//      layer. That is what makes redirection universal: a program
//      that never heard of C4IX and just calls printf still has its
//      output go through the fd its parent gave it.
//
// Everything below fd-level goes through vfs.c. A syscall that must
// block (reading an empty pipe) parks the task and asks the trap
// handler to rewind the pc by one word, so the task re-executes the
// syscall opcode when it wakes -- its arguments are untouched on its
// own stack, so the call simply happens again.
//

#include "c4ix.h"

int sys_restart;    // set when the current syscall must be re-issued

// Park the running task on a vnode. In trap context the handler
// rewinds the pc; in kernel context the caller spins on yield, which
// costs one context switch rather than one syscall.
static int sys_block(struct vnode *vn, int pos) {
    struct task *t;
    t = sched_current();
    t->block_vn = vn;
    t->block_pos = pos;
    t->state = TS_BLOCKED;
    if (sched_in_trap()) { sys_restart = 1; return 1; }
    while (t->state == TS_BLOCKED) sched_yield();
    return 0;
}

int sys_write(int fd, char *buf, int len) {
    struct file *f;
    if (!(f = fd_get(sched_current(), fd))) return -1;
    return vfs_write(f, buf, len);
}

int sys_read(int fd, char *buf, int len) {
    struct file *f;
    struct task *t;

    t = sched_current();
    if (!(f = fd_get(t, fd))) return -1;
    while (!vfs_readable(f->vn, f->pos)) {
        // non-blocking: nothing yet is -1 (EAGAIN), and the caller polls
        if (f->flags & C4IX_O_NONBLOCK) return -1;
        if (sys_block(f->vn, f->pos)) return 0;   // trap path: restarting
        if (!(f = fd_get(t, fd))) return -1;      // table may have moved on
    }
    return vfs_read(f, buf, len);
}

static int sys_same(char *a, char *b) {
    while (*a && *a == *b) { ++a; ++b; }
    return *a == *b;
}

// RAM files first, host files second -- the same precedence C4KE's
// loader uses, and the reason a program can be handed a "file" that
// only ever existed in memory.
//
// /dev/stdin and /dev/tty are how a C4KE program reads its keyboard
// without stopping the machine: c4sh, raycast and type open one
// non-blocking and poll it. The host's answer is the machine's console,
// which is right for a task whose stdin is the console. A task whose
// stdin is a pipe -- anything run in a Terminal, c4m booting C4KE
// there among them -- means that pipe: nobody types at the console for
// it, and C4KE's shell would wait for ever. So for such a task they name
// its own stdin, opened again read-only with the caller's O_NONBLOCK.
int sys_open(char *path, int flags) {
    struct vnode *vn;
    struct task *t;
    struct file *in;
    int h, fd;

    t = sched_current();
    if ((sys_same(path, "/dev/stdin") || sys_same(path, "/dev/tty"))
        && (in = fd_get(t, FD_STDIN)) && in->vn->type != VN_CONSOLE)
        return fd_open_vnode(t, in->vn, C4IX_O_RDONLY | (flags & C4IX_O_NONBLOCK));
    // O_CREAT with O_EXCL: only a file made now. One trap, so nothing can
    // make it between the look and the create.
    if ((flags & C4IX_O_EXCL) && (flags & C4IX_O_CREAT)) {
        if (vfs_lookup(path)) return -1;
        if ((h = open(path, 0)) >= 0) { close(h); return -1; }
    }
    if ((vn = vfs_lookup(path))) {
        if (vn->type == VN_PROC && (flags & 3)) return -1;   // /proc/uptime is read-only
        if (flags & C4IX_O_TRUNC) { vn->size = 0; vn->lazy = 0; vfs_touch(vn); }   // the host bytes are not wanted
        return fd_open_vnode(t, vn, flags);
    }
    if (flags & C4IX_O_CREAT) {
        if (!(vn = vfs_ramfile(path))) return -1;
        return fd_open_vnode(t, vn, flags);
    }
    // Mask to the flags the host may see, but O_NONBLOCK must survive:
    // dropping it silently turns a caller's non-blocking descriptor
    // into a blocking one, and vfs_read on a VN_HOSTFILE goes straight
    // to the host read(), which halts every task in the system rather
    // than parking one. vfs_readable already answers 1 unconditionally
    // for host files, so nothing parks on this path either way, and a
    // -1/EAGAIN return is what a non-blocking reader already expects.
    if ((h = open(path, (flags & 3) | (flags & C4IX_O_NONBLOCK))) < 0) return -1;
    if (!(vn = vn_hostfile(h))) { close(h); return -1; }
    if ((fd = fd_open_vnode(t, vn, flags)) < 0) { close(h); return -1; }
    return fd;
}

int sys_close(int fd) {
    return fd_close(sched_current(), fd);
}

int sys_dup(int fd) {
    struct task *t;
    int n;
    t = sched_current();
    if (!fd_get(t, fd)) return -1;
    n = 0;
    while (n < FD_MAX) {
        if (!fd_get(t, n)) return fd_dup2(t, fd, n);
        ++n;
    }
    return -1;
}

int sys_dup2(int oldfd, int newfd) {
    return fd_dup2(sched_current(), oldfd, newfd);
}

int sys_pipe(int *fds) {
    struct vnode *vn;
    struct task *t;
    int r, w;

    t = sched_current();
    if (!(vn = vfs_pipe())) return -1;
    if ((r = fd_open_vnode(t, vn, C4IX_O_RDONLY)) < 0) return -1;
    if ((w = fd_open_vnode(t, vn, C4IX_O_WRONLY)) < 0) { fd_close(t, r); return -1; }
    fds[0] = r;
    fds[1] = w;
    return 0;
}

// Snapshot of the index'th task, for a userland `ps`. Walking the
// list from userland is not an option -- that is kernel memory --
// so the kernel copies out a fixed-shape record instead.
int sys_taskinfo(int index, int *out) {
    struct task *t;
    char *dst;
    int i;
    long long c;

    t = task_first();
    i = 0;
    while (t && i < index) { t = t->next; ++i; }
    if (!t) return 0;

    out[0] = t->id;
    out[1] = t->parent;
    out[2] = t->state;
    out[3] = t->privs;
    out[4] = t->nsyscalls;
    out[5] = t->ntraps;
    // Cycles, in the two words this record has always had: billions,
    // and the rest. (The caller's own run up to this syscall is in it:
    // the trap charged that on the way in.)
    c = task_cycles(t);
    out[7] = (int)(c / 1000000000);
    out[6] = (int)(c - (long long)out[7] * 1000000000);
    dst = (char *)(out + 8);
    i = 0;
    while (i < TASK_NAME_MAX) { dst[i] = t->name[i]; ++i; }
    out[TI_CPU] = task_cpu(t);
    out[TI_NCPU] = smp_ncpu > 1 ? smp_ncpu : 1;
    return 1;
}

int sys_chdir(char *path) { return vfs_chdir(path); }

int sys_mkdir(char *path) {
    if (!vfs_mkdir(path)) return -1;
    return 0;
}

// Build the absolute path of the working directory by walking
// parents to the root and then emitting the components in reverse.
int sys_getcwd(char *buf, int len) {
    struct vnode *chain[16];
    struct vnode *vn;
    int n, i, j, k;

    vn = vfs_cwd();
    n = 0;
    while (vn != vfs_root() && n < 16) { chain[n] = vn; ++n; vn = vn->parent; }
    if (!n) {
        if (len < 2) return -1;
        buf[0] = '/'; buf[1] = 0;
        return 1;
    }
    k = 0;
    i = n;
    while (i) {
        --i;
        if (k < len - 1) { buf[k] = '/'; ++k; }
        j = 0;
        while (chain[i]->name[j]) {
            if (k < len - 1) { buf[k] = chain[i]->name[j]; ++k; }
            ++j;
        }
    }
    buf[k] = 0;
    return k;
}

// One directory entry per call: returns 1 for a directory, 0 for a
// file, -1 past the end -- so userland never sees a kernel pointer.
int sys_readdir(char *path, int index, char *name) {
    struct vnode *dir;
    int isdir;
    if (!(dir = vfs_lookup(path))) return -1;
    if (!vfs_direntry(dir, index, name, &isdir)) return -1;
    return isdir;
}

// ---- execve and waitpid ----

// Replace the calling task's program: PATH's image, with ARGV and ENVP
// copied into the kernel, a fresh stack, the same id, descriptors and
// directory (less the close-on-exec ones), and the default signal
// handling. The trap then returns into the new image's task_shim, not
// to the caller (sched_reload). A vfork child that execs gives its
// parent its memory back. -1, with nothing changed, if the image will
// not load.
//
// Everything the call names is the old image's memory, or the vfork
// parent's, so it is all copied, and the task renamed, before any of
// that is freed. The old stack is the one this handler runs on, so it
// goes at the next trap.
static int sys_execve(char *path, char **argv, char **envp) {
    struct c4r_image img;
    struct task *t;
    char *name;
    int argc, av, ad, ev, ed, ostack, ok, i;

    t = sched_current();
    if (!t || !sched_in_trap() || t->privs != PRIV_USER) return -1;
    if (!c4r_load(path, &img)) return -1;
    if ((argc = task_strvec(argv, -1, &av, &ad)) < 0) { c4r_unload(&img); return -1; }
    if (task_strvec(envp, -1, &ev, &ed) < 0) {
        if (av) { free((int *)av); free((char *)ad); }
        c4r_unload(&img);
        return -1;
    }
    // A vfork child's stack is its parent's choice for its children; any
    // other task keeps the size it has
    ostack = t->stack;
    if (t->vfparent) sched_next_stack_words = t->spawn_stack ? t->spawn_stack / sizeof(int) : 0;
    else sched_next_stack_words = t->stack_words;
    ok = sched_forge(t, img.entry, argc, av);
    sched_next_stack_words = 0;
    if (!ok) {
        if (av) { free((int *)av); free((char *)ad); }
        if (ev) { free((int *)ev); free((char *)ed); }
        c4r_unload(&img);
        return -1;
    }
    name = path;
    i = 0;
    while (path[i]) { if (path[i] == '/') name = path + i + 1; ++i; }
    i = 0;
    while (name[i] && i < TASK_NAME_MAX - 1) { t->name[i] = name[i]; ++i; }
    t->name[i] = 0;

    task_drop_image(t);
    ck_exec_reset(t);
    if (t->argv_vec) free((int *)t->argv_vec);
    if (t->argv_data) free((char *)t->argv_data);
    if (t->env_vec) free((int *)t->env_vec);
    if (t->env_data) free((char *)t->env_data);
    t->argv_vec = av; t->argv_data = ad;
    t->env_vec = ev; t->env_data = ed;
    fd_close_on_exec(t);
    t->entry = img.entry;
    t->img_code = img.code;
    t->img_data = img.data;
    t->img_cons = img.cons;
    t->img_ncons = img.ncons;
    t->img_des = img.des;
    t->img_ndes = img.ndes;
    t->img_libs = img.libs;
    t->img_nlibs = img.nlibs;
    t->img_bytes = img.bytes;
    if (ostack) sched_stale_stack = ostack;
    sched_reload = 1;
    sched_new_slice();
    return 0;
}

// waitpid(PID, ST, OPTIONS): a child that has exited, PID or (-1) any,
// is reaped, and its id returned with ST[0] its exit code and ST[1] the
// signal that killed it (0 if none). With C4IX_WNOHANG, 0 while none
// has; -1 if the caller has no such child. Otherwise the caller parks
// until one exits, and runs the call again then (task_zombify wakes it
// without reaping, and sys_restart re-executes the syscall). There are
// no process groups, so 0 and below -1 mean any child.
static int sys_waitpid(int pid, int *st, int opts) {
    struct task *t, *c;
    int any, id, code, sig;

    if (!(t = sched_current())) return -1;
    t->posix = 1;
    if (pid < -1 || pid == 0) pid = -1;
    any = 0;
    c = task_head;
    while (c) {
        if (c->parent == t->id && c != t && (pid == -1 || c->id == pid)) {
            if (c->state == TS_ZOMBIE) {
                if (st) { st[0] = c->exitcode; st[1] = c->killsig; }
                id = c->id;
                task_release(c);
                return id;
            }
            any = 1;
        }
        c = c->next;
    }
    // reaped by the idle sweep before this parent asked
    if ((id = task_ghost_child(t->id, pid, &code, &sig))) {
        if (st) { st[0] = code; st[1] = sig; }
        return id;
    }
    if (!any) return -1;
    if ((opts & C4IX_WNOHANG) || !sched_in_trap()) return 0;
    t->wait_for = pid;
    t->wait_posix = 1;
    t->state = TS_WAITING;
    sys_restart = 1;
    return 0;
}

// ---- the dispatcher ----
//
// args[0] is the first argument, args[1] the second, and so on.
// Both doors normalize into that shape before calling.
//
// ---- The display, taken and given back ------------------------------------
//
// libjs's display (libjs/guest/gui.h) serves one ring at a time: the
// program that writes ATTACH last has it, and nothing in the machine stops
// a second one doing so while the first still draws. So a program that
// wants the whole display asks here first (include/display.h), and the
// kernel keeps who has it -- the way Windows 3 to 98 let a DOS game have
// the whole screen, the desktop waiting until it was done.
//
// The holder may agree to give way (DISP_YIELDS): the desktop does. A
// program that asks then waits, asking again, while the holder is told
// (DISP_STATE answers 1) and woken; at its next turn it yields, and runs
// on without drawing. It has the display back when the new holder gives
// it up or dies (task_zombify), and DISP_STATE answers 0 again. A holder
// that has not given way after DISP_GRACE is passed over, so a stuck
// desktop cannot keep a game off the screen; one that did not agree to
// give way is never asked, and a second program is told no. One level
// deep: the desktop under a game, never a game under a game.
enum { DISP_GRACE = 1000 };
static int disp_holder, disp_hyields;               // who has it; gives way?
static int disp_prev, disp_pyields;                 // who gave way to it
static int disp_want, disp_wyields, disp_want_at;   // who asks, and since when

// A holder asleep on the clock or its event ring looks now
static void disp_nudge(int id) {
    struct task *w;
    if ((w = task_get(id)) && w->state == TS_SLEEPING) w->ck_wake = __time();
}

static void disp_pass() {
    disp_prev = disp_holder; disp_pyields = disp_hyields;
    disp_holder = disp_want; disp_hyields = disp_wyields;
    disp_want = 0;
}

// A task gives the display up, or dies having it, waiting under a game
// for it, or asking for it
void sys_display_drop(int id) {
    if (!id) return;
    if (disp_want == id) disp_want = 0;
    if (disp_prev == id) disp_prev = 0;
    if (disp_holder == id) {
        disp_holder = disp_prev; disp_hyields = disp_pyields;
        disp_prev = 0;
        if (disp_holder) disp_nudge(disp_holder);
    }
}

// TAKE: 1 it is the caller's, 0 ask again soon, -1 no. STATE: 0 the
// caller has it, 1 it has it and another asks, 2 it has not. YIELD: 1 it
// passed to the one asking. GIVE: it goes back to who gave way, if anyone.
static int sys_display(struct task *t, int op, int flags) {
    int me;
    if (!t) return -1;
    me = t->id;
    if (op == DISP_TAKE) {
        if (!disp_holder || disp_holder == me) {
            disp_holder = me; disp_hyields = flags & DISP_YIELDS;
            if (disp_want == me) disp_want = 0;
            return 1;
        }
        if (!disp_hyields || disp_prev) return -1;
        if (disp_want && disp_want != me) return -1;
        if (disp_want != me) { disp_want = me; disp_wyields = flags & DISP_YIELDS; disp_want_at = __time(); }
        if (__time() - disp_want_at >= DISP_GRACE) { disp_pass(); return 1; }
        disp_nudge(disp_holder);
        return 0;
    }
    if (op == DISP_STATE) {
        if (disp_holder != me) return 2;
        return disp_want ? 1 : 0;
    }
    if (op == DISP_YIELD) {
        if (disp_holder != me || !disp_want) return 0;
        disp_pass();
        return 1;
    }
    if (op == DISP_GIVE) { sys_display_drop(me); return 0; }
    return -1;
}

// A switch: c4lc compiles one to a jump table, a fixed cost, where a
// ladder of ifs cost six instructions a rung -- SYS_SLEEP, the desktop's
// most frequent call, was the twenty-fourth.
int sys_dispatch(int num, int *args) {
    struct task *t, *s;
    struct file *f;

    if ((t = sched_current())) ++t->nsyscalls;

    switch (num) {
    case SYS_WRITE:    return sys_write(args[0], (char *)args[1], args[2]);
    case SYS_READ:     return sys_read(args[0], (char *)args[1], args[2]);
    case SYS_OPEN:     return sys_open((char *)args[0], args[1]);
    case SYS_CLOSE:    return sys_close(args[0]);
    case SYS_DUP:      return sys_dup(args[0]);
    case SYS_DUP2:     return sys_dup2(args[0], args[1]);
    case SYS_PIPE:     return sys_pipe((int *)args[0]);
    case SYS_CYCLES:   return __c4_cycles();
    case SYS_TASKINFO: return sys_taskinfo(args[0], (int *)args[1]);
    case SYS_CPUSTAT:
        return sched_cpustat((struct cpustat *)args[0], (struct cpustat_task *)args[1], args[2]);
    case SYS_CHDIR:    return sys_chdir((char *)args[0]);
    case SYS_MKDIR:    return sys_mkdir((char *)args[0]);
    case SYS_GETCWD:   return sys_getcwd((char *)args[0], args[1]);
    case SYS_READDIR:  return sys_readdir((char *)args[0], args[1], (char *)args[2]);
    // Signals are the compat layer's machinery, but they are useful to
    // C4IX's own shell too: `jobs` could list a background task and
    // nothing could stop it. A C4IX program installs no handlers, so
    // for one of those this is simply "cancel that job".
    case SYS_KILL:     return ck_kill(args[0], args[1]);
    case SYS_YIELD:    sched_yield(); return 0;
    // Bytes waiting on fd, without ever blocking: the desktop reads every
    // terminal's pipe from one loop. 0 means empty with a writer still
    // there, -1 end of file (or a bad fd).
    case SYS_AVAIL:
        if (!t || !(f = fd_get(t, args[0]))) return -1;
        if (f->vn->type == VN_PIPE) {
            if (f->vn->size > f->vn->rpos) return f->vn->size - f->vn->rpos;
            return f->vn->writers ? 0 : -1;
        }
        if (f->vn->type == VN_CONSOLE) return con_poll() ? 1 : 0;
        if (f->vn->type == VN_RAMFILE || f->vn->type == VN_PROC) return f->vn->size > f->pos ? f->vn->size - f->pos : -1;
        return 1;
    case SYS_INTR:     return sched_intr_below(task_get(args[0]));
    // Drop what a pipe holds unread, from either end: what a tty does with
    // its input queue on Ctrl-C. The desktop's terminals do it, so lines
    // typed at a program that never read them are not run by the shell
    // once it is interrupted. The bytes dropped, or -1 for no pipe.
    case SYS_DISCARD:
        if (!t || !(f = fd_get(t, args[0])) || f->vn->type != VN_PIPE) return -1;
        sched_lock();
        num = f->vn->size - f->vn->rpos;
        f->vn->size = 0; f->vn->rpos = 0;
        sched_unlock();
        return num;
    // the first args[2] words of the ST_* record; 0 asks for the four
    // there were before M7c
    case SYS_STAT:     return vfs_stat((char *)args[0], (int *)args[1], args[2]);
    case SYS_FSTAT:
        if (!t || !(f = fd_get(t, args[0]))) return -1;
        vn_stat(f->vn, (int *)args[1], args[2]);
        return 0;
    // Only a RAM file (or /proc/uptime) has a position to move: a pipe, the console and a
    // host file (the host has no seek) are -1, libc's ESPIPE. Past the
    // end is allowed, and a write there leaves zeros in the gap.
    case SYS_LSEEK:
        if (!t || !(f = fd_get(t, args[0])) || (f->vn->type != VN_RAMFILE && f->vn->type != VN_PROC)) return -1;
        if (args[2] == 0) num = args[1];
        else if (args[2] == 1) num = f->pos + args[1];
        else if (args[2] == 2) num = f->vn->size + args[1];
        else return -1;
        if (num < 0) return -1;
        f->pos = num;
        return num;
    case SYS_FTRUNCATE:
        if (!t || !(f = fd_get(t, args[0])) || (f->flags & 3) == C4IX_O_RDONLY) return -1;
        return vfs_truncate(f->vn, args[1]);
    case SYS_LINK:     return vfs_link((char *)args[0], (char *)args[1]);
    // The environment execve gave the caller, NAME=VALUE strings ending
    // in a null pointer, or 0 for none: the kernel's copy, which libc
    // reads its own from
    case SYS_ENVIRON:  return t ? t->env_vec : 0;
    case SYS_EXECVE:   return sys_execve((char *)args[0], (char **)args[1], (char **)args[2]);
    case SYS_WAITPID:  return sys_waitpid(args[0], (int *)args[1], args[2]);
    // sched_trap services it: it needs the trap's registers. Outside a
    // trap there are none.
    case SYS_VFORK:    return -1;
    case SYS_UNLINK:   return vfs_unlink((char *)args[0]);
    case SYS_RENAME:   return vfs_rename((char *)args[0], (char *)args[1]);
    case SYS_LAZYFILE: return vfs_lazyfile((char *)args[0], (char *)args[1], args[2]);
    // The stack the caller's later spawns get, in bytes; 0 for the
    // default. A compiler on a big source wants more than the default
    // and every task paying for that would be most of the memory.
    case SYS_STACK:
        if (!t || args[0] < 0 || args[0] > C4IX_STACK_MAX) return -1;
        t->spawn_stack = args[0];
        return 0;
    case SYS_CLOEXEC:
        if (!t || !fd_get(t, args[0])) return -1;
        t->fdcloexec[args[0]] = args[1] ? 1 : 0;
        return 0;
    // Sleep for args[0] milliseconds. In a trap it is a state change, the
    // same one C4KE's OP_USER_SLEEP makes (c4ke.c): park on the clock and
    // let the scheduler run everyone else, and nap when nobody is ready.
    // It completes on waking, so nothing re-executes.
    case SYS_SLEEP:
        if (!t || args[0] <= 0) return 0;
        t->ev_wait = 0;
        if (!sched_in_trap()) {
            num = __time() + args[0];
            while (__time() - num < 0) sched_yield();
            return 0;
        }
        t->ck_wake = __time() + args[0];
        t->state = TS_SLEEPING;
        return 0;
    // Sleep args[0] ms, or less: until an event lands in the GUI ring at
    // args[1] (0: none), or with args[2] set, until a pipe the caller
    // reads has data or reaches end of file. The desktop's loop, which
    // used to wake every 15 ms to look (docs/c4ix-cpu.md, step 11).
    case SYS_EVWAIT:
        if (!t || !sched_in_trap()) return 0;
        t->ev_ring = args[1];
        t->ev_wait = (args[1] ? 1 : 0) | (args[2] ? 2 : 0);
        if (sched_events(t)) { t->ev_wait = 0; return 1; }
        t->ck_wake = __time() + (args[0] > 0 ? args[0] : 0);
        t->state = TS_SLEEPING;
        return 0;
    case SYS_DISPLAY:  return sys_display(t, args[0], args[1]);
    case SYS_AFFINITY: return sched_affinity(args[0] ? args[0] : (t ? t->id : 0), args[1]);
    case SYS_NICE:     return sched_nice(args[0] ? args[0] : (t ? t->id : 0), args[1]);
    case SYS_GETPID:   return t ? t->id : -1;
    // Freed with the task if it does not free it itself (task.c)
    case SYS_SBRK:     return task_ualloc(t, args[0]);
    case SYS_EXIT:     task_exit(args[0]); return 0;
    case SYS_SPAWN:
        sched_next_stack_words = (t && t->spawn_stack) ? t->spawn_stack / sizeof(int) : 0;
        s = task_spawn((char *)args[0], args[1], args[2]);
        sched_next_stack_words = 0;
        if (!s) return -1;
        // the child gets its own argv: the parent's may be gone, or
        // rewritten, by the time the child reads it
        if (ck_argv_copy(s, args[1], (char **)args[2])) sched_forge_argv(s, s->argv_vec);
        // Loading the image is a long stay in the kernel, which the slice
        // would count against the parent: a shell that spawns and then
        // waits would reach its wait or not by where the slice happened
        // to end, and a ps its child runs would see it either way. A
        // fresh slice, and it always gets there.
        sched_new_slice();
        return s->id;
    case SYS_WAIT:
        // The target may have been swept by the idle reaper before the
        // parent got round to waiting; its exit code outlives it.
        if (!(s = task_get(args[0]))) {
            if (task_ghost(args[0], &num)) return num;
            return -1;
        }
        if (!sched_in_trap()) return task_wait(s);
        // In trap context blocking is a state change, not a spin: park
        // the caller, and task_zombify completes the wait when the target
        // dies -- it writes the exit code into the saved accumulator,
        // which is this syscall's return value.
        if (s->state == TS_ZOMBIE) {
            num = s->exitcode;
            task_release(s);
            return num;
        }
        t->wait_for = s->id;
        t->wait_posix = 0;
        t->state = TS_WAITING;
        return 0;
    }

    kprintf("c4ix: unknown syscall %d from task %d\n", num, t ? t->id : -1);
    return -1;
}

// ---- emulating guarded host opcodes for protected tasks ----

// printf, formatted onto the fd layer. c4m's own PRTF reads the
// argument count from the word after the opcode -- the compiler
// always emits "PRTF; ADJ n" -- so the trapped returnpc points at
// that ADJ and returnpc[1] is n. Arguments sit above sp in the same
// order c4m would have read them.
//
// The conversion set has to be REAL, not kprintf's five. c4m's PRTF
// hands the format string to the host's printf, so a program written
// for c4m expects everything the host supports; the moment such a
// program runs behind protected mode, this function is what it gets
// instead. C4KE's ps alone uses %3ld, %4ld.%03d, %2d, %3d%% and %*s,
// and %*s is the one that proves the point -- an unrecognised spec
// that does not CONSUME its width argument shifts every conversion
// after it, so the output is not merely misaligned, it is wrong.
//
// Supported: flags '-' and '0' (and '+', ' ', '#' accepted and
// ignored), a width or '*', a precision or '.*', the length
// modifiers l/ll/h/z (every integer here is one word), and the
// conversions d i u x X c s p %. %p is glibc's, which is what c4m's
// PRTF prints: %#x of the pointer, or (nil). libc4ix's uformat is the
// same parser for userland -- keep the two in step.
//
// Output is buffered into one write: through the fd layer this may
// be a pipe or a RAM file, and byte-at-a-time would be absurd.

enum { PF_BUF = 512, PF_HIGH = 480 };

static char pf_buf[PF_BUF];
static int  pf_n;
static int  pf_fd;
static int  pf_out;      // characters emitted, printf's return value

static void pf_flush() {
    if (pf_n) { sys_write(pf_fd, pf_buf, pf_n); pf_n = 0; }
}

static void pf_ch(int c) {
    pf_buf[pf_n] = c;
    ++pf_n;
    ++pf_out;
    if (pf_n >= PF_HIGH) pf_flush();
}

static void pf_pad(int c, int n) {
    while (n > 0) { pf_ch(c); --n; }
}

// Digits of V in BASE, most significant first, into BUF; returns the
// length. Base 16 is treated as UNSIGNED: C4 has no unsigned type, so
// the shift's top nibble is masked off rather than sign-extending --
// 28 bits of a word on a 32-bit machine, 60 on a 64-bit one. (%p of a
// pointer above 0x80000000 is the case that needs it.)
static int pf_digits(char *buf, int v, int base) {
    char tmp[72];
    char *ds;
    int n, i, mask;

    ds = "0123456789abcdef";
    mask = ~(15 << (sizeof(int) * 8 - 4));
    n = 0;
    if (!v) { tmp[0] = '0'; n = 1; }
    while (v) {
        if (base == 16) { tmp[n] = ds[v & 15]; v = (v >> 4) & mask; }
        else { tmp[n] = ds[v - (v / base) * base]; v = v / base; }
        ++n;
    }
    i = 0;
    while (n) { --n; buf[i] = tmp[n]; ++i; }
    return i;
}

static int sys_vprintf(int fd, char *fmt, int *argv, int argc) {
    char num[80];
    char *s;
    int c, v, used, width, prec, left, zero, len, neg, pre, i, base, upper;

    pf_fd = fd;
    pf_n = 0;
    pf_out = 0;
    used = 0;

    while (*fmt) {
        c = *fmt; ++fmt;
        if (c != '%') { pf_ch(c); continue; }
        if (!*fmt) { pf_ch('%'); break; }

        // flags
        left = 0; zero = 0;
        while (1) {
            c = *fmt;
            if (c == '-') { left = 1; ++fmt; }
            else if (c == '0') { zero = 1; ++fmt; }
            else if (c == '+' || c == ' ' || c == '#') { ++fmt; }
            else break;
        }

        // width, possibly from an argument -- a negative one means
        // left-justify, which is how ps asks for it (ps.c:312 computes
        // a width of -2)
        width = 0;
        if (*fmt == '*') {
            ++fmt;
            width = (used < argc) ? argv[used] : 0; ++used;
            if (width < 0) { left = 1; width = -width; }
        } else {
            while (*fmt >= '0' && *fmt <= '9') {
                width = width * 10 + (*fmt - '0'); ++fmt;
            }
        }

        // precision: minimum digits for integers, maximum for strings
        prec = -1;
        if (*fmt == '.') {
            ++fmt; prec = 0;
            if (*fmt == '*') {
                ++fmt;
                prec = (used < argc) ? argv[used] : 0; ++used;
                if (prec < 0) prec = -1;
            } else {
                while (*fmt >= '0' && *fmt <= '9') {
                    prec = prec * 10 + (*fmt - '0'); ++fmt;
                }
            }
        }

        // length modifiers: every integer here is one machine word
        while (*fmt == 'l' || *fmt == 'h' || *fmt == 'z') ++fmt;

        c = *fmt;
        if (!c) { pf_ch('%'); break; }
        ++fmt;

        if (c == '%') { pf_pad(' ', left ? 0 : width - 1); pf_ch('%');
                        pf_pad(' ', left ? width - 1 : 0); continue; }

        // Anything unrecognised prints verbatim AND CONSUMES NOTHING,
        // which keeps the remaining arguments aligned.
        if (c != 'd' && c != 'i' && c != 'u' && c != 'x' && c != 'X'
            && c != 'c' && c != 's' && c != 'p') {
            pf_ch('%'); pf_ch(c);
            continue;
        }

        v = (used < argc) ? argv[used] : 0; ++used;

        if (c == 'c') {
            if (!left) pf_pad(' ', width - 1);
            pf_ch(v);
            if (left) pf_pad(' ', width - 1);
            continue;
        }

        // a null %p is a string, and its precision means nothing
        if (c == 's' || (c == 'p' && !v)) {
            s = (c == 's') ? (char *)v : "(nil)";
            if (!s) s = "(null)";
            if (c == 'p') prec = -1;
            len = 0;
            while (s[len] && (prec < 0 || len < prec)) ++len;
            if (!left) pf_pad(' ', width - len);
            i = 0;
            while (i < len) { pf_ch(s[i]); ++i; }
            if (left) pf_pad(' ', width - len);
            continue;
        }

        // integers, and %p as %#x
        upper = (c == 'X');
        base = (c == 'x' || c == 'X' || c == 'p') ? 16 : 10;
        neg = 0;
        if (base == 10 && v < 0) { neg = 1; v = -v; }
        pre = neg ? 1 : (c == 'p') ? 2 : 0;     // the '-' or the 0x
        len = pf_digits(num, v, base);
        if (upper) {
            i = 0;
            while (i < len) {
                if (num[i] >= 'a' && num[i] <= 'f') num[i] = num[i] - 32;
                ++i;
            }
        }
        // an explicit precision is a minimum digit count, and it
        // overrides zero padding (C's rule)
        if (prec >= 0) { zero = 0; while (len < prec) { i = len; while (i) { num[i] = num[i - 1]; --i; } num[0] = '0'; ++len; } }
        i = len + pre;
        if (!left && !zero) pf_pad(' ', width - i);
        if (neg) pf_ch('-');
        if (c == 'p') { pf_ch('0'); pf_ch('x'); }
        if (!left && zero) pf_pad('0', width - i);
        i = 0;
        while (i < len) { pf_ch(num[i]); ++i; }
        if (left) pf_pad(' ', width - len - pre);
    }

    pf_flush();
    return pf_out;
}

// A protected task executed a host syscall opcode. Service it on the
// kernel's terms and leave the result in the trapped accumulator.
// Anything unrecognized kills the task rather than silently letting
// it run on with a bogus result.
void sys_pmviolation(int op, int *sp, int *returnpc, int *a) {
    struct task *t;
    int argc, i;
    int args[8];

    if ((t = sched_current())) ++t->nsyscalls;

    switch (op) {
    case C4IX_OP_PUTC: *a = sys_write(FD_STDOUT, (char *)sp, 1); return;
    case C4IX_OP_PUTS:
        i = 0;
        while (((char *)sp[0])[i]) ++i;
        *a = sys_write(FD_STDOUT, (char *)sp[0], i);
        return;
    case C4IX_OP_PRTF:
        // returnpc points at the ADJ that follows PRTF; its operand
        // is the pushed-argument count, format string included.
        argc = returnpc[1];
        if (argc > 8) argc = 8;
        // c4m reads them as t[-1], t[-2], ... from sp + argc
        i = 0;
        while (i < argc - 1) { args[i] = sp[argc - 2 - i]; ++i; }
        *a = sys_vprintf(FD_STDOUT, (char *)sp[argc - 1], args, argc - 1);
        return;
    case C4IX_OP_OPEN: *a = sys_open((char *)sp[1], sp[0]); return;
    case C4IX_OP_READ: *a = sys_read(sp[2], (char *)sp[1], sp[0]); return;
    case C4IX_OP_CLOS: *a = sys_close(sp[0]); return;
    // Verbatim, not synthesized, but for C4I_TRAPH (host.c task_info).
    // Programs branch on these bits -- C4KE's ps patches its own code
    // differently when C4I_C4 is set -- so the answer is what the machine
    // actually is, as the task sees it.
    case C4IX_OP_INFO: *a = task_info(); return;
    // __c4_usleep(us): SYS_SLEEP's state change, in whole milliseconds
    // rounded up. On the host it would stop every task, not this one.
    case C4IX_OP_USLP:
        *a = 0;
        if (t && sp[0] > 0) {
            t->ck_wake = __time() + (sp[0] + 999) / 1000;
            t->state = TS_SLEEPING;
        }
        return;
    // __c4_signal(sig, handler): the task's own handler, as a C4KE
    // program's signal() sets it -- entered the same way, through a trap
    // frame. On the machine it would replace the kernel's.
    case C4IX_OP_SIGH: *a = ck_signal(t, sp[1], sp[0]); return;
    // The same blocks as SYS_SBRK: programs free ualloc'd memory with
    // free(), and what they do not free goes with the task (task.c).
    case C4IX_OP_MALC: *a = task_ualloc(t, sp[0]); return;
    case C4IX_OP_FREE: task_ufree(sp[0]); *a = 0; return;
    // install_trap_handler: every trap of every task would go to this
    // one. Only a kernel does that -- C4KE's c4ke.c4r started as a
    // program, say, which then took the machine and wrote through its
    // own failed allocations. It goes as any forbidden opcode does,
    // saying why.
    case C4IX_OP_ITH:
        kprintf("c4ix: task %d tried to install the machine's trap handler"
            " (a kernel run as a program? boot it with c4m), killing it\n",
            t ? t->id : -1);
        task_exit(-1);
        return;
    case C4IX_OP_EXIT:
        kprintf("c4ix: task %d exited via EXIT opcode, status %d\n",
            t ? t->id : -1, sp[0]);
        task_exit(sp[0]);
        return;
    }

    kprintf("c4ix: task %d used forbidden opcode %d, killing it\n",
        t ? t->id : -1, op);
    task_exit(-1);
}
src/c4ix/c4ke.c 26706
//
// C4IX: the C4KE compatibility layer.
//
// C4KE programs are built against include/u0.h and reach their kernel
// through custom opcodes -- numbers >= 128 that no VM implements, so
// executing one raises TRAP_ILLOP. That is the same door C4IX's own
// SYS_* gateway uses, which is why this fits: sched_trap already
// normalises the arguments (the opcode at sp[0], the arguments above
// it), so all that is missing is a second range test and this file.
//
// Only ONE number is fixed. u0's constructor asks for every service
// by NAME through OP_REQUEST_SYMBOL (128) and caches whatever it is
// told, so C4IX assigns its own numbering and C4KE binaries need no
// rebuild -- which is the whole point. If a .c4r has to be recompiled
// to run here, this layer is wrong.
//
// The goal is the tools, not the kernel: ps, top, spin, bench,
// benchtop and innerbench, unmodified, as C4IX tasks.
//

#include "c4ix.h"

// ---- symbol lookup ----
//
// Comparison is memcmp, which is the MCMP opcode -- ONE instruction.
// A hand-rolled character loop would be about eight instructions per
// character, and u0 issues 27 lookups before main() runs; against 27
// candidates of ~26 characters that is over a million instructions
// per program start, for a table lookup.
//
// C4KE compares memcmp(name, "OP_X", strlen("OP_X")), which is a
// PREFIX match -- that is why its chain has to be ordered by
// ascending length, and why a future name extending an earlier one
// would silently resolve to the wrong opcode. Comparing len + 1 bytes
// includes the terminator, making the match exact; the length test in
// front of it both rejects nearly every candidate in two instructions
// and guarantees that extra byte is in bounds.
#define CK_EQ(lit, len)  (n == (len) && !memcmp(name, lit, (len) + 1))

static int ck_symbol(char *name) {
    char *p;
    int n;

    p = name;
    n = 0;
    while (*p) { ++p; ++n; }
    if (n < 7) return 0;
    if (memcmp(name, "OP_", 3)) return 0;

    if (CK_EQ("OP_HALT", 7))                     return CK_HALT;
    if (CK_EQ("OP_VFS_PUT", 10))                 return CK_VFS_PUT;
    if (CK_EQ("OP_VFS_GET", 10))                 return CK_VFS_GET;
    if (CK_EQ("OP_VFS_NAME", 11))                return CK_VFS_NAME;
    if (CK_EQ("OP_VFS_COUNT", 12))               return CK_VFS_COUNT;
    if (CK_EQ("OP_VFS_UNLINK", 13))              return CK_VFS_UNLINK;
    if (CK_EQ("OP_TIME", 7))                     return CK_TIME;
    if (CK_EQ("OP_C4INFO", 9))                   return CK_C4INFO;
    if (CK_EQ("OP_USER_PID", 11))                return CK_USER_PID;
    if (CK_EQ("OP_SCHEDULE", 11))                return CK_SCHEDULE;
    if (CK_EQ("OP_TASK_EXIT", 12))               return CK_TASK_EXIT;
    if (CK_EQ("OP_AWAIT_PID", 12))               return CK_AWAIT_PID;
    if (CK_EQ("OP_TASK_FOCUS", 13))              return CK_TASK_FOCUS;
    if (CK_EQ("OP_USER_KILL", 12))               return CK_USER_KILL;
    if (CK_EQ("OP_USER_SLEEP", 13))              return CK_USER_SLEEP;
    if (CK_EQ("OP_TASK_FINISH", 14))             return CK_TASK_FINISH;
    if (CK_EQ("OP_TASK_CYCLES", 14))             return CK_TASK_CYCLES;
    if (CK_EQ("OP_USER_PARENT", 14))             return CK_USER_PARENT;
    if (CK_EQ("OP_USER_SIGNAL", 14))             return CK_USER_SIGNAL;
    if (CK_EQ("OP_AWAIT_MESSAGE", 16))           return CK_AWAIT_MESSAGE;
    if (CK_EQ("OP_REQUEST_SYMBOL", 17))          return CK_REQUEST_SYMBOL;
    if (CK_EQ("OP_USER_START_C4R", 17))          return CK_USER_START_C4R;
    if (CK_EQ("OP_KERN_TASK_COUNT", 18))         return CK_KERN_TASK_COUNT;
    if (CK_EQ("OP_KERN_TASK_RUNNING", 20))       return CK_KERN_TASK_RUNNING;
    if (CK_EQ("OP_KERN_TASKS_RUNNING", 21))      return CK_KERN_TASKS_RUNNING;
    if (CK_EQ("OP_KERN_TASKS_EXPORT", 20))       return CK_KERN_TASKS_EXPORT;
    if (CK_EQ("OP_DEBUG_KERNELSTATE", 20))       return CK_DEBUG_KERNELSTATE;
    if (CK_EQ("OP_KERN_TASK_CURRENT_ID", 23))    return CK_KERN_TASK_CURRENT_ID;
    if (CK_EQ("OP_KERN_TASKS_EXPORT_FREE", 25))  return CK_KERN_TASKS_EXPORT_FREE;
    if (CK_EQ("OP_KERN_REQUEST_EXCLUSIVE", 25))  return CK_KERN_REQUEST_EXCLUSIVE;
    if (CK_EQ("OP_KERN_RELEASE_EXCLUSIVE", 25))  return CK_KERN_RELEASE_EXCLUSIVE;
    if (CK_EQ("OP_CURRENTTASK_UPDATE_NAME", 26)) return CK_CURRENTTASK_UPDATE_NAME;
    if (CK_EQ("OP_KERN_TASKS_EXPORT_UPDATE", 27)) return CK_KERN_TASKS_EXPORT_UPDATE;

    // Loud, because the failure is otherwise invisible: u0 stores the
    // 0, and executing opcode 0 later raises TRAP_OPV somewhere else
    // entirely.
    kprintf("c4ix: c4ke: task %d asked for unknown symbol '%s'\n",
        sched_current() ? sched_current()->id : -1, name);
    return 0;
}

// ---- odds and ends ----

static void ck_namecpy(struct task *t, char *src) {
    int i;
    i = 0;
    while (i < TASK_NAME_MAX - 1 && src[i]) { t->name[i] = src[i]; ++i; }
    t->name[i] = 0;
}

// A C4KE task holds the exclusive lock so its output cannot be
// interleaved (ps brackets its whole listing in one). C4IX's
// sched_lock is exactly that, and the depth already travels with the
// task across context switches. The flag makes the pair idempotent:
// a program calling request twice, or release without request, must
// not be able to wedge sched_lockdepth permanently.
static int ck_exclusive(struct task *t, int on) {
    if (!t) return 0;
    if (on) {
        if (!t->ck_excl) { t->ck_excl = 1; sched_lock(); }
    } else {
        if (t->ck_excl) { t->ck_excl = 0; sched_unlock(); }
    }
    return 0;
}

static int ck_running(int id) {
    struct task *t;
    if (!(t = task_get(id))) return 0;
    return t->state != TS_ZOMBIE;
}

static int ck_tasks_running() {
    struct task *t;
    int n;
    n = 0;
    t = task_head;
    while (t) {
        if (t->state == TS_READY || t->state == TS_RUNNING) ++n;
        t = t->next;
    }
    return n;
}

static void ck_kernelstate() {
    struct task *t;
    int ready, waiting, zombie;

    ready = 0; waiting = 0; zombie = 0;
    t = task_head;
    while (t) {
        if (t->state == TS_ZOMBIE) ++zombie;
        else if (t->state == TS_READY || t->state == TS_RUNNING) ++ready;
        else ++waiting;
        t = t->next;
    }
    kprintf("c4ix: %d tasks: %d ready, %d waiting, %d zombie; %d switches\n",
        task_count(), ready, waiting, zombie, sched_switches);
}

// ---- the task table, as C4KE's ps and top expect to read it ----
//
// One kernel-allocated block: a three-word header, then CK_TASK_SLOTS
// fixed-size records that userland indexes directly. This is a hard
// ABI, not a copy-out API -- ps reads it with the offsets from u0.h
// and mutates its own copy in place -- so the layout in c4ix.h has to
// match u0.h exactly.

// Cycles per millisecond, measured once. C4IX has no per-task
// millisecond accounting and adding one would mean calling __time()
// at every context switch; the TIMEMS column is a display, so it is
// DERIVED from the cycle count that is already exact. Calibrating
// costs one busy wait at the first ps.
static int ck_cpms;

static void ck_calibrate() {
    int t0, c0, ms;

    if (ck_cpms) return;
    // Wait for a tick boundary first, so the window is a whole
    // number of milliseconds rather than a partial one.
    t0 = __time();
    while (__time() == t0) ;
    t0 = __time();
    c0 = __c4_cycles();
    while ((ms = __time() - t0) < 100) ;
    ck_cpms = (__c4_cycles() - c0) / ms;
    if (ck_cpms < 1) ck_cpms = 1;
}

static char *ck_strdup(char *s) {
    char *d;
    int n, i;
    n = 0;
    while (s[n]) ++n;
    if (!(d = (char *)malloc(n + 1))) return 0;
    i = 0;
    while (i <= n) { d[i] = s[i]; ++i; }
    return d;
}

// C4IX's TS_* are small integers; C4KE's STATE_* are bit flags that
// ps tests with &. A zero state means "empty slot", so a live task
// must never map to one.
static int ck_state(struct task *t) {
    if (t->state == TS_ZOMBIE) return CK_STATE_ZOMBIE;
    if (t->state == TS_READY || t->state == TS_RUNNING)
        return CK_STATE_LOADED | CK_STATE_RUNNING;
    return CK_STATE_LOADED | CK_STATE_WAITING;
}

static int ck_wstate(struct task *t) {
    if (t->state == TS_SLEEPING) return CK_WSTATE_TIME;
    if (t->state == TS_WAITING || t->state == TS_VFORK) return CK_WSTATE_PID;
    // ps prints 'S' for this one: parked inside a syscall, which is
    // exactly what a blocked read is.
    if (t->state == TS_BLOCKED) return CK_WSTATE_SYSCALL;
    return CK_WSTATE_NONE;
}

// C4KE numbers privilege NONE=0, USER=1, KERNEL=2; C4IX numbers it
// KERNEL=0, USER=1. They agree on 1 and on nothing else. ps indexes
// prio_table = "-UK" with this, so getting it wrong prints '-' for
// every kernel task -- a wrong answer that looks plausible.
static int ck_privs_out(int p) {
    return (p == PRIV_KERNEL) ? CK_PRIV_KERNEL : CK_PRIV_USER;
}

static void ck_export_fill(int *kti) {
    int *kte;
    struct task *t;
    int n;
    long long c;

    ck_calibrate();
    kte = kti + CK_KTI__Sz;
    n = 0;
    t = task_head;
    while (t && n < CK_TASK_SLOTS) {
        // The name is a COPY. One address space means a pointer into
        // the task would work -- right up to the refresh where that
        // task has been reaped and ps prints from freed slab memory.
        if (kte[CK_KTE_NAME]) free((char *)kte[CK_KTE_NAME]);
        kte[CK_KTE_NAME] = (int)ck_strdup(t->name);
        kte[CK_KTE_NAMELEN] = 0;
        while (t->name[kte[CK_KTE_NAMELEN]]) ++kte[CK_KTE_NAMELEN];

        c = task_cycles(t);

        kte[CK_KTE_STATE] = ck_state(t);
        kte[CK_KTE_WAITSTATE] = ck_wstate(t);
        kte[CK_KTE_ID] = t->id;
        kte[CK_KTE_PARENT] = t->parent;
        kte[CK_KTE_PRIORITY] = 0;
        kte[CK_KTE_PRIVS] = ck_privs_out(t->privs);
        kte[CK_KTE_NICE] = 0;
        // billions and the rest, as C4KE keeps them (the high word used
        // to be dropped here, so a task past a billion cycles restarted)
        kte[CK_KTE_CYCLES_HI] = (int)(c / 1000000000);
        kte[CK_KTE_CYCLES] = (int)(c - (long long)kte[CK_KTE_CYCLES_HI] * 1000000000);
        kte[CK_KTE_TIMEMS] = (int)(c / ck_cpms);
        kte[CK_KTE_TRAPS] = t->ntraps;
        // BYTES USED, not the base address: the stack grows down from
        // the top of the allocation, so used = top - sp. sv_sp is only
        // current as of this task's last context switch, which is the
        // same accuracy C4KE reports. The kernel task runs on the VM's
        // own stack and has no allocation to measure.
        kte[CK_KTE_STACK] = t->stack
            ? (t->stack + t->stack_words * sizeof(int)) - t->sv_sp : 0;
        kte[CK_KTE_ALLOC] = 0;   // C4IX does not track per-task allocation

        kte = kte + CK_KTE__Sz;
        ++n;
        t = t->next;
    }
    // Clear any records left over from a larger listing, or ps would
    // report tasks that have gone.
    while (n < CK_TASK_SLOTS) {
        if (kte[CK_KTE_NAME]) { free((char *)kte[CK_KTE_NAME]); kte[CK_KTE_NAME] = 0; }
        kte[CK_KTE_STATE] = CK_STATE_UNLOADED;
        kte = kte + CK_KTE__Sz;
        ++n;
    }
    kti[CK_KTI_USED] = task_count() < CK_TASK_SLOTS ? task_count() : CK_TASK_SLOTS;
}

static int ck_export() {
    int *kti;
    int words;

    words = CK_KTI__Sz + CK_TASK_SLOTS * CK_KTE__Sz;
    if (!(kti = (int *)malloc(words * sizeof(int)))) return 0;
    memset(kti, 0, words * sizeof(int));
    kti[CK_KTI_COUNT] = CK_TASK_SLOTS;
    kti[CK_KTI_LIST] = (int)(kti + CK_KTI__Sz);
    ck_export_fill(kti);
    return (int)kti;
}

static void ck_export_free(int *kti) {
    int *kte;
    int n;

    if (!kti) return;
    kte = kti + CK_KTI__Sz;
    n = 0;
    while (n < CK_TASK_SLOTS) {
        if (kte[CK_KTE_NAME]) free((char *)kte[CK_KTE_NAME]);
        kte = kte + CK_KTE__Sz;
        ++n;
    }
    free(kti);
}

// ---- spawning a C4KE program ----
//
// kern_user_start_c4r(argc, argv, name, privileges), so args[0]=argc,
// args[1]=argv, args[2]=name, args[3]=privileges.

// C4KE numbers privilege the other way round (see ck_privs_out), and
// demotes a request it will not grant rather than refusing it.
static int ck_privs_in(int p, struct task *caller) {
    if (p == CK_PRIV_KERNEL && caller && caller->privs == PRIV_KERNEL)
        return PRIV_KERNEL;
    return PRIV_USER;
}

// Copy argv into memory the task owns, freed when it is reaped
// (ck_task_free). C4KE's callers assume the kernel copies, and they
// are right to: benchtop rewrites its OWN argv array between spawns,
// and innerbench frees its argv while the spawned tasks are still
// running. C4IX's own SYS_SPAWN copies too (sys.c): a parent may exit
// before its child reads argv -- vfsload starting the root archive's
// unpack in the background and leaving is exactly that.
int ck_argv_copy(struct task *t, int argc, char **argv) {
    char **vec;
    char *blob, *p;
    int i, n, bytes;

    t->argv_vec = 0;
    t->argv_data = 0;
    if (argc <= 0 || !argv) return 1;

    bytes = 0;
    i = 0;
    while (i < argc) {
        if (argv[i]) { n = 0; while (argv[i][n]) ++n; bytes = bytes + n + 1; }
        else bytes = bytes + 1;
        ++i;
    }
    if (!(vec = (char **)malloc((argc + 1) * sizeof(int)))) return 0;
    if (!(blob = (char *)malloc(bytes))) { free((int *)vec); return 0; }

    p = blob;
    i = 0;
    while (i < argc) {
        vec[i] = p;
        if (argv[i]) { n = 0; while (argv[i][n]) { *p = argv[i][n]; ++p; ++n; } }
        *p = 0; ++p;
        ++i;
    }
    vec[argc] = 0;
    t->argv_vec = (int)vec;
    t->argv_data = (int)blob;
    return 1;
}

// C4KE programs are named plainly -- innerbench spawns "bench",
// benchtop spawns "top" -- so a bare name has to be found. NOT the
// shell's order, which tries c4ix-NAME.c4r first: that would silently
// hand back C4IX's own top for C4KE's, two different programs.
static struct task *ck_spawn(char *name, int argc, int argv, int privs) {
    char path[PATH_MAX];
    struct task *t;
    int n, i;

    n = 0;
    while (name[n] && n < PATH_MAX - 24) { path[n] = name[n]; ++n; }
    path[n] = 0;
    // Try the name as given, then with .c4r, exactly as C4KE does.
    // The bare name may well name a real file that is not an image --
    // "c4m" is the host binary sitting in the repo root -- so a failed
    // signature check here is ordinary, not an error worth reporting.
    loader_quiet = 1;
    t = task_spawn_priv(path, argc, argv, privs);
    loader_quiet = 0;
    if (t) return t;

    i = n;
    path[i] = '.'; path[i+1] = 'c'; path[i+2] = '4'; path[i+3] = 'r'; path[i+4] = 0;
    if ((t = task_spawn_priv(path, argc, argv, privs))) return t;

    return 0;
}

static int ck_start_c4r(struct task *caller, int *args) {
    struct task *t;
    char **argv;
    char *label;
    int privs;

    // The IMAGE comes from argv[0], not from the `name` argument --
    // C4KE's task_loadc4r does `file = argv[0]` and treats name as a
    // label. innerbench relies on exactly that: it passes the title
    // "inner-kernel" with argv[0] = "c4m".
    argv = (char **)args[1];
    if (args[0] < 1 || !argv || !argv[0]) return 0;
    privs = ck_privs_in(args[3], caller);
    if (!(t = ck_spawn(argv[0], args[0], args[1], privs))) {
        kprintf("c4ix: c4ke: cannot start '%s'\n", argv[0]);
        return 0;
    }
    // C4KE renames the task to the whole command line; the label the
    // caller chose is shorter and says more in TASK_NAME_MAX columns.
    if ((label = (char *)args[2])) ck_namecpy(t, label);
    // Replace the borrowed argv with the task's own copy, now that
    // there is a task to own it. The forged frame already holds the
    // caller's pointer, so patch it where the shim will read it.
    if (ck_argv_copy(t, args[0], argv)) sched_forge_argv(t, t->argv_vec);
    return t->id;
}

// ---- signals ----
//
// Per task, lazily: CK_SIG_MAX triples of {pending, blocked, handler},
// the same shape C4KE uses so the semantics are directly comparable.
// Allocated on the first signal() call, which for a u0 program is
// eight calls into its constructor.
//
// Delivery is the interesting half, and it happens in
// ck_signal_deliver below.

static int ck_tlev_word;   // a TLEV instruction, addressed as data

static int *ck_sigtab(struct task *t, int make) {
    int *s;
    if (t->ck_sigh) return (int *)t->ck_sigh;
    if (!make) return 0;
    if (!(s = (int *)malloc(CK_SIG_MAX * 3 * sizeof(int)))) return 0;
    memset(s, 0, CK_SIG_MAX * 3 * sizeof(int));
    t->ck_sigh = (int)s;
    return s;
}

int ck_signal(struct task *t, int sig, int handler) {
    int *s;
    int old;
    if (!t || sig < 1 || sig >= CK_SIG_MAX) return 0;
    if (!(s = ck_sigtab(t, 1))) return 0;
    old = s[sig * 3 + 2];
    s[sig * 3 + 2] = handler;
    return old;
}

int ck_has_handler(struct task *t, int sig) {
    int *s;
    if (!t || sig < 1 || sig >= CK_SIG_MAX) return 0;
    if (!(s = ck_sigtab(t, 0))) return 0;
    return s[sig * 3 + 2] != 0;
}

// The default action when nobody installed a handler.
//
// IGNORE is the important half and it is not the obvious one: top
// does kill(parent(), SIGUSR1) unconditionally to say it started, and
// innerbench -- its parent -- installs no SIGUSR1 handler. A POSIX
// "terminate" default would kill innerbench the moment top came up.
// The three that do terminate are the three a person means by them.
static int ck_default_kills(int sig) {
    return sig == CK_SIGKILL || sig == CK_SIGTERM || sig == CK_SIGINT;
}

int ck_kill(int pid, int sig) {
    struct task *t;
    int *s;

    if (sig < 1 || sig >= CK_SIG_MAX) return -1;
    if (!(t = task_get(pid))) return -1;
    if (t->state == TS_ZOMBIE) return -1;

    s = ck_sigtab(t, 0);
    if (!s || !s[sig * 3 + 2]) {
        if (!ck_default_kills(sig)) return 0;
        t->killsig = sig;
        task_zombify(t, C4IX_EXIT_INTERRUPTED);
        return 0;
    }

    ++s[sig * 3];
    ++t->ck_sigpend;
    // A signal wakes a parked task -- otherwise a handler installed to
    // shut a sleeping program down would never get to run, which is
    // exactly what innerbench's graceful shutdown depends on.
    if (t->state == TS_SLEEPING || t->state == TS_WAITING
        || t->state == TS_BLOCKED) t->state = TS_READY;
    return 0;
}

// Deliver one pending signal to the task that is about to resume, by
// building it a trap frame by hand -- the same frame c4m's trap()
// builds, so the handler returns through an ordinary TLEV and lands
// exactly where the task was.
//
// MODE and INTERVAL are the context the task would have resumed with,
// computed by the caller. They go INTO the frame, so the handler's
// return restores them; the caller's own frame slots keep them too,
// which is what runs the handler itself in the right mode.
//
// Two slots are easy to leave out and neither failure is local:
//
//   bp+6 mode      -- TLEV loads it into the mode register. C4KE left
//                     this uninitialised, and the resulting garbage
//                     made the next PRTF look like a protected-mode
//                     violation. That was its shutdown segfault.
//   bp+9 interval  -- C4IX opted into CONF_TRAP_RESTORES_INTERVAL, so
//                     TLEV restores the preemption interval from here.
//                     Omit it and the handler's return loads garbage:
//                     preemption stops, or the cycle interrupt fires
//                     continuously.
void ck_signal_deliver(struct task *t, int *pa, int *pbp, int *psp,
                       int *ppc, int mode, int interval) {
    int *sp, *s, *h;
    int sig;

    if (!t || !t->ck_sigpend || t->state == TS_ZOMBIE) return;
    if (!(s = ck_sigtab(t, 0))) { t->ck_sigpend = 0; return; }

    sig = 1;
    while (sig < CK_SIG_MAX) {
        if (s[sig * 3] && s[sig * 3 + 2]) break;
        ++sig;
    }
    if (sig == CK_SIG_MAX) { t->ck_sigpend = 0; return; }
    --s[sig * 3];
    --t->ck_sigpend;
    h = (int *)s[sig * 3 + 2];

    if (!ck_tlev_word) ck_tlev_word = __opcode("TLEV");

    sp = (int *)*psp;
    sp = sp - 15;              // c4m's TRAP_OFFSET, so the frame has slack

    *--sp = interval;          // bp+9
    *--sp = C4IX_TRAP_SIGNAL;  // bp+8
    *--sp = sig;               // bp+7
    *--sp = mode;              // bp+6
    *--sp = *pa;               // bp+5
    *--sp = *pbp;              // bp+4
    *--sp = *psp;              // bp+3  the ORIGINAL sp, not the offset one
    *--sp = *ppc;              // bp+2
    *--sp = (int)&ck_tlev_word; // bp+1  where the handler's LEV lands
    --sp;                      // bp+0
    *pbp = (int)sp;
    *sp = (int)sp;             // self-referential, exactly as c4m does

    // Room for the handler's own locals, read from the ENT it skips.
    sp = sp - h[1];
    *psp = (int)sp;
    *ppc = (int)(h + 2);
}

void ck_task_free(struct task *t) {
    ck_exec_reset(t);
    if (t->argv_vec) { free((int *)t->argv_vec); t->argv_vec = 0; }
    if (t->argv_data) { free((char *)t->argv_data); t->argv_data = 0; }
}

// A new image: the handlers, and the signals waiting for them, were the
// old one's, so the dispositions go back to their defaults, as execve's do.
void ck_exec_reset(struct task *t) {
    if (t->ck_sigh) { free((int *)t->ck_sigh); t->ck_sigh = 0; }
    t->ck_sigpend = 0;
}

// ---- the dispatcher ----
//
// args[0] is the first argument, as sched_trap normalises it. The
// return value becomes the trapped accumulator, which is the value of
// the __c4_opcode(...) expression in the calling program.
//
// Anything that "does not return" -- exit, and later sleep -- is a
// STATE CHANGE here, not a jump. sched_trap ends in a scheduling
// decision that acts on it, so none of C4KE's __c4_jmp gymnastics are
// needed.
//
// A switch, as sys_dispatch is: the CK_* numbers are dense, so c4lc
// makes it a jump table. It was kept a ladder of ifs for a while, because
// benchtop failed with the switch at some kernel-image path lengths. The
// table was never written: the change of timing let init be preempted in
// task_spawn_priv, and benchtop ran before it had its constructors
// (docs/c4ix-cpu.md, step 7).
int ck_dispatch(int num, int *args) {
    struct task *t, *s;
    int code;

    t = sched_current();
    if (t) ++t->nsyscalls;

    switch (num) {
    case CK_REQUEST_SYMBOL: return ck_symbol((char *)args[0]);

    // identity and accounting
    case CK_USER_PID:            return t ? t->id : -1;
    case CK_USER_PARENT:         return t ? t->parent : -1;
    case CK_KERN_TASK_CURRENT_ID: return t ? t->id : -1;
    case CK_TASK_CYCLES:         return t ? (int)task_cycles(t) : 0;
    case CK_C4INFO:              return task_info();
    case CK_TIME:                return __time();

    // the task table, as far as this stage goes
    case CK_KERN_TASK_COUNT:     return task_count();
    case CK_KERN_TASK_RUNNING:   return ck_running(args[0]);
    case CK_KERN_TASKS_RUNNING:  return ck_tasks_running();

    // scheduling. The switch at the end of sched_trap IS the yield, once
    // the trap is told not to take its fast path straight back here.
    case CK_SCHEDULE:            sched_yield(); return ck_tasks_running() > 1;

    case CK_TASK_EXIT:           task_exit(args[0]); return 0;
    // C4KE plants this on a task's stack so returning from main traps
    // here; C4IX uses task_shim instead, so it should never execute.
    // It still has to resolve, and behaving like exit is the honest
    // thing for it to do if it ever does.
    case CK_TASK_FINISH:         task_exit(0); return 0;

    case CK_CURRENTTASK_UPDATE_NAME:
        if (t) ck_namecpy(t, (char *)args[0]);
        return 0;

    case CK_KERN_REQUEST_EXCLUSIVE: return ck_exclusive(t, 1);
    case CK_KERN_RELEASE_EXCLUSIVE: return ck_exclusive(t, 0);

    case CK_DEBUG_KERNELSTATE:   ck_kernelstate(); return 0;

    // C4IX derives the foreground job from the wait chain rather than
    // being told, so this is accepted and ignored. See sched.c.
    case CK_TASK_FOCUS:          return 0;

    // C4KE's own halt does nothing either.
    case CK_HALT:
        kprintf("c4ix: c4ke: task %d requested halt (ignored)\n", t ? t->id : -1);
        return 0;

    // Sleep is a STATE CHANGE, not a spin: park on the clock and let
    // the scheduling decision at the end of sched_trap pick someone
    // else. No sys_restart -- unlike a blocking read, a sleep
    // COMPLETES when it wakes, so the opcode must not re-execute.
    // The 0 returned here is saved into sv_a and is what the task
    // sees when it resumes.
    //
    // __time() is called directly and deliberately not cached: c4m
    // picks the right clock for its host (a plain system call when
    // native, the /proc/uptime reader only under plain c4) and
    // degrades cleanly through any nesting depth.
    case CK_USER_SLEEP:
    case CK_AWAIT_MESSAGE:
        if (!t) return 0;
        if (args[0] <= 0) return 0;
        t->ck_wake = __time() + args[0];
        t->state = TS_SLEEPING;
        return 0;

    case CK_USER_SIGNAL:         return ck_signal(t, args[0], args[1]);
    case CK_USER_KILL:           return ck_kill(args[0], args[1]);

    case CK_USER_START_C4R:      return ck_start_c4r(t, args);

    // Byte for byte the SYS_WAIT in-trap path: park, and task_zombify
    // completes the wait, writing the exit code into sv_a -- which is
    // the accumulator this opcode returns in.
    case CK_AWAIT_PID:
        if (!t) return -1;
        if (!(s = task_get(args[0]))) {
            // Swept by the idle reaper before we asked; its status
            // outlived it.
            if (task_ghost(args[0], &code)) return code;
            return -1;
        }
        if (s->state == TS_ZOMBIE) {
            code = s->exitcode;
            task_release(s);
            return code;
        }
        t->wait_for = s->id;
        t->wait_posix = 0;
        t->state = TS_WAITING;
        return 0;

    // the kernel RAM filesystem (vfs.c): C4KE's argument order, name first
    case CK_VFS_PUT:             return vfs_put((char *)args[0], (char *)args[1], args[2]);
    case CK_VFS_GET:             return (int)vfs_getdata((char *)args[0], (int *)args[1]);
    case CK_VFS_UNLINK:          return vfs_unlink((char *)args[0]);
    case CK_VFS_COUNT:           return vfs_nfiles();
    case CK_VFS_NAME:            return (int)vfs_fname(args[0]);
    case CK_KERN_TASKS_EXPORT:   return ck_export();
    case CK_KERN_TASKS_EXPORT_UPDATE:
        if (args[0]) ck_export_fill((int *)args[0]);
        return 0;
    case CK_KERN_TASKS_EXPORT_FREE:
        ck_export_free((int *)args[0]);
        return 0;
    }

    kprintf("c4ix: c4ke: task %d used unimplemented service %d\n",
        t ? t->id : -1, num);
    return -1;
}
src/c4ix/loader.c 27429
//
// C4IX .c4r loader: read an image from the RAM filesystem or the host,
// relocate it, and hand back an entry address -- the in-kernel port of c4l.c's
// parser. No invoke-stub gymnastics here: the kernel is c4lc code,
// so calling loaded code is an ordinary indirect call.
//
// task_spawn wraps it into the task machinery: the entry becomes a
// task through the normal shim, and the image segments are freed when
// the task is reaped. Constructors and destructors are resolved here
// but RUN BY THE TASK, in task_shim -- this function executes in the
// spawning task's context, and a constructor that asks who it is must
// not be told the parent.
//
// Shared libraries. An image linked with `c4rlink -l LIB` still holds
// symbol patches -- references to what LIB defines -- and a static
// global named __c4_needed for each library, whose value is the data
// offset of its run-time path ("/lib/libc4ix.c4s"). The loader reads
// the image, then every library it needs (and every library THOSE
// need, each once), and resolves each module's symbol patches against
// what the libraries export: their non-static functions and globals.
// Each task gets its own copy of every library's DATA, freed with the
// task -- a library's globals, errno and stdio buffers among them,
// belong to the task that uses them. Its CODE is shared when the
// library was compiled -fpic: c4lc then reaches every datum through
// __c4_dbase, a word the loader gives that library and the scheduler
// sets to the running task's copy of its data at every switch
// (loader_switch). The first task to load such a library leaves its
// relocated code in a cache, with the file as the template every later
// task's data copy is made from, so the second task loads a library
// without reading or relocating its code. A library built without
// -fpic is loaded whole, code and all, for every task. Library
// constructors run before the program's, deepest library first.
//

#include "c4ix.h"

enum { C4R_BUF_MAX = 4194304,     // 4MB image limit
       LIB_MAX = 8,               // libraries one program may load, in all
       SCLASS_FUN = 129, SCLASS_GLO = 131, SATTR_STATIC = 8, SATTR_EXTERN = 16 };

// Set while a caller is TRYING candidate paths and a miss is expected
// -- a bare C4KE program name may match a real file that is not an
// image at all. Complaints about those are noise, not diagnosis.
int loader_quiet;

// One image, read and relocated, with its file still at hand: the
// symbol patches and the symbol table are read out of it in place.
struct c4r_mod {
    char *buf;
    int *code;
    char *data;
    int entry;
    char *patches; int npatch;    // the patch section, in buf
    char *syms; int nsym;         // the symbol section, in buf
    int *cons; int ncons;         // constructor offsets, in buf
    int *des; int ndes;           // destructor offsets, in buf
    char *path;                   // a library's run-time path, for messages
    char *dtmpl;                  // the data as the file has it, in buf
    int datalen, memsz;
    int pic;                      // -fpic: refers to __c4_dbase
    int codelen;                  // code words
    int shared;                   // its code is the cache's: neither relink nor free it
    int *slot;                    // pic: the word that holds the task's data base
    int buflen;                   // bytes in buf: the file as read
};

// -fpic libraries, loaded once: the first task's mod, kept, by path
struct shlib {
    char path[96];
    struct c4r_mod *mod;
    struct shlib *next;
};
static struct shlib *shlibs;

static int loader_word(char *p) {
    return *(int *)p;
}

static int loader_nameis(char *p, int len, char *want) {
    int i;
    i = 0;
    while (i < len) {
        if (!want[i]) return 0;
        if (p[i] != want[i]) return 0;
        ++i;
    }
    return want[i] == 0;
}

// A symbol record (load-c4r.c): id, type, class and attrs as words,
// then a 1-byte name length, the name, then the value word.
static int sym_class(char *p) { return loader_word(p + 2 * sizeof(int)); }
static int sym_attrs(char *p) { return loader_word(p + 3 * sizeof(int)); }
static int sym_namelen(char *p) { return p[4 * sizeof(int)] & 255; }
static char *sym_name(char *p) { return p + 4 * sizeof(int) + 1; }
static int sym_value(char *p) { return loader_word(p + 4 * sizeof(int) + 1 + sym_namelen(p)); }
static char *sym_next(char *p) { return p + 5 * sizeof(int) + 1 + sym_namelen(p); }

static void mod_data_relocate(struct c4r_mod *m, char *d);

// does M's symbol table name NAME (defined or not)?
static int mod_has(struct c4r_mod *m, char *name) {
    char *p;
    int i;
    p = m->syms;
    i = 0;
    while (i < m->nsym) {
        if (loader_nameis(sym_name(p), sym_namelen(p), name)) return 1;
        p = sym_next(p);
        ++i;
    }
    return 0;
}

static void mod_free(struct c4r_mod *m) {
    if (m->shared) { if (m->data) free(m->data); m->data = 0; m->code = 0; m->buf = 0; return; }
    if (m->code) free(m->code);
    if (m->data) free(m->data);
    if (m->buf) free(m->buf);
    m->code = 0; m->data = 0; m->buf = 0;
}

// Read and relocate one image. Returns 1 and fills M; its buf stays
// allocated until the caller has linked it.
static int mod_read(char *path, struct c4r_mod *m) {
    char *buf, *p, *data;
    int *code;
    int fd, n, total, got;
    int entry, codelen, datalen, patchlen, symlen, conslen, deslen, memsz;
    int i, ptype, paddr, pvalu;
    struct vnode *vn;

    memset((char *)m, 0, sizeof(struct c4r_mod));
    buf = 0;
    // A RAM file by this path wins over the host. The comment below once
    // said the two could not name the same file, but a host is free to
    // answer a path it does not have -- c4bb's disk tries the bare file
    // name when the full path misses -- so "/tmp/hello.c4r", compiled a
    // moment ago, ran the disk's own hello.c4r instead.
    vn = vfs_lookup(path);
    if (vn && vn->type != VN_RAMFILE) vn = 0;
    if (!vn && (fd = open(path, 0)) >= 0) {
        // The host says nothing of a file's size, so it is read twice:
        // a chunk at a time to count it, then into a buffer just that
        // size. A cached -fpic library keeps its file for as long as the
        // machine runs, as the template of every task's copy of its
        // data, and the 4 MB buffer each load used to keep was a third of
        // the heap. Reading into 4 MB and copying out was no better: the
        // copy, made while the 4 MB was held, landed past it, and a full
        // build left a heap of 4 MB holes too cut up to load the next
        // program into, until b4ke's allocations failed.
        if (!(buf = (char *)malloc(65536))) { close(fd); return 0; }
        total = 0;
        // never far past the limit: a host file of any size can be named
        while (total <= C4R_BUF_MAX && (n = read(fd, buf, 65536)) > 0) total = total + n;
        close(fd);
        free(buf);
        buf = 0;
        if (total > C4R_BUF_MAX) {
            kprintf("c4ix: loader: %s is over the %d-byte limit\n", path, C4R_BUF_MAX);
            return 0;
        }
        if (total <= 0 || !(buf = (char *)malloc(total + 16))) return 0;
        if ((fd = open(path, 0)) < 0) { free(buf); return 0; }
        got = 0;
        while (got < total && (n = read(fd, buf + got, total - got < 65536 ? total - got : 65536)) > 0)
            got = got + n;
        close(fd);
        total = got;
    } else {
        if (!vn) {
            // Silent: callers try several candidate names (the shell
            // resolves "wc" against three), so a miss is routine and
            // the caller is the one that knows when to complain.
            return 0;
        }
        // The RAM filesystem -- and this is not a convenience. A program the machine produced
        // ITSELF cannot be on the host: the C4 VM has no write syscall,
        // so nothing running under it can put a file there. What a
        // compiler running as a task CAN do is write to standard output
        // and let the shell redirect that into a RAM file, so
        // `c4th.c4r ... > /tmp/prog.c4r` and then `/tmp/prog.c4r` is
        // the whole compile-and-run loop, and this is what joins the
        // two halves. Without it the kernel can only ever run programs
        // that were built somewhere else.
        if (vn->lazy) vfs_fill(vn);
        total = vn->size;
        if (total > C4R_BUF_MAX) {
            kprintf("c4ix: loader: %s is %d bytes, over the %d limit\n",
                    path, total, C4R_BUF_MAX);
            return 0;
        }
        if (!(buf = (char *)malloc(total + 16))) return 0;
        memcpy(buf, vn->data, total);
    }
    if (total < 13) {
        if (!loader_quiet) kprintf("c4ix: loader: %s is not a .c4r\n", path);
        free(buf); return 0;
    }

    p = buf;
    if (!(p[0] == 'C' && p[1] == '4' && p[2] == 'R')) {
        if (!loader_quiet) kprintf("c4ix: loader: bad signature in %s\n", path);
        free(buf);
        return 0;
    }
    if (p[4] / 8 != sizeof(int)) {
        kprintf("c4ix: loader: %d-bit image, host is %d-bit\n", p[4], sizeof(int) * 8);
        free(buf);
        return 0;
    }
    // padding word (byte 5) = data MEMSZ in v3 (total in-memory size,
    // excess over datalen is zero-filled BSS); v2 has none.
    memsz = (p[3] >= 3) ? loader_word(p + 5) : 0;
    p = p + 13;   // signature, version, wordbits, padding

    entry    = loader_word(p); p = p + sizeof(int);
    codelen  = loader_word(p); p = p + sizeof(int);
    datalen  = loader_word(p); p = p + sizeof(int);
    patchlen = loader_word(p); p = p + sizeof(int);
    symlen   = loader_word(p); p = p + sizeof(int);
    conslen  = loader_word(p); p = p + sizeof(int);
    deslen   = loader_word(p); p = p + sizeof(int);
    if (memsz < datalen) memsz = datalen;

    // code: copy out of the read buffer into an exact-size allocation
    p = p + sizeof(int);   // 'C' marker word
    if (!(code = (int *)malloc(codelen * sizeof(int) + sizeof(int)))) { free(buf); return 0; }
    memcpy(code, p, codelen * sizeof(int));
    p = p + codelen * sizeof(int);

    // data: allocate the full in-memory size (memsz), zero-padded by
    // malloc+memset so the BSS tail [datalen, memsz) is ready; only
    // datalen bytes are copied from the image.
    p = p + sizeof(int);   // 'D' marker
    if (!(data = (char *)malloc(memsz + 8))) { free(code); free(buf); return 0; }
    memset(data, 0, memsz + 8);
    memcpy(data, p, datalen);
    m->dtmpl = p;
    p = p + datalen;

    // patches: byte-offset address rewrites into the fresh segments;
    // the symbol references among them wait for link_modules
    p = p + sizeof(int);   // 'P' marker
    m->patches = p;
    m->npatch = patchlen;
    p = p + patchlen * 3 * sizeof(int);

    // Constructor and destructor lists ('c' and 'd' markers), then
    // the symbol section ('S'). They point INTO buf.
    p = p + sizeof(int);   // 'c' marker
    m->cons = (int *)p;
    m->ncons = conslen;
    p = p + conslen * sizeof(int);
    p = p + sizeof(int);   // 'd' marker
    m->des = (int *)p;
    m->ndes = deslen;
    p = p + deslen * sizeof(int);
    p = p + sizeof(int);   // 'S' marker
    m->syms = p;
    m->nsym = symlen;

    m->buf = buf;
    m->buflen = total;
    m->code = code;
    m->data = data;
    m->entry = entry;
    m->codelen = codelen;
    m->datalen = datalen;
    m->memsz = memsz;
    m->pic = mod_has(m, "__c4_dbase");

    // relocate the code; under -fpic a code word that points into the
    // data holds the OFFSET, since __c4_dbase supplies the base
    p = m->patches;
    i = 0;
    while (i < patchlen) {
        ptype = loader_word(p); paddr = loader_word(p + sizeof(int)); pvalu = loader_word(p + 2 * sizeof(int));
        p = p + 3 * sizeof(int);
        if (ptype == -1) code[paddr] = (int)(code + pvalu);
        else if (ptype == -2) code[paddr] = m->pic ? pvalu : (int)(data + pvalu);
        ++i;
    }
    mod_data_relocate(m, data);
    return 1;
}

// The data-resident patches, applied to a copy D of M's data.
static void mod_data_relocate(struct c4r_mod *m, char *d) {
    char *p;
    int i, ptype, paddr, pvalu;
    p = m->patches;
    i = 0;
    while (i < m->npatch) {
        ptype = loader_word(p); paddr = loader_word(p + sizeof(int)); pvalu = loader_word(p + 2 * sizeof(int));
        p = p + 3 * sizeof(int);
        if (ptype == -3) *(int *)(d + paddr) = (int)(m->code + pvalu);
        else if (ptype == -4) *(int *)(d + paddr) = (int)(d + pvalu);
        ++i;
    }
}

// A fresh copy of a cached library's data, for one more task.
static char *mod_data_copy(struct c4r_mod *m) {
    char *d;
    if (!(d = (char *)malloc(m->memsz + 8))) return 0;
    memset(d, 0, m->memsz + 8);
    memcpy(d, m->dtmpl, m->datalen);
    mod_data_relocate(m, d);
    return d;
}

// The symbol with id ID in M (the linker writes ids in order, so it is
// usually the ID'th), or 0.
static char *mod_symbol(struct c4r_mod *m, int id) {
    char *p;
    int i;
    p = m->syms;
    i = 0;
    while (i < m->nsym) {
        if (loader_word(p) == id) return p;
        p = sym_next(p);
        ++i;
    }
    return 0;
}

// What M exports by NAME: the address of a non-static function or
// global it defines, or 0.
static int mod_export(struct c4r_mod *m, char *name, int len) {
    char *p;
    int i, c;
    p = m->syms;
    i = 0;
    while (i < m->nsym) {
        c = sym_class(p);
        if (sym_namelen(p) == len && !(sym_attrs(p) & (SATTR_STATIC | SATTR_EXTERN)) &&
            (c == SCLASS_FUN || c == SCLASS_GLO) && !memcmp(sym_name(p), name, len)) {
            if (c == SCLASS_FUN) return (int)(m->code + sym_value(p));
            return (int)(m->data + sym_value(p));
        }
        p = sym_next(p);
        ++i;
    }
    return 0;
}

static int str_eq(char *a, char *b) {
    while (*a && *a == *b) { ++a; ++b; }
    return *a == *b;
}

// Load every library the modules need, breadth first, each once.
// Returns the module count, or 0 having said why.
// the cached -fpic library with this run-time path, or 0
static struct shlib *shlib_find(char *path) {
    struct shlib *s;
    s = shlibs;
    while (s) { if (str_eq(s->path, path)) return s; s = s->next; }
    return 0;
}

static int load_libraries(char *path, struct c4r_mod *mods) {
    int n, k, i, j, have;
    char *p, *lib;
    struct shlib *sh;
    n = 1;
    k = 0;
    while (k < n) {
        p = (mods + k)->syms;
        i = 0;
        while (i < (mods + k)->nsym) {
            if (loader_nameis(sym_name(p), sym_namelen(p), "__c4_needed") && sym_class(p) == SCLASS_GLO) {
                lib = (mods + k)->data + sym_value(p);
                have = 0;
                j = 1;
                while (j < n) { if (str_eq((mods + j)->path, lib)) have = 1; ++j; }
                if (!have) {
                    if (n > LIB_MAX) {
                        kprintf("c4ix: loader: %s needs more than %d libraries\n", path, LIB_MAX);
                        return 0;
                    }
                    // /lib/NAME in the VFS, or else NAME on the host: a
                    // native host's own /lib is not C4IX's, and the
                    // build leaves its libraries beside its programs
                    j = 0;
                    while (lib[j]) ++j;
                    while (j > 0 && lib[j - 1] != '/') --j;
                    if ((sh = shlib_find(lib))) {
                        // shared code already loaded: only the data is new
                        memcpy((char *)(mods + n), (char *)sh->mod, sizeof(struct c4r_mod));
                        (mods + n)->shared = 1;
                        have = ((mods + n)->data = mod_data_copy(sh->mod)) != 0;
                    } else {
                        loader_quiet = loader_quiet + 1;
                        have = mod_read(lib, mods + n) || mod_read(lib + j, mods + n);
                        loader_quiet = loader_quiet - 1;
                    }
                    if (!have) {
                        kprintf("c4ix: loader: %s needs %s, which is not there\n", path, lib);
                        return 0;
                    }
                    (mods + n)->path = lib;
                    ++n;
                }
            }
            p = sym_next(p);
            ++i;
        }
        ++k;
    }
    return n;
}

static int mod_is_data(struct c4r_mod *m, int addr);

// the id of the symbol named NAME in M, or -1
static int mod_symid(struct c4r_mod *m, char *name) {
    char *p;
    int i;
    p = m->syms;
    i = 0;
    while (i < m->nsym) {
        if (loader_nameis(sym_name(p), sym_namelen(p), name)) return loader_word(p);
        p = sym_next(p);
        ++i;
    }
    return -1;
}

// Resolve every module's symbol patches against what the libraries
// export. Returns 1, or 0 having named what was missing.
static int link_modules(char *path, struct c4r_mod *mods, int n) {
    struct c4r_mod *m;
    char *p, *s;
    char name[128];
    int k, i, j, ptype, paddr, addr, bad, len, dbid;
    bad = 0;
    k = 0;
    while (k < n) {
        m = mods + k;
        ++k;
        if (m->shared) continue;            // linked once, when it was first loaded
        if (m->pic && !m->slot) {
            if (k == 1) { kprintf("c4ix: loader: %s: a program cannot be -fpic\n", path); return 0; }
            // Under SMP the slot is a word of the CPU-local window: two
            // CPUs run two tasks' copies of the library's data at once
            if (smp_ncpu > 1) {
                if (!(m->slot = (int *)smp_slot_alloc())) {
                    kprintf("c4ix: loader: %s: no slot left for another shared library\n", m->path);
                    return 0;
                }
            } else m->slot = (int *)malloc(sizeof(int));
            *m->slot = (int)m->data;
        }
        // __c4_dbase is most of a -fpic library's symbol references (one
        // per function that touches data): find its id once, not per patch
        dbid = m->pic ? mod_symid(m, "__c4_dbase") : -1;
        p = m->patches;
        i = 0;
        while (i < m->npatch) {
            ptype = loader_word(p); paddr = loader_word(p + sizeof(int));
            p = p + 3 * sizeof(int);
            ++i;
            if (ptype < 0) continue;
            if (ptype == dbid) { m->code[paddr] = (int)m->slot; continue; }
            if (!(s = mod_symbol(m, ptype))) {
                kprintf("c4ix: loader: %s: a patch names symbol %d, which is not in its table\n", k > 1 ? m->path : path, ptype);
                bad = 1;
                continue;
            }
            if (m->pic && loader_nameis(sym_name(s), sym_namelen(s), "__c4_dbase")) {
                m->code[paddr] = (int)m->slot;
                continue;
            }
            addr = 0;
            j = 1;
            while (j < n && !addr) {
                if (j != k - 1) {
                    addr = mod_export(mods + j, sym_name(s), sym_namelen(s));
                    // shared code may only point at what every task shares
                    if (addr && m->pic && (!(mods + j)->pic || mod_is_data(mods + j, addr))) {
                        kprintf("c4ix: loader: %s is -fpic, but uses '%s' from %s, which is not shared code\n",
                                m->path, "a global", (mods + j)->path);
                        bad = 1;
                    }
                }
                ++j;
            }
            if (!addr) {
                // the name is not NUL-terminated in the file
                len = sym_namelen(s) < 127 ? sym_namelen(s) : 127;
                memcpy(name, sym_name(s), len);
                name[len] = 0;
                kprintf("c4ix: loader: %s needs '%s', which none of its libraries has\n",
                        k > 1 ? m->path : path, name);
                bad = 1;
                continue;
            }
            m->code[paddr] = addr;
        }
    }
    return !bad;
}

// is ADDR inside M's data?
static int mod_is_data(struct c4r_mod *m, int addr) {
    return addr >= (int)m->data && addr < (int)m->data + m->memsz + 8;
}

// A cached library keeps its file for as long as the machine runs, and
// reads it only up to the end of S. What can follow is the extension
// trailer (docs/c4-explorer.md 2.1), a source map that no loader reads
// and that can be as large as the rest: the part before it is copied
// out, and the whole file freed.
static void mod_trim(struct c4r_mod *m) {
    char *p, *nb, *ob;
    int i, keep;
    p = m->syms;
    i = 0;
    while (i < m->nsym) { p = sym_next(p); ++i; }
    ob = m->buf;
    keep = p - ob;
    if (keep >= m->buflen || !(nb = (char *)malloc(keep + 16))) return;
    memcpy(nb, ob, keep);
    m->dtmpl = nb + (m->dtmpl - ob);
    m->patches = nb + (m->patches - ob);
    m->cons = (int *)(nb + ((char *)m->cons - ob));
    m->des = (int *)(nb + ((char *)m->des - ob));
    m->syms = nb + (m->syms - ob);
    m->buf = nb;
    m->buflen = keep;
    free(ob);
}

// Load and relocate, with any libraries. Returns 1 and fills img on success.
int c4r_load(char *path, struct c4r_image *img) {
    struct c4r_mod *mods;
    struct shlib *sh;
    int n, k, i, ncons, ndes, total;
    int *cons, *des, *libs;

    memset((char *)img, 0, sizeof(struct c4r_image));
    if (!(mods = (struct c4r_mod *)malloc((LIB_MAX + 1) * sizeof(struct c4r_mod)))) return 0;
    memset((char *)mods, 0, (LIB_MAX + 1) * sizeof(struct c4r_mod));
    if (!mod_read(path, mods)) { free(mods); return 0; }
    (mods + 0)->path = path;
    n = load_libraries(path, mods);
    if (n == 0 || !link_modules(path, mods, n)) {
        if (n == 0) n = LIB_MAX + 1;
        k = 0;
        while (k < n) { if ((mods + k)->buf) mod_free(mods + k); ++k; }
        free(mods);
        return 0;
    }

    // Constructors and destructors, as absolute addresses for the task
    // to run itself: the deepest library first, the program last. The
    // destructors are run in reverse, so the program's go first.
    ncons = 0; ndes = 0;
    k = 0;
    while (k < n) { ncons = ncons + (mods + k)->ncons; ndes = ndes + (mods + k)->ndes; ++k; }
    cons = 0; des = 0;
    if (ncons) cons = (int *)malloc(ncons * sizeof(int));
    if (ndes) des = (int *)malloc(ndes * sizeof(int));
    total = 0;
    k = n - 1;
    while (k >= 0) {
        i = 0;
        while (i < (mods + k)->ncons) { cons[total++] = (int)((mods + k)->code + (mods + k)->cons[i]); ++i; }
        --k;
    }
    total = 0;
    k = n - 1;
    while (k >= 0) {
        i = 0;
        while (i < (mods + k)->ndes) { des[total++] = (int)((mods + k)->code + (mods + k)->des[i]); ++i; }
        --k;
    }

    // a -fpic library loaded for the first time stays, code and file,
    // for the next task that needs it
    k = 1;
    while (k < n) {
        if ((mods + k)->pic && !(mods + k)->shared) {
            sh = (struct shlib *)malloc(sizeof(struct shlib));
            sh->mod = (struct c4r_mod *)malloc(sizeof(struct c4r_mod));
            memcpy((char *)sh->mod, (char *)(mods + k), sizeof(struct c4r_mod));
            sh->mod->data = 0;
            mod_trim(sh->mod);
            i = 0;
            while ((mods + k)->path[i] && i < 95) { sh->path[i] = (mods + k)->path[i]; ++i; }
            sh->path[i] = 0;
            sh->next = shlibs;
            shlibs = sh;
            (mods + k)->shared = 1;
        }
        ++k;
    }

    // the libraries, for the task: code to free (0 when shared), its own
    // data, and the slot the scheduler points at that data (0 if none)
    libs = 0;
    if (n > 1) {
        libs = (int *)malloc(3 * (n - 1) * sizeof(int));
        k = 1;
        while (k < n) {
            libs[3 * (k - 1)] = (mods + k)->shared ? 0 : (int)(mods + k)->code;
            libs[3 * (k - 1) + 1] = (int)(mods + k)->data;
            libs[3 * (k - 1) + 2] = (int)(mods + k)->slot;
            ++k;
        }
    }

    img->code = (int)(mods + 0)->code;
    img->data = (int)(mods + 0)->data;
    img->entry = (int)((mods + 0)->code + (mods + 0)->entry);
    img->cons = (int)cons;
    img->ncons = ncons;
    img->des = (int)des;
    img->ndes = ndes;
    img->libs = (int)libs;
    img->nlibs = n - 1;
    // What the task holds, as the heap counts it: each segment, the lists
    // and its share of the libraries -- their data; shared code is the
    // cache's, every task's at once
    img->bytes = (ncons + ndes + 3 * (n - 1)) * sizeof(int);
    k = 0;
    while (k < n) {
        if (!(mods + k)->shared) img->bytes = img->bytes + ((mods + k)->codelen + 1) * sizeof(int);
        img->bytes = img->bytes + (mods + k)->memsz + 8;
        ++k;
    }
    k = 0;
    while (k < n) { if (!(mods + k)->shared) free((mods + k)->buf); ++k; }
    free(mods);
    return 1;
}

// The running task changes: point each shared library's __c4_dbase at
// the incoming task's copy of its data. The scheduler calls this at
// every switch; a task that uses no -fpic library costs one test.
void loader_switch(struct task *t) {
    int *l;
    int k;
    if (!t || !t->img_libs) return;
    l = (int *)t->img_libs;
    k = 0;
    while (k < t->img_nlibs) {
        if (l[3 * k + 2]) *(int *)l[3 * k + 2] = l[3 * k + 1];
        ++k;
    }
}

// Load an image and run it as a task. argv is passed through to the
// image's main untouched. Spawned programs are userland, and run
// behind the protected-mode boundary.
struct task *task_spawn_priv(char *path, int argc, int argv, int privs) {
    struct c4r_image img;
    struct task *t;
    char *name;
    int i;

    if (!c4r_load(path, &img)) return 0;
    // The task is named for the program, not the path it was found by:
    // ps says "spin" whether the shell ran /bin/spin or a host image.
    name = path;
    i = 0;
    while (path[i]) { if (path[i] == '/') name = path + i + 1; ++i; }
    // task_create puts the task on the run list, so until it has its
    // image and its privilege nothing may run: a kernel caller (init) can
    // be preempted here, and the child then ran unprotected, every printf
    // the host's own instead of a syscall
    sched_lock();
    if (!(t = task_create(name, img.entry, argc, argv))) {
        sched_unlock();
        c4r_unload(&img);
        return 0;
    }
    t->img_code = img.code;
    t->img_data = img.data;
    t->img_cons = img.cons;
    t->img_ncons = img.ncons;
    t->img_des = img.des;
    t->img_ndes = img.ndes;
    t->img_libs = img.libs;
    t->img_nlibs = img.nlibs;
    t->img_bytes = img.bytes;
    t->privs = privs;
    // the CPUs it may run on are its parent's (pin)
    if (sched_cur && !sched_cur->cpuidle) { t->cpumask = sched_cur->cpumask; t->nice = sched_cur->nice; }
    sched_unlock();
    return t;
}

// Free what c4r_load allocated: the image, its libraries, the lists.
void c4r_unload(struct c4r_image *img) {
    int k;
    if (img->code) free((int *)img->code);
    if (img->data) free((char *)img->data);
    if (img->cons) free((int *)img->cons);
    if (img->des) free((int *)img->des);
    if (img->libs) {
        k = 0;
        while (k < img->nlibs) {
            if (((int *)img->libs)[3 * k]) free((int *)((int *)img->libs)[3 * k]);
            free((char *)((int *)img->libs)[3 * k + 1]);
            ++k;
        }
        free((int *)img->libs);
    }
    memset((char *)img, 0, sizeof(struct c4r_image));
}

struct task *task_spawn(char *path, int argc, int argv) {
    return task_spawn_priv(path, argc, argv, PRIV_USER);
}
src/c4ix/init.c 15742
//
// C4IX init: the first task, and the kernel's command line.
//
// With no arguments it boots to a shell, because that is what anyone
// running this actually wants; `--demo` asks for the guided tour and
// `--help` lists the rest. init_usage() is the authority on all of
// it -- keep the two in step.
//
// The tour has three acts:
//   1. Cooperative ping/pong -- two tasks yielding explicitly. Runs
//      under sched_lock so the interleaving is pure round-robin on
//      both hosts and the output pins exactly.
//   2. Preemption proof (c4m only) -- two busy tasks that never
//      yield, each sampling the other's progress counter halfway
//      through its own loop. Only preemption can interleave them, so
//      "saw the other side mid-run" is the boolean that gets printed
//      -- no interleaving-sensitive output, the pin survives codegen
//      changes shifting cycle counts.
//   3. Spawn -- load a .c4r from the host filesystem (kernel argv[1]
//      if present), run it as a task, wait for its exit code.
//

#include "c4ix.h"

static int pp_rounds;

static int ping_task(int argc, int argv) {
    int i;
    // Masked, so the only switch is the yield: the mask is each task's
    // own (sched.c), and init's does not reach this one -- unmasked, a
    // preemption tick landing between the print and the yield reordered
    // the lines, as code anywhere moved the cycle counts.
    sched_lock();
    i = 0;
    while (i < argc) {
        kprintf("ping %d\n", i);
        sched_yield();
        ++i;
    }
    sched_unlock();
    return 100 + argc;
}

static int pong_task(int argc, int argv) {
    int i;
    // Masked, so the only switch is the yield: the mask is each task's
    // own (sched.c), and init's does not reach this one -- unmasked, a
    // preemption tick landing between the print and the yield reordered
    // the lines, as code anywhere moved the cycle counts.
    sched_lock();
    i = 0;
    while (i < argc) {
        kprintf("pong %d\n", i);
        sched_yield();
        ++i;
    }
    sched_unlock();
    return 200 + argc;
}

// busy tasks: no yields, just work and one mid-run sample of the
// other side's progress
static int busy_a_n;
static int busy_b_n;
static int busy_a_saw;
static int busy_b_saw;

enum { BUSY_SPIN = 60000 };

static int busy_a(int argc, int argv) {
    int i;
    i = 0;
    while (i < BUSY_SPIN) {
        busy_a_n = busy_a_n + 1;
        if (i == BUSY_SPIN / 2) busy_a_saw = busy_b_n;
        ++i;
    }
    return 0;
}

static int busy_b(int argc, int argv) {
    int i;
    i = 0;
    while (i < BUSY_SPIN) {
        busy_b_n = busy_b_n + 1;
        if (i == BUSY_SPIN / 2) busy_b_saw = busy_a_n;
        ++i;
    }
    return 0;
}

// ---- X3: the IO layer, doing a shell's job by hand ----

// A RAM file is ordinary storage behind the same fd calls: open it,
// write it, close it, open it again and read it back.
static void io_ramfile() {
    char buf[64];
    int fd, n;

    if ((fd = sys_open("/tmp/note", C4IX_O_WRONLY + C4IX_O_CREAT)) < 0) {
        kputs("init: cannot create /tmp/note\n");
        return;
    }
    sys_write(fd, "written to a ram file\n", 22);
    sys_close(fd);

    if ((fd = sys_open("/tmp/note", C4IX_O_RDONLY)) < 0) {
        kputs("init: cannot reopen /tmp/note\n");
        return;
    }
    n = sys_read(fd, buf, 64);
    sys_close(fd);
    kprintf("init: read %d bytes back: ", n);
    sys_write(FD_STDOUT, buf, n);
}

// Redirection, exactly as a shell does it and with no fork in sight:
// point our own fd 1 at a file, spawn, then put fd 1 back. The child
// inherits the table, so its output lands in the file -- and the
// child here is c4ix-hello.c4r, which calls printf directly and has
// never heard of C4IX. Under protected mode that printf traps and
// the kernel writes it wherever fd 1 now points.
static void io_redirect(char *prog) {
    struct task *t;
    int fd, saved;

    if ((fd = sys_open("/tmp/out", C4IX_O_WRONLY + C4IX_O_CREAT + C4IX_O_TRUNC)) < 0) {
        kputs("init: cannot create /tmp/out\n");
        return;
    }
    // Announce this BEFORE the redirection, not after. From here until
    // the child exits, everything it prints goes into the file -- so
    // if the caller's program list is short enough that something
    // interactive lands in this slot, the terminal falls silent with
    // no explanation and looks hung. It is not hung; the child is
    // waiting to be typed at, and its prompt went into /tmp/out.
    kprintf("init: running '%s' with fd 1 redirected into /tmp/out\n", prog);
    saved = sys_dup(FD_STDOUT);
    sys_dup2(fd, FD_STDOUT);
    t = task_spawn(prog, 1, 0);
    sys_dup2(saved, FD_STDOUT);      // restore before anything prints
    sys_close(saved);
    sys_close(fd);
    if (!t) { kprintf("init: spawn of '%s' failed\n", prog); return; }
    task_wait(t);

    kprintf("init: '%s' ran with fd 1 redirected; /tmp/out holds %d bytes:\n",
        prog, vfs_size("/tmp/out"));
    vfs_dump("/tmp/out");
    // Without protected mode a raw printf never reaches the kernel,
    // so there is nothing to redirect. Saying so beats an empty file
    // that looks like a bug.
    if (vfs_size("/tmp/out") == 0)
        kputs("init: (empty: this host has no protected mode, so a raw printf bypasses fd 1)\n");
}

// A pipeline: writer's fd 1 and reader's fd 0 are the two ends of
// one pipe. The reader blocks on the empty pipe until the writer
// produces -- and its read syscall is restarted, not resumed.
static void io_pipeline(char *wprog, char *rprog) {
    struct task *w, *r;
    int p[2], saved_out, saved_in;
    char *wargv[4];

    if (sys_pipe(p) < 0) { kputs("init: pipe failed\n"); return; }

    wargv[0] = wprog;
    wargv[1] = "piped";
    wargv[2] = "through";
    wargv[3] = 0;

    saved_out = sys_dup(FD_STDOUT);
    sys_dup2(p[1], FD_STDOUT);
    w = task_spawn(wprog, 3, (int)wargv);
    sys_dup2(saved_out, FD_STDOUT);
    sys_close(saved_out);

    // The write end must be gone from OUR table before the reader is
    // spawned, or the reader inherits a copy of it and then waits
    // forever for an end of file it is itself holding open. Every
    // shell has this bug once.
    sys_close(p[1]);

    saved_in = sys_dup(FD_STDIN);
    sys_dup2(p[0], FD_STDIN);
    r = task_spawn(rprog, 1, 0);
    sys_dup2(saved_in, FD_STDIN);
    sys_close(saved_in);
    sys_close(p[0]);

    if (!w || !r) { kputs("init: pipeline spawn failed\n"); return; }
    task_wait(w);
    task_wait(r);
}

// X4: hand the whole job over to a shell. init stops being the thing
// that wires up pipes and redirections by hand -- it just starts
// c4ix-sh on a script, and the shell does all of it through
// syscalls, from userland, behind protected mode.
static void init_shell(char *shell, char *script) {
    struct task *t;
    char *sargv[3];

    sargv[0] = shell;
    sargv[1] = script;
    sargv[2] = 0;

    kprintf("init: --- X4: handing off to %s %s ---\n", shell, script);
    if (!(t = task_spawn(shell, 2, (int)sargv))) {
        kprintf("init: cannot start %s\n", shell);
        return;
    }
    kprintf("init: shell exited %d after %d syscalls\n",
        task_wait(t), task_last_syscalls);
}

static void init_io(char **av, int argc) {
    kputs("init: --- X3: files, redirection, pipes ---\n");
    io_ramfile();
    if (argc > 1) io_redirect(av[1]);
    if (argc > 4) io_pipeline(av[3], av[4]);
    if (argc > 6) init_shell(av[5], av[6]);
}

// Exact match, because the options are words rather than clusters of
// letters and a prefix match would quietly accept nonsense.
static int init_is(char *s, char *opt) {
    while (*s) {
        if (*s != *opt) return 0;
        ++s;
        ++opt;
    }
    return *opt == 0;
}

// The demonstrations used to be what you got for asking for nothing,
// which had the common case behind the uncommon one -- and worse, the
// demonstrations take their programs POSITIONALLY, so a short list
// put whatever you named into every role in turn. Booting to a shell
// now needs no arguments at all, and the tour is behind --demo.
static void init_usage() {
    kputs("c4ix -- a small Unix-like kernel for the C4 virtual machine\n"
          "\n"
          "usage: c4ix.c4r [OPTION] [PROGRAM [ARGUMENT]...]\n"
          "\n"
          "  (no arguments)     boot to an interactive shell\n"
          "  PROGRAM [ARG]...   boot, run PROGRAM with ARGs, shut down\n"
          "  --demo IMAGE...    run the built-in demonstrations, below\n"
          "  -h, --help         print this and shut down\n"
          "  -q                 accepted and ignored, so older command\n"
          "                     lines keep working\n"
          "\n"
          "PROGRAM is an image path as the host filesystem sees it. The\n"
          "SHELL expands a bare name to c4ix-NAME.c4r or NAME.c4r; init\n"
          "does not, so name the image in full here.\n"
          "\n"
          "--demo takes six images and uses each for a fixed role:\n"
          "  1  calls printf directly -- proves redirection reaches a\n"
          "     program that has never heard of C4IX\n"
          "  2  uses libc4ix syscalls\n"
          "  3  writer and 4 reader of a pipeline\n"
          "  5  a shell, and 6 a script for it to run\n"
          "Fewer than six still runs the stages it has arguments for,\n"
          "so a short list puts one image into several roles.\n"
          "\n"
          "  c4ix.c4r --demo c4ix-hello.c4r c4ix-uhello.c4r c4ix-echo.c4r \\\n"
          "           c4ix-wc.c4r c4ix-sh.c4r src/c4ix/user/test.sh\n"
          "\n"
          "  c4ix.c4r --desktop   the web page's boot: the root archive\n"
          "                       unpacks first, with a loading screen,\n"
          "                       then the shell runs \"desktop &\" and\n"
          "                       \"top\", as if they were typed\n"
          "  c4ix.c4r -e CMD      the shell runs CMD first, as if it were\n"
          "                       typed (up to four, after --desktop's own\n"
          "                       if both are given)\n");
}

// The guided tour. argc/av are shifted past --demo, so av[1] is the
// first image and every stage below indexes exactly as documented.
static int init_demo(int argc, char **av) {
    struct task *a, *b;
    int ra, rb, n;

    kprintf("init: c4ix init v1 on %s\n", host_name());

    // act 1: cooperative round-robin, preemption masked for an exact
    // interleaving pin
    sched_lock();
    pp_rounds = 3;
    a = task_create("ping", (int)&ping_task, pp_rounds, 0);
    b = task_create("pong", (int)&pong_task, pp_rounds, 0);
    kprintf("init: ping id %d, pong id %d, tasks %d\n", a->id, b->id, task_count());
    ra = task_wait(a);
    rb = task_wait(b);
    kprintf("init: ping exited %d, pong exited %d\n", ra, rb);
    sched_unlock();

    // act 2: preemption, by the cycle interrupt
    a = task_create("busy_a", (int)&busy_a, 0, 0);
    b = task_create("busy_b", (int)&busy_b, 0, 0);
    ra = task_wait(a);
    rb = task_wait(b);
    kprintf("init: busy done %d %d, preempted %d %d\n",
        busy_a_n == BUSY_SPIN, busy_b_n == BUSY_SPIN,
        busy_a_saw > 0, busy_b_saw > 0);

    // act 3: spawn programs from the host filesystem. Each runs as
    // userland -- behind protected mode where the host provides it --
    // so every one of their syscalls passes through sys.c, whether
    // the program asks through libc4ix or just calls printf.
    // Kernel argv: [1] a raw-printf program, [2] a libc4ix program,
    // [3] and [4] the two halves of the X3 pipeline. The first two
    // run standalone here; the rest are driven by init_io below.
    if (argc > 1) {
        n = 1;
        while (n < argc && n < 3) {
            if ((a = task_spawn(av[n], argc - n, (int)(av + n)))) {
                kprintf("init: spawned '%s' as task %d (%s)\n", a->name, a->id,
                    a->privs == PRIV_USER ? "protected" : "unprotected");
                ra = task_wait(a);
                kprintf("init: '%s' exited %d after %d syscalls\n",
                    av[n], ra, task_last_syscalls);
            } else {
                kprintf("init: spawn of '%s' failed\n", av[n]);
            }
            ++n;
        }
        init_io(av, argc);
    }

    return 0;
}

int init_main(int argc, int argv) {
    struct task *a, *v;
    char **av;
    char *shargv[16];
    char *vav[3];
    char *cmds[4];
    int i, desktop, shargc, ncmd, k;

    av = (char **)argv;
    i = 1;
    desktop = 0;
    ncmd = 0;

    if (i < argc) {
        if (init_is(av[i], "-h") || init_is(av[i], "--help")) {
            init_usage();
            return 0;
        }
        // Shift past the flag so the stages index from av[1] exactly
        // as the help text describes.
        if (init_is(av[i], "--demo")) return init_demo(argc - i, av + i);
        // -q used to mean "skip the demonstrations". They are opt-in
        // now, so it means nothing -- but silently accepting it keeps
        // older command lines and older habits working.
        if (init_is(av[i], "-q")) ++i;
        // --desktop (the browser's boot): the shell starts top in the
        // background on the console, then the desktop on the display,
        // as typing "top &" and "desktop" at the first prompt would
        if (i < argc && init_is(av[i], "--desktop")) { desktop = 1; ++i; }
        // -e CMD: the shell runs CMD as if it were typed (the web page's
        // "Wolfenstein 3D on C4IX" boots the console with -e "wolf3d --direct")
        while (i + 1 < argc && ncmd < 4 && init_is(av[i], "-e")) { cmds[ncmd++] = av[i + 1]; i += 2; }
    }

    // Nothing left to run: the default, and the reason the default is
    // worth having.
    if (i >= argc) {
        // Populate the VFS tree from c4ix.vfs.txt (if present on
        // disk) before the shell starts, so ls/cat show real content
        // from the first prompt. Not fatal if missing or it fails -
        // vfsload says why and the tree is simply left at defaults.
        // --desktop: vfsload waits for the root archive too, with the
        // loading screen on the display, so the desktop and top start
        // on a whole filesystem (and the console's boot lines can be read)
        vav[0] = "c4ix-vfsload.c4r";
        vav[1] = "-w";
        vav[2] = 0;
        if ((v = task_spawn(vav[0], desktop ? 2 : 1, (int)vav))) task_wait(v);
        con_booted();

        shargv[0] = "c4ix-sh.c4r";
        shargv[1] = 0;
        shargc = 1;
        // The desktop in the background and top in front, not the other
        // way round: the console's foreground job is the one its Ctrl-C
        // stops, and a person at the console wants top gone and the prompt
        // back -- not the desktop gone, with top still clearing the screen
        // over every command they type.
        // And persist keeps what changes, every minute, where the page
        // gave it a drive to keep it on (persist.c says nothing if not).
        if (desktop) {
            shargv[1] = "-e"; shargv[2] = "persist -d 60 &";
            shargv[3] = "-e"; shargv[4] = "desktop &"; shargv[5] = "-e"; shargv[6] = "top"; shargv[7] = 0;
            shargc = 7;
        }
        for (k = 0; k < ncmd; ++k) { shargv[shargc++] = "-e"; shargv[shargc++] = cmds[k]; }
        shargv[shargc] = 0;
        if (!(a = task_spawn(shargv[0], shargc, (int)shargv))) {
            kprintf("init: cannot start '%s'\n", shargv[0]);
            return 1;
        }
        task_wait(a);
        return 0;
    }

    con_booted();
    if (!(a = task_spawn(av[i], argc - i, (int)(av + i)))) {
        kprintf("init: spawn of '%s' failed\n", av[i]);
        return 1;
    }
    task_wait(a);
    return 0;
}
src/c4ix/c4ix.h 38032
//
// C4IX: kernel-wide declarations.
//
// Every module includes this and nothing else. c4lc preprocesses
// each module itself (its L9 preprocessor; no gcc -E in the build),
// so plain macros and quoted includes are available.
//

#ifndef __C4IX_H
#define __C4IX_H 1

// ---- host detection (host.c) ----
// __c4_info() bit values, mirroring c4m.c's C4I_* enum. boot.c refuses
// a host without C4IX_I_C4M. (Plain c4 has no INFO opcode at all -- the
// "returns 0" degraded signal was only true while c4.c carried extended
// opcodes, reverted in 29d6f57 -- so C4IX reaches plain c4 only through
// c4m: c4 -> c4m.c -> C4IX.)
enum {
    C4IX_I_C4   = 0x01,  // ultimately running under plain c4
    C4IX_I_C4M  = 0x02,  // running under c4m
    C4IX_I_HRT  = 0x10,  // high resolution timer
    C4IX_I_SIG  = 0x20,  // signals supported
    C4IX_I_FLT  = 0x40,  // floating point supported
    C4IX_I_PROT = 0x80,  // protected mode available
    C4IX_I_GUI  = 0x4000 // libjs's display is fitted (libjs/guest/gui.h)
};
// The display's ring register (libjs/gui-device.js): where the host
// writes events, into a task's memory. task.c reads it, and clears it
// when the memory goes with a task that never detached.
enum { C4IX_GUI_RING = 0x410 };
// The heap's extent and use (c4bb's HEAP_BASE and HEAP_END, libjs's
// HEAP_USED, src/c4bb/sim/devices.js), for the CPU snapshot.
enum { C4IX_HEAP_BASE = 0x144, C4IX_HEAP_END = 0x148, C4IX_HEAP_USED = 0x1c0, C4IX_I_C4MJS = 8 };
// Processors (docs/c4ix-smp.md S3): c4mp's C4I_SMP, which libjs reports
// with --cpus. Only libjs has the CPU-local window C4IX needs, 0x800 to
// 0x8FF, where each CPU sees 64 words of its own: its struct cpu at the
// bottom, the shared libraries' data slots above it (loader.c).
enum { C4IX_I_SMP = 0x100, CPU_MAX = 16, CPU_WINDOW = 0x800, CPU_SLOT0 = 24, CPU_SLOTS = 40 };
// libjs's: the CPUs run at once, a thread each, not in turns on one
enum { C4IX_I_PAR = 0x20000 };

// c4m trap machinery numbers (c4m.c enums), used by sched.c on the
// c4m host only.
enum { C4IX_CONF_INTERVAL = 0, C4IX_CONF_HANDLER = 1,
       // c4m's CONF_TRAP_RESTORES_INTERVAL: TLEV restores the interrupt
       // interval from the trap frame, so the mask survives the switch.
       C4IX_CONF_TRAP_RESTORES_INTERVAL = 3 };
enum {
    C4IX_TRAP_ILLOP = 0,        // unknown opcode: the syscall gateway
    C4IX_TRAP_HARD_IRQ = 1,     // cycle interrupt: preemption
    C4IX_TRAP_SOFT_IRQ = 2,     // __c4_trap: cooperative yield
    C4IX_TRAP_SIGNAL = 3,
    C4IX_TRAP_SEGV = 4,
    C4IX_TRAP_OPV = 5,
    C4IX_TRAP_PM = 6            // syscall opcode executed in protected mode
};
// c4m mode register values, assigned into the trap handler's own
// parameter to choose the mode a task resumes in.
enum { C4IX_MODE_UNPROTECTED = 0, C4IX_MODE_PROTECTED = 1 };
// exit status given to a task cancelled by Ctrl-C
enum { C4IX_EXIT_INTERRUPTED = -2 };
// the guarded host opcodes C4IX services on behalf of user tasks
enum {
    C4IX_OP_OPEN = 30, C4IX_OP_READ = 31, C4IX_OP_CLOS = 32,
    C4IX_OP_PRTF = 33, C4IX_OP_MALC = 34, C4IX_OP_FREE = 35,
    C4IX_OP_EXIT = 38, C4IX_OP_PUTC = 39, C4IX_OP_PUTS = 40,
    // ITH would take the machine's trap handler, the kernel's: refused
    C4IX_OP_ITH = 44,
    // USLP sleeps the whole machine, so a task gets a sleep of its own
    // SIGH sets the machine's handler, the kernel's: a task gets its own
    C4IX_OP_SIGH = 54,
    C4IX_OP_USLP = 56,
    // INFO is guarded too, and a C4KE program asks for it before it
    // does anything else -- u0's startup and ps both call __c4_info().
    C4IX_OP_INFO = 57
};

// ---- the syscall interface (sys.c) ----
// Userland reaches these through libc4ix (src/c4ix/lib/libc4ix.c),
// never directly: a stub executes custom opcode SYS_* which c4m does
// not know, raising TRAP_ILLOP into the kernel.
enum {
    SYS_BASE = 200,
    SYS_WRITE = 200, SYS_READ = 201, SYS_OPEN = 202, SYS_CLOSE = 203,
    SYS_EXIT = 204, SYS_YIELD = 205, SYS_SPAWN = 206, SYS_WAIT = 207,
    SYS_SBRK = 208, SYS_GETPID = 209,
    SYS_DUP = 210, SYS_DUP2 = 211, SYS_PIPE = 212,
    SYS_CYCLES = 213, SYS_TASKINFO = 214,
    SYS_CHDIR = 215, SYS_MKDIR = 216, SYS_GETCWD = 217, SYS_READDIR = 218,
    SYS_KILL = 219,
    SYS_SLEEP = 220, SYS_AVAIL = 221, SYS_INTR = 222, SYS_CLOEXEC = 223,
    SYS_STAT = 224, SYS_UNLINK = 225, SYS_RENAME = 226, SYS_LAZYFILE = 227,
    SYS_STACK = 228, SYS_CPUSTAT = 229,
    SYS_EVWAIT = 230, SYS_DISCARD = 231,
    // POSIX's process and file calls, for Busybox (docs/busybox-port.md §4)
    SYS_VFORK = 232, SYS_EXECVE = 233, SYS_WAITPID = 234, SYS_LSEEK = 235,
    SYS_FSTAT = 236, SYS_LINK = 237, SYS_FTRUNCATE = 238, SYS_ENVIRON = 239,
    // libjs's display, taken and given back (sys.c, "The display")
    SYS_DISPLAY = 240,
    // the CPUs a task may run on (sched.c, sched_affinity)
    SYS_AFFINITY = 242,
    // a task's priority (sched.c, sched_nice)
    SYS_NICE = 243,
    SYS_TOP = 244          // one past the last: sched_trap's range check
};
// SYS_DISPLAY's operations, and TAKE's flag (include/display.h)
enum { DISP_TAKE = 0, DISP_STATE = 1, DISP_YIELD = 2, DISP_GIVE = 3, DISP_YIELDS = 1 };
// What SYS_STAT and SYS_FSTAT write, a word each, as many as the caller
// asks for: SYS_STAT's callers from before M7c ask for none, which is
// the first four.
enum {
    ST_TYPE = 0,           // 1 directory, 2 RAM file, 3 anything else
    ST_SIZE = 1, ST_PROG = 2, ST_MTIME = 3,
    ST_INO = 4,            // the vnode's number: two names of one file share it
    ST_NLINK = 5,          // its names (SYS_LINK)
    ST_MODE = 6,           // made up: 0755 for directories and programs, 0644 for the rest
    ST_DEV = 7,            // 1 for the RAM filesystem, 2 for a host file, 0 for the console or a pipe
    ST_WORDS = 8
};
// SYS_WAITPID: options, and the two words it writes (exit code, signal)
enum { C4IX_WNOHANG = 1 };
// taskinfo fills, in order: id, parent, state, privs, nsyscalls,
// ntraps, cycles, then the name packed into the remaining words.
// One task's worth of what utaskinfo reports: eight integers, then the
// name as TASK_NAME_MAX bytes. Sized generously and in WORDS, because
// how many words sixteen bytes is depends on the machine -- at 9 this
// was two words short on a 32-bit host and utaskinfo wrote past the
// caller's array.
// Past the name, at TI_CPU, the CPU running the task (-1 none), and at
// TI_NCPU how many the machine has (docs/c4ix-smp.md S4).
enum { TASKINFO_WORDS = 24, TI_CPU = 20, TI_NCPU = 21 };
enum { FD_STDIN = 0, FD_STDOUT = 1, FD_STDERR = 2, FD_MAX = 16 };

int  sys_dispatch(int num, int *args);   // args[0]=first, args[1]=second...
int  sys_write(int fd, char *buf, int len);
int  sys_read(int fd, char *buf, int len);
int  sys_open(char *path, int flags);
int  sys_close(int fd);
int  sys_dup(int fd);
int  sys_dup2(int oldfd, int newfd);
int  sys_pipe(int *fds);                 // fds[0] read end, fds[1] write end
int  sys_taskinfo(int index, int *out);  // 1 if that slot exists
int  sys_chdir(char *path);
int  sys_mkdir(char *path);
int  sys_getcwd(char *buf, int len);
int  sys_readdir(char *path, int index, char *name);  // <0 end, else isdir
void sys_pmviolation(int op, int *sp, int *returnpc, int *a);
void sys_display_drop(int id);

// Set when a syscall could not complete because the calling task had
// to block. The trap handler rewinds the saved pc by one word so the
// task re-executes the syscall opcode when it wakes -- the arguments
// are still on its stack, so the call simply happens again.
extern int sys_restart;

// ---- the VFS (vfs.c) ----
//
// The classic three layers, because they are what dup2 and pipes
// need: a VNODE is the thing (console, RAM file, host file, pipe);
// an open FILE description holds the flags and the seek position;
// an FD is an index in a per-task table pointing at a description.
// dup2 makes two fds share one description -- and therefore one
// position -- while two separate opens of the same file get
// independent positions. Spawned tasks inherit the table, which is
// what makes redirection work: set fd 1 up, spawn, restore.
// VN_LINK is a second name for a RAM file (SYS_LINK): an entry in a
// directory that holds no bytes, only the file it names. A path that
// ends at one resolves to its file; the file keeps its first name.
// VN_PROC is a read-only file whose bytes the kernel makes when it is
// read: /proc/uptime (vfs.c, vfs_proc).
enum {
    VN_CONSOLE = 1, VN_RAMFILE = 2, VN_HOSTFILE = 3, VN_PIPE = 4,
    VN_DIR = 5, VN_LINK = 6, VN_PROC = 7
};
// 64: the root archive carries the repo's own tree, whose longest file
// name is 26 characters (24 truncated them). Userland buffers that
// receive a name from readdir must hold VN_NAME_MAX bytes.
enum { VN_NAME_MAX = 64, PATH_MAX = 256 };
// open() flags. The low two bits match the host's O_RDONLY/WRONLY/
// RDWR so they can be passed straight through for host files.
enum {
    C4IX_O_RDONLY = 0, C4IX_O_WRONLY = 1, C4IX_O_RDWR = 2,
    C4IX_O_CREAT = 256, C4IX_O_TRUNC = 512,
    // Linux's value. A task that opens a host file non-blocking means
    // it, and sys_open has to pass the bit through: a read on a
    // blocking host fd calls the host read() directly (vfs.c) and
    // stops the WHOLE VM, not just the caller.
    C4IX_O_NONBLOCK = 2048,
    // every write lands at the end; and with O_CREAT, fail if it exists.
    // libc's values (libc.h), so its open() passes them straight through.
    C4IX_O_APPEND = 4096, C4IX_O_EXCL = 8192
};

struct vnode {
    int type;                  // VN_*
    int refs;                  // open descriptions pointing here
    char *data;                // RAMFILE/PIPE storage
    int size;                  // bytes of data valid
    int cap;                   // bytes allocated
    int rpos;                  // PIPE: read cursor into data
    int host;                  // HOSTFILE: the host descriptor
    int writers;               // PIPE: descriptions still open for write
    struct vnode *next;        // sibling in the parent directory
    struct vnode *child;        // VN_DIR: first entry
    struct vnode *parent;       // VN_DIR: enclosing directory
    char name[VN_NAME_MAX];     // one component, not a path
    // A lazy RAM file (SYS_LAZYFILE): its bytes are still on the host,
    // under this name, and are read in the first time anything opens,
    // reads, writes or loads it. size is already right.
    char *hostname;
    int lazy;
    // When it last changed, as a place in the order of changes rather
    // than a time (vfs_touch): b4ke compares two, nothing else does. A
    // file still on the host is 0, older than anything made here.
    int mtime;
    int ino;                    // its number, for stat: one per vnode, never reused
    // Links (SYS_LINK). A VN_LINK entry's target is its file, and lnext
    // the file's next link. A file's links is its first link and nlinks
    // how many it has, so stat's nlink is one more.
    struct vnode *target;
    struct vnode *links;
    struct vnode *lnext;
    int nlinks;
};

struct file {
    struct vnode *vn;
    int flags;
    int pos;                   // seek position (shared across dup2)
    int refs;                  // fds pointing at this description
};

void         vfs_init();
// Names are resolved a component at a time from CWD (or from the
// root when the path starts with '/'), which is what makes "." and
// ".." mean anything and what a flat namespace could never support.
struct vnode *vfs_lookup(char *path);
struct vnode *vfs_ramfile(char *path);   // find or create the file
struct vnode *vfs_mkdir(char *path);
int          vfs_stat(char *path, int *out, int n);   // the first N ST_* words; -1 if no such path
void         vn_stat(struct vnode *vn, int *out, int n);   // the same, of an open file's vnode
void         vfs_touch(struct vnode *vn);        // it changed: give it the next mtime
int          vfs_link(char *path, char *newpath);   // a second name for a RAM file
int          vfs_truncate(struct vnode *vn, int len);  // a RAM file cut, or grown with zeros, to LEN
int          vfs_unlink(char *path);
int          vfs_rename(char *path, char *newname);
int          vfs_lazyfile(char *path, char *host, int size);
int          vfs_fill(struct vnode *vn);         // read a lazy file's bytes in; 1 if it has them
int          vfs_put(char *path, char *buf, int len);   // C4KE OP_VFS_PUT
struct vnode *vfs_klog();                                // /log/kernel, held by the kernel
void         vfs_logc(struct vnode *vn, int c, int max); // one byte on its end, up to MAX
char        *vfs_getdata(char *path, int *plen);        // C4KE OP_VFS_GET
int          vfs_nfiles();                              // C4KE OP_VFS_COUNT: files in the cwd
char        *vfs_fname(int i);                          // C4KE OP_VFS_NAME
struct vnode *vfs_root();
struct vnode *vfs_cwd();
int          vfs_chdir(char *path);
int          vfs_isdir(struct vnode *vn);
// Directory listing, one entry at a time: index-based so userland
// gets a stable interface without seeing kernel pointers.
int          vfs_direntry(struct vnode *dir, int index, char *name, int *isdir);
struct vnode *vfs_pipe();
struct vnode *vn_hostfile(int host);
int          vfs_read(struct file *f, char *buf, int len);
int          vfs_write(struct file *f, char *buf, int len);
int          vfs_readable(struct vnode *vn, int pos);  // 1 = read won't block
void         vfs_dump(char *name);       // kernel-side: print a RAM file
int          vfs_size(char *name);       // bytes stored, -1 if absent

struct file *fd_get(struct task *t, int fd);
int          fd_install(struct task *t, struct file *f);
int          fd_open_vnode(struct task *t, struct vnode *vn, int flags);
int          fd_close(struct task *t, int fd);
int          fd_dup2(struct task *t, int oldfd, int newfd);
void         fd_init_console(struct task *t);
void         fd_clone(struct task *dst, struct task *src);
void         fd_clone_all(struct task *dst, struct task *src);   // vfork: close-on-exec fds too
void         fd_closeall(struct task *t);
void         fd_close_on_exec(struct task *t);

int   host_detect();
int   host_info();
int   task_info();   // host_info() as a task sees it: plus C4I_TRAPH
int   host_has(int bit);
char *host_name();

// ---- console (console.c) ----
// All kernel output goes through here; the only opcode used is PUTC,
// which every host implements. kprintf lines are atomic: the body
// runs inside sched_lock, so preemption never interleaves them.
void con_init();
void con_wake();           // let the next poll reach the host again
int con_poll();            // 1 if a console read would not block
int con_read(char *buf, int len);
int kputc(int c);
void con_logopen();        // /log/kernel exists now: the console is logged to it
void con_booted();         // boot is over: tasks' console output is no longer logged
void con_write_task(char *buf, int len);  // a task's bytes to the console
int kputs(char *s);
int kprintf(char *fmt, ...);

// ---- varargs (va.c) ----
// The stock stdarg.h keeps its va area in per-unit statics. Statics
// never merge across objects, so a cross-module variadic call would
// push on the caller's counter and pop the callee's. C4IX therefore
// owns ONE va area, in va.c, reached through extern functions.
#define va_list int *
#define va_arg(AP, TYPE)   (AP = AP + 1, *((TYPE *) (AP - 1)))
#define va_start(AP, LAST) (AP = *(&LAST - 1), va_arg(AP, int))
#define va_end(AP)         (AP = AP - 1, __c4ix_va_adj(1 + va_arg(AP, int)))
int *__c4cc_make_va(int count);  // compiler-inserted at variadic call sites
void __c4ix_va_adj(int n);

// ---- SL4B (sl4b.c) ----
// Slab allocator for fixed-size kernel objects: caches hand out
// objects from malloc'd slabs, frees thread back onto a freelist.
enum { SL4B_NAME_MAX = 16 };

struct sl4b_slab {
    struct sl4b_slab *next;
};

struct sl4b_cache {
    int objsize;               // bytes, rounded up to words
    int perslab;               // objects added per slab grow
    struct sl4b_slab *slabs;
    int *freelist;             // threaded through the free objects
    int nallocs;
    int nfrees;
    int nslabs;
    struct sl4b_cache *next;   // all-caches list, for sl4b_stats
    char name[SL4B_NAME_MAX];
};

struct sl4b_cache *sl4b_cache_create(char *name, int objsize, int perslab);
char *sl4b_alloc(struct sl4b_cache *c);
void  sl4b_free(struct sl4b_cache *c, char *obj);
void  sl4b_stats();

// ---- tasks (task.c) ----
// Tasks live on a malloc'd singly linked list -- no fixed table.
// Structs come from an SL4B cache, stacks from malloc (256KB each on a
// 32-bit host).
// task_next() wraps from the tail back to the head: that round-robin
// walk is the loop the scheduler context-switches along.
enum { TASK_NAME_MAX = 16 };
// 256KB on a 32-bit host, C4KE's TASK_STACK_SIZE: C4IX runs C4KE's
// programs. c4sc compiling the larger kernel modules overran 64KB under
// C4KE first (docs/task-memory.md) and then here, where it wrote over
// the heap and took every task down. That was a c4lc bug, g:resolvecode
// recursing once per instruction (29cbac9); c4sc now needs 11KB at most.
// The lowest C4IX_STACK_GUARD words are poison (sched_forge), checked
// at every switch, so an overrun now kills the task that did it.
enum { C4IX_STACK_WORDS = 65536, C4IX_STACK_GUARD = 64, C4IX_STACK_POISON = 0x57415348 };
// A bigger stack for one spawn: SYS_STACK sets it per spawning task (b4ke's
// $(STACK)), and sys.c hands it to sched_forge through this, for one call.
// Up to C4IX_STACK_MAX bytes.
enum { C4IX_STACK_MAX = 16777216 };
extern int sched_next_stack_words;
// TS_WAITING = blocked on another task (wait); TS_BLOCKED = blocked
// on a vnode (an empty pipe); TS_SLEEPING = blocked on the clock.
// All three are woken by the scheduler when their condition clears.
// TS_VFORK = a vfork parent, parked until its child (wait_for) execs or
// exits, because until then the child is using its memory.
enum {
    TS_READY = 1, TS_RUNNING = 2, TS_ZOMBIE = 3,
    TS_WAITING = 4, TS_BLOCKED = 5, TS_SLEEPING = 6, TS_VFORK = 7
};
// Privilege level. PRIV_USER tasks resume in c4m's protected mode:
// host syscall opcodes trap to the kernel instead of executing, so
// all their IO goes through sys.c whether they ask nicely (libc4ix
// syscalls) or not (a raw printf gets emulated onto the fd layer).
// Plain c4 has no protected mode; everything runs PRIV_KERNEL there
// and the boundary is a convention rather than an enforcement.
enum { PRIV_KERNEL = 0, PRIV_USER = 1 };
// How a suspended task's context is saved (sched.c):
//   SV_NONE   running, or the adopted boot context (nothing saved)
//   SV_FRAME  a (frame, saved_bp, saved_pc) triple for the LEV path;
//             fresh tasks are forged in this form
//   SV_REGS   full (a, bp, sp, pc) captured by the c4m trap handler
enum { SV_NONE = 0, SV_FRAME = 1, SV_REGS = 2 };

struct task {
    int  id;
    int  state;                // TS_*
    int  entry;                // function address, called via a variable
    int  exitcode;
    struct task *next;         // list order = creation order
    int  sv;                   // SV_*
    int  sv_a;                 // SV_REGS: a
    int  sv_bp;                // SV_REGS: bp    SV_FRAME: saved bp value
    int  sv_sp;                // SV_REGS: sp    SV_FRAME: frame address
    int  sv_pc;                // SV_REGS: pc    SV_FRAME: saved pc value
    int  stack;                // malloc'd stack base, 0 for the kernel task
    int  stack_words;          // its size, C4IX_STACK_WORDS unless SYS_STACK asked
    int  img_bytes;            // what its image took to load: code, data, lists, library data
    int  spawn_stack;          // SYS_STACK: bytes for the tasks this one spawns, 0 default
    int  img_code;             // loaded .c4r segments to free on reap,
    int  img_data;             //   0 for kernel-code tasks
    int  img_cons;             // int * : constructors this task must run
    int  img_ncons;            //   before main, in its OWN context
    int  img_des;              // int * : destructors, run in reverse
    int  img_ndes;             //   after main returns
    int  img_libs;             // int * : shared libraries' code, data and slot, in threes
    int  img_nlibs;            //   (loader.c), freed with the task
    int  privs;                // PRIV_*
    int  nsyscalls;            // syscalls serviced, for the X2 report
    int  wait_for;             // TS_WAITING: the task id being waited on
    int  wait_result;          // exit code delivered when the wait completes
    struct vnode *block_vn;    // TS_BLOCKED: the vnode being waited on
    int  block_pos;            // position the blocked read wants data past
    int  fds[FD_MAX];          // struct file *, 0 where the fd is closed
    int  fdcloexec[FD_MAX];    // 1: this fd is not inherited on spawn (SYS_CLOEXEC)
    struct vnode *cwd;         // working directory, inherited on spawn
    int  lockdepth;            // preemption-mask depth, saved across switches
    int  parent;               // task id that spawned this one
    // Cycles (sched.c, "accounting"): what the task ran itself, outside
    // the trap handler, and what the handler spent on its behalf -- its
    // syscalls, preemption ticks and switches, which System Monitor shows
    // as System. 64 bits, since one C4IX build passes 2^31 several times
    // over. A trap adds into the int accumulators, and they are folded
    // into the totals before they could overflow and whenever the
    // totals are read, so the hot path does no long long arithmetic.
    long long ucycles;
    long long kcycles;
    int  uacc;                 // not yet in ucycles
    int  kacc;                 // not yet in kcycles
    int  ntraps;               // traps taken on its behalf
    // SYS_EVWAIT: what besides the clock ends this task's sleep -- 1, an
    // event in the GUI ring at ev_ring; 2, data or end of file on a pipe
    // it reads (sched_events)
    int  ev_wait;
    int  ev_ring;
    // C4KE compatibility state (c4ke.c). Zero for every task that
    // never uses it -- sl4b_alloc memsets, so this costs nothing to
    // carry and nothing to initialise.
    int  ck_sigh;              // int * : CK_SIG_MAX triples, 0 = never used
    int  ck_sigpend;           // pending signal count, so the fast path is one test
    int  ck_excl;              // holds the exclusive (preemption-masked) lock
    int  ck_wake;              // TS_SLEEPING: __time() value to wake at
    int  argv_vec;             // char ** owned by this task, 0 if not owned
    int  argv_data;            // char *  backing store for the above
    int  ublocks;              // int * : its SYS_SBRK / malloc blocks (task_ualloc), freed with it
    // The environment SYS_EXECVE gave it, "NAME=VALUE" strings ending in
    // 0, the kernel's copy (SYS_ENVIRON); a spawned child gets a copy.
    int  env_vec;
    int  env_data;
    // vfork (sched_vfork). A child's vfparent is the parent whose image,
    // library data and heap it borrows until it execs or exits: its
    // img_libs are the parent's, and nothing of them is its to free.
    struct task *vfparent;
    int  wait_posix;           // TS_WAITING in SYS_WAITPID: woken to run it again
    int  posix;                // has used vfork or waitpid: its zombies wait for it
    int  killsig;              // the signal that killed it, 0 if it exited
    // Processors (sched.c). oncpu is 1 + the CPU that may still be on its
    // stack: the one running it, or the one that switched it out until
    // that CPU has left the trap it did it in. Until then no other CPU
    // resumes it and nothing frees it. cpuidle is 1 + the CPU whose idle
    // task it is, 0 for every other task. cpumask is the CPUs it may
    // run on, bit k for CPU k, 0 for any (pin, SYS_AFFINITY); a child
    // starts with its parent's.
    int  oncpu;
    int  cpuidle;
    int  cpumask;
    // Priority (sched.c, "nice"): -10, most favoured, to 10, 0 for most.
    // woke is set when a sleep or a wait ends, and cleared when the task
    // next runs: only then may it preempt a less favoured one.
    int  nice;
    int  woke;
    char name[TASK_NAME_MAX];
};

// What SYS_CPUSTAT copies out (sched_cpustat): a header, then one record
// per task, all taken in one trap so that every number describes the
// same instant. Userland's copy is in c4ix_user.h.
struct cpustat {
    int ntasks;                // records that follow, at most the caller's max
    int ms;                    // __time() when it was taken
    int napms;                 // machine ms the idle loop has slept, since boot
    int idle;                  // the idle task's id: its cycles are idle time
    long long gone_user;       // the cycles of tasks already reaped
    long long gone_kernel;
    int heap;                  // the machine's heap, bytes; 0 if the host does not say
    int heapused;              // ... and the bytes of it in use
    // Processors (docs/c4ix-smp.md S4): how many, 1 unless SMP; and for
    // each, its idle task's id, the machine ms it has parked or napped,
    // and its cycles since boot -- busy, every task but its idle task's
    // and the kernel's work for them, and idle, its idle task's
    int ncpu;
    int idles[CPU_MAX];
    int cnap[CPU_MAX];
    long long cbusy[CPU_MAX];
    long long cidle[CPU_MAX];
};
struct cpustat_task {
    int id, parent, state, privs, nsyscalls;
    long long user;            // cycles it ran outside the trap handler
    long long kernel;          // cycles the handler spent on it
    int mem;                   // bytes it holds: image, stack, library data, allocations
    int cpu;                   // the CPU running it, -1 if none is
    char name[TASK_NAME_MAX];
};

// The list head is shared extern data (c4lc L8 extern-data support:
// references resolve through symbol patches at link time).
extern struct task *task_head;
extern int task_last_syscalls;   // syscalls made by the last reaped task

struct task *task_create(char *name, int entry, int argc, int argv);
struct task *task_adopt(char *name);
// A vfork child of P: a stack of its own, P's descriptors (close-on-exec
// ones too), directory, environment and libraries. Its registers are
// sched_vfork's to set.
struct task *task_vchild(struct task *p);
void         task_unlink(struct task *t);
void         task_release(struct task *t);
void         task_reap();      // free tasks released while they ran
int          task_reap_orphans();          // zombies nobody waits on
int          task_ghost(int id, int *pcode);  // exit code of a reaped task
// A child of PARENT (PID, or any for -1) that the idle sweep reaped
// before PARENT's waitpid came: its id, code and signal, collected once
int          task_ghost_child(int parent, int pid, int *pcode, int *psig);
// Copy N strings (N < 0: up to a null pointer) into one block of
// kernel memory: *PVEC the vector, null-terminated, *PDATA the bytes.
// The count, or -1 out of memory.
int          task_strvec(char **v, int n, int *pvec, int *pdata);
void         task_drop_image(struct task *t);   // execve: free its image, libraries and heap
void         task_unborrow(struct task *t);     // a vfork child is done with its parent's memory
struct task *task_get(int id);
int sched_affinity(int id, int mask);
int sched_nice(int id, int nice);
struct task *task_first();
struct task *task_next(struct task *t);
int          task_count();
void         task_shutdown();
// A userland task's memory (SYS_SBRK, and malloc behind protected mode):
// kernel malloc blocks, each on its task's ublocks list behind a header,
// and all freed with the task (task_destroy). task_ufree takes back one,
// or plainly frees a pointer that is not such a block.
int          task_ualloc(struct task *t, int bytes);
void         task_ufree(int p);
int          task_umem(struct task *t);   // the bytes of its blocks, headers too

// ---- C4KE compatibility (c4ke.c) ----
//
// C4KE's userland reaches its kernel through custom opcodes >= 128
// that no VM implements, so they arrive as TRAP_ILLOP exactly like
// C4IX's own SYS_* gateway. Only OP_REQUEST_SYMBOL is a fixed number;
// every other service is looked up BY NAME at program start (u0.h's
// __u0_ops_init), so C4IX is free to assign whatever numbers it
// likes. These are they.
enum {
    CK_BASE = 128,
    CK_REQUEST_SYMBOL = 128,   // fixed by include/u0.h
    CK_C4INFO = 129, CK_TIME = 130, CK_SCHEDULE = 131,
    CK_AWAIT_MESSAGE = 132, CK_AWAIT_PID = 133,
    CK_KERN_TASKS_EXPORT = 134, CK_KERN_TASKS_EXPORT_UPDATE = 135,
    CK_KERN_TASKS_EXPORT_FREE = 136, CK_KERN_TASKS_RUNNING = 137,
    CK_USER_START_C4R = 138, CK_KERN_TASK_CURRENT_ID = 139,
    CK_KERN_TASK_RUNNING = 140, CK_KERN_TASK_COUNT = 141,
    CK_TASK_FINISH = 142, CK_TASK_FOCUS = 143, CK_TASK_EXIT = 144,
    CK_USER_SIGNAL = 145, CK_USER_KILL = 146, CK_USER_SLEEP = 147,
    CK_USER_PID = 148, CK_USER_PARENT = 149,
    CK_CURRENTTASK_UPDATE_NAME = 150, CK_DEBUG_KERNELSTATE = 151,
    CK_KERN_REQUEST_EXCLUSIVE = 152, CK_KERN_RELEASE_EXCLUSIVE = 153,
    CK_TASK_CYCLES = 154, CK_HALT = 155,
    // C4KE's kernel RAM filesystem, over C4IX's VFS: how c4cc, c4rlink
    // and c4lc write what they build (docs/c4ix-desktop.md, part three)
    CK_VFS_PUT = 156, CK_VFS_GET = 157, CK_VFS_UNLINK = 158,
    CK_VFS_COUNT = 159, CK_VFS_NAME = 160,
    CK_TOP = 161               // exclusive
};

// C4KE ABI constants. These MUST match include/u0.h -- they are read
// straight out of a shared buffer by an unmodified C4KE binary.
//
// The task-table export: a three-word header followed by a fixed
// number of fixed-size records. ps walks records 0 .. KTI_USED-1 and
// treats a ZERO STATE as an empty slot, so every live record must
// have STATE_LOADED set.
enum { CK_KTI_COUNT = 0, CK_KTI_USED = 1, CK_KTI_LIST = 2, CK_KTI__Sz = 3 };
enum {
    CK_KTE_STATE = 0, CK_KTE_WAITSTATE = 1, CK_KTE_ID = 2,
    CK_KTE_PARENT = 3, CK_KTE_NAME = 4, CK_KTE_NAMELEN = 5,
    CK_KTE_PRIORITY = 6, CK_KTE_PRIVS = 7, CK_KTE_NICE = 8,
    // CYCLES_HI is billions: C4KE keeps the count in two words because
    // one overflows at 2^31 and printed a negative number of cycles
    // (c4ke.c's kernel_add_cycles). The layout has to match include/u0.h
    // exactly -- this is C4KE's ABI, being spoken by a different kernel.
    CK_KTE_CYCLES = 9, CK_KTE_CYCLES_HI = 10, CK_KTE_TIMEMS = 11,
    CK_KTE_TRAPS = 12, CK_KTE_STACK = 13, CK_KTE_ALLOC = 14,
    CK_KTE__Sz = 15
};
// Bit flags, tested with & by ps -- not small integers like TS_*.
enum {
    CK_STATE_UNLOADED = 0x0, CK_STATE_LOADED = 0x1,
    CK_STATE_RUNNING = 0x2, CK_STATE_WAITING = 0x4,
    CK_STATE_TRAPPED = 0x8, CK_STATE_ETHEREAL = 0x10,
    CK_STATE_ZOMBIE = 0x20
};
enum {
    CK_WSTATE_NONE = 0, CK_WSTATE_TIME = 1, CK_WSTATE_PID = 2,
    CK_WSTATE_SYSCALL = 3, CK_WSTATE_MESSAGE = 4
};
// C4KE's table is a fixed 192 slots; C4IX's task list has no maximum,
// so this is purely how many the export can describe at once.
enum { CK_TASK_SLOTS = 128 };
enum { CK_SIG_MAX = 64 };
enum { CK_SIGINT = 2, CK_SIGKILL = 9, CK_SIGUSR1 = 10, CK_SIGTERM = 15 };
// u0.h:27 -- note this disagrees with C4IX's own PRIV_*, which is
// PRIV_KERNEL = 0, PRIV_USER = 1. Convert at the boundary.
enum { CK_PRIV_NONE = 0, CK_PRIV_USER = 1, CK_PRIV_KERNEL = 2 };

extern int loader_quiet;   // suppress "not an image" while probing paths

int  ck_dispatch(int num, int *args);
void ck_task_free(struct task *t);   // release compat state on reap
int  ck_argv_copy(struct task *t, int argc, char **argv);   // the task owns a copy of argv
void ck_exec_reset(struct task *t);  // execve: its handlers were the old image's
int  ck_kill(int pid, int sig);      // queue a signal, or apply the default
int  ck_has_handler(struct task *t, int sig);
int  ck_signal(struct task *t, int sig, int handler);   // the old handler
// Deliver one pending signal to the task about to resume, by building
// it a trap frame by hand. MODE and INTERVAL are the context it would
// otherwise have resumed with; they go into the frame so the handler's
// return restores them.
void ck_signal_deliver(struct task *t, int *pa, int *pbp, int *psp,
                       int *ppc, int mode, int interval);

// ---- scheduler (sched.c) ----
// Every switch runs in a trap handler (soft trap for yield, cycle
// interrupt for preemption) that rewrites its own parameters; TLEV
// loads them into the VM registers.
void         sched_init(int interval);
void         sched_run();
int          sched_sleep_due(int *pms);   // earliest sleeper deadline, 0 if none
void         sched_forge_argv(struct task *t, int argv);  // pre-start argv patch
void         sched_stop();
void         sched_yield();
void         sched_new_slice();   // the running task's slice restarts
int          sched_intr_below(struct task *root);   // a terminal's Ctrl-C
void         sched_lock();     // disable preemption (nestable)
void         sched_unlock();
int          sched_forge(struct task *t, int entry, int argc, int argv);
// SYS_VFORK, from the trap handler, which has the registers (bp is the
// frame of the function that executed the syscall: the child returns
// from it). The child's id, or -1.
int          sched_vfork(int bp);
// What each processor keeps for itself (docs/c4ix-smp.md S3). cpu_self
// points at it: at an ordinary struct on one CPU, and at the CPU-local
// window under SMP, the same address on every CPU, through which each
// sees its own copy. It fits below CPU_SLOT0.
struct cpu {
    struct task *cur;          // the running task (sched_current)
    int intrap;                // inside the trap handler: no re-entry (sched_in_trap)
    int lockdepth;             // the running task's preemption mask (sched_lock)
    int id;                    // __c4_cpu_id(), 0 on one CPU
    int resched;               // a service in this trap asked for a switch
    int dying;                 // task_exit outside the handler: die in the next trap
    int dying_code;
    int acct_in;               // __c4_cycles() as this trap began
    int acct_out;              // ... as the last one ended
    int slice0;                // acct_in when the running task's slice began
    int reload;                // SYS_EXECVE: resume the running task from its forged frame
    int stale_stack;           // SYS_EXECVE: the old stack, freed at this CPU's next trap
    struct task *prev;         // switched out here; its oncpu is cleared once this CPU is off its stack
    struct task *idle;         // this CPU's idle task
    int bkl_task;              // the running task holds the kernel lock (a kernel task)
};
extern struct cpu *cpu_self;
extern int smp_ncpu;           // processors in use: 1 unless the host has SMP
void sched_early();            // cpu_self, before anything locks (boot.c)
int  task_busy(struct task *t);   // some CPU may be on its stack: not to be freed yet
int  task_cpu(struct task *t);    // the CPU running it, -1 if none is
int  smp_slot_alloc();         // a library's data slot in the window, 0 if none is left
// A lock: { 1 + the CPU holding it, its holds }, nested per CPU (sched.c)
void klock_take(int *lk);
void klock_drop(int *lk);
// SYS_EXECVE replaced the running task's context: the trap returns into
// the forged one, and the old stack, still under the handler, is freed
// at the next trap.
#define sched_reload (cpu_self->reload)
#define sched_stale_stack (cpu_self->stale_stack)
// The running task, and whether the trap handler is running (no
// re-entry allowed). Read by every module on every syscall, so they are
// macros rather than calls: -minline cannot inline across modules.
#define sched_cur (cpu_self->cur)
#define sched_intrap (cpu_self->intrap)
#define sched_current() sched_cur
#define sched_in_trap() sched_intrap
extern struct task *task_reaplist;  // released while running, to be freed (task.c)
void         task_exit(int code);
void         task_zombify(struct task *t, int code);  // every death: wakes its waiter
int          sched_events(struct task *t);  // SYS_EVWAIT: has what it waits for come?
extern int   sched_nlive;      // tasks still to finish (sched.c)
extern int   sched_nzombies;
int          task_wait(struct task *t);
extern int   sched_switches;   // context switches since boot
long long    task_cycles(struct task *t);  // everything it has run, both kinds
void         sched_retire(struct task *t); // its cycles to the reaped total
int          sched_cpustat(struct cpustat *h, struct cpustat_task *r, int max);

// ---- .c4r loader (loader.c) ----
// Constructor and destructor lists are copied out of the image buffer
// and resolved to ABSOLUTE addresses, because the task runs them
// itself: at load time the task does not exist yet, and a constructor
// that asks who it is would be told the spawning task.
struct c4r_image {
    int code;                  // malloc'd code segment (int *)
    int data;                  // malloc'd data segment (char *)
    int entry;                 // absolute entry address
    int cons;                  // malloc'd int[ncons], absolute addresses
    int ncons;
    int des;                   // malloc'd int[ndes], absolute addresses
    int ndes;
    int libs;                  // malloc'd int[3 * nlibs]: each library's code (0 if shared), data, slot
    int nlibs;
    int bytes;                 // all of the above, as the heap counts it (shared code not)
};

int          c4r_load(char *path, struct c4r_image *img);
void         c4r_unload(struct c4r_image *img);   // free all of it
void         loader_switch(struct task *t);       // point -fpic libraries at t's data
struct task *task_spawn(char *path, int argc, int argv);
struct task *task_spawn_priv(char *path, int argc, int argv, int privs);

// ---- init (init.c) ----
int init_main(int argc, int argv);

#endif // __C4IX_H
include/c4bb.h 4665
// c4bb.h -- the breadboard's drives, from inside the machine.
//
// c4bb's devices are memory-mapped and the CPU reaches them with
// ordinary loads and stores; src/c4bb/fw/fw.c already drives the
// interval and heap registers exactly this way. So a program can write
// to a disk without the VM growing a `write` opcode, which is just as
// well, because C4 has never had one.
//
// The read side (open/read/close) is the microcode's business and is
// reached through the ordinary syscalls. Everything here is the parts
// the microcode does not know about: which drive, how many, whether it
// can be written to, and the write head itself.
//
// BOARD ONLY. These addresses are devices on c4bb and ordinary memory
// anywhere else, so a program that includes this is a program for the
// breadboard -- the same rule dostar and dosload follow. Nothing that
// has to run under native c4m may include it.
//
// See docs/c4bb-storage.md.

enum {
	BB_DRIVE  = 0x13c,   // r/w: selected drive, 0-based
	BB_FD     = 0x124,   // w:   the fd a write applies to (shared with read)
	BB_WNAME  = 0x178,   // w:   create/truncate -> fd, or -1
	BB_WADDR  = 0x17c,   // w:   buffer address
	BB_WLEN   = 0x180,   // w:   write N bytes -> N written
	BB_WCLOSE = 0x184,   // w:   close and flush -> 0, or -1
	BB_COUNT  = 0x188,   // r:   how many drives are attached
	BB_RO     = 0x18c,   // r:   1 if the selected drive is read-only
	BB_EJECT  = 0x190,   // w:   empty the drive whose number is written
	BB_RESCAN = 0x194,   // w:   re-read the drive whose number is written
	BB_RESET  = 0x198,   // w:   soft reset -- back to the BIOS
	BB_RTC    = 0x19c,   // r:   host milliseconds since power-on
	BB_PIT    = 0x1a0    // r/w: tick every N real ms (0 = off)
};

// How many drives this machine has, and which one is selected.
int bb_drives ()          { return *(int *)BB_COUNT; }
int bb_drive ()           { return *(int *)BB_DRIVE; }
void bb_select (int n)    { *(int *)BB_DRIVE = n; }
int bb_readonly ()        { return *(int *)BB_RO; }
void bb_eject (int n)     { *(int *)BB_EJECT = n; }

// A name may carry its own drive -- "1:c4ke.c4r" -- in which case the
// selected drive does not matter. That is C4DOS's own habit and it is
// cheaper than a register.
int bb_create (char *name) {
	*(int *)BB_WNAME = (int)name;
	return *(int *)BB_WNAME;
}

int bb_write (int fd, char *buf, int len) {
	*(int *)BB_FD    = fd;
	*(int *)BB_WADDR = (int)buf;
	*(int *)BB_WLEN  = len;
	return *(int *)BB_WLEN;
}

// Nothing is on the medium until this returns: a written file lands in
// one piece or not at all.
int bb_close (int fd) {
	*(int *)BB_WCLOSE = fd;
	return *(int *)BB_WCLOSE;
}

// The whole of it, which is what every caller actually wants.
int bb_put (char *name, char *buf, int len) {
	int fd;
	if ((fd = bb_create(name)) < 0) return 0 - 1;
	if (len > 0) {
		if (bb_write(fd, buf, len) != len) { bb_close(fd); return 0 - 1; }
	}
	return bb_close(fd);
}

// Ask the machine to start again. Does not return: the host zeroes the
// arena, places the firmware, and the BIOS looks at the drives as if
// the power had just come on -- so an operating system that has just
// written a boot disk can say "now boot it" without anyone touching
// the machine. The media survive; that is the difference between this
// and switching off.
void bb_reboot () {
	*(int *)BB_RESET = 0;
}

// Take the medium out of a drive. The BIOS's wait loop notices.
void bb_rescan (int n) { *(int *)BB_RESCAN = n; }

// The world's clock, not the machine's.
//
// The TIME opcode reports SIMULATED milliseconds, derived from the
// cycle counter: repeatable, which is what tests want, and a fiction,
// because the simulator runs at whatever speed the host manages. This
// is the real one, and it is a register rather than an opcode so that a
// program at the base-c4 rung can read it with an ordinary load.
int bb_rtc () { return *(int *)BB_RTC; }

// Ask for a tick every N real milliseconds, raising the same trap the
// cycle interrupt does -- so a kernel that already has a handler needs
// no new one, and stops having to guess how many cycles a second is on
// this host.
//
// 0 MASKS the timer rather than forgetting it: the deadline stays where
// it was, and re-arming the same interval resumes toward it. That is
// what makes bb_pit(0) safe to use the way a kernel uses it, which is
// on the way into every critical path -- a mask that restarted the
// countdown would let a kernel that masks often enough never tick at
// all. Writing a DIFFERENT interval does start a new countdown.
void bb_pit (int ms) { *(int *)BB_PIT = ms; }
int  bb_pit_get ()   { return *(int *)BB_PIT; }
include/c4bb_info.h 1721
// c4bb_info.h -- is this actually a breadboard?
//
// Separate from c4bb.h on purpose. Everything in that header is a plain
// load or store and costs no opcode above EXIT, which is what lets a
// C4DOS-rung program read the clock and arm the timer. This one asks
// c4_info(), and INFO is opcode 57 -- so including it puts the program
// above base c4, and c4cc compiles every function in a header whether
// it is called or not.
//
// Who needs it: something that ALSO runs somewhere else. A C4DOS
// transient only ever runs here and can assume the registers exist; a
// kernel that runs under native c4m as well cannot, because there is no
// device window at 0x19c there and the read would be a wild access
// rather than a zero. The capability is announced, never probed.
//
// See docs/c4bb-storage.md.

enum { BB_I_PIT = 0x800 };      // c4bb has RTC_MS and PIT_MS

int bb_has_clock () { return __c4_info() & BB_I_PIT; }

// c4bb can be asked which PC last wrote to an address
// (src/c4bb/sim/arena-whowrote.js, cli.js --whowrote). Fitted only when
// the machine was started with that flag, which is why it is announced
// here rather than assumed: the port lives at 0x1a4/0x1a8, and under
// native c4m those addresses are c4m's OWN MEMORY. Writing there to see
// what happens is the one thing this must never do.
enum { BB_I_WHOWROTE = 0x1000 };
enum { BB_WW_QUERY = 420, BB_WW_ANSWER = 424 };   // 0x1a4, 0x1a8

int bb_has_whowrote () { return __c4_info() & BB_I_WHOWROTE; }

// Which PC last stored to `addr`, or 0 for "nobody yet" / not fitted.
// CHECK bb_has_whowrote() FIRST.
int bb_whowrote (int addr) {
	int *q, *ans;
	q = (int *)BB_WW_QUERY;
	ans = (int *)BB_WW_ANSWER;
	*q = addr;
	return *ans;
}
include/c4bb_mbox.h 3286
// c4bb_mbox.h -- the mailbox, from inside the machine.
//
// A region of RAM the host and the guest share, holding two rings of
// i32 frames: one the host writes and the guest reads (in), one the
// guest writes and the host reads (out). A frame is [len][type][seq]
// followed by len-3 payload words; head and tail are monotonic word
// counters and a frame never wraps -- a -1 marker at the head means
// "skip to the next multiple of cap". Plain loads and stores: no
// opcode, no copy. docs/c4bb-design.md "The mailbox".
//
// BOARD ONLY, and only after the caller has seen C4I_MBOX (0x2000) in
// __c4_info(): on native c4m these addresses are ordinary memory, and
// a program that includes this must say "not fitted" and stop there
// when the bit is absent. c4cc has no #include; pass this file as a
// source ahead of the program, the way u0lite.h is passed.

enum {
	MB_BASE = 0x1b4,       // r: region base (0 = none)
	MB_LEN  = 0x1b8,       // r: region bytes
	MB_BELL = 0x1bc,       // w: doorbell to the host; r: pending host irqs (read-to-clear)
	MB_CAP = 0, MB_HEAD = 1, MB_TAIL = 2, MB_DATA = 3,   // ring header words
	MB_HDR = 3,            // frame header words: len, type, seq
	MB_BELL_REPLY = 1,     // "I wrote frames"
	MB_BELL_IDLE  = 2,     // "my inbox is empty; you may stop me"
	C4I_MBOX = 0x2000
};

int *mb_in;   // host -> guest ring (we read)
int *mb_out;  // guest -> host ring (we write)
int  mb_seq;  // our next outgoing sequence number

// 1 when the mailbox is fitted and the rings are mapped, else 0.
int mb_init () {
	int base, len, half;
	if (!(__c4_info() & C4I_MBOX)) return 0;
	base = *(int *)MB_BASE;
	len  = *(int *)MB_LEN;
	if (!base || !len) return 0;
	half = len / 2;
	mb_in  = (int *)base;
	mb_out = (int *)(base + half);
	mb_seq = 0;
	return 1;
}

// The next frame in the inbox, or 0. The pointer is valid until mb_done.
int *mb_poll () {
	int cap, head, tail, at;
	cap = mb_in[MB_CAP]; head = mb_in[MB_HEAD]; tail = mb_in[MB_TAIL];
	if (head == tail) return 0;
	at = tail % cap;
	if (mb_in[MB_DATA + at] == -1) {           // skip marker: producer wrapped
		tail = tail + (cap - at);
		mb_in[MB_TAIL] = tail;
		if (head == tail) return 0;
		at = 0;
	}
	return mb_in + MB_DATA + at;
}

// Consume the frame mb_poll returned.
void mb_done (int *frame) {
	mb_in[MB_TAIL] = mb_in[MB_TAIL] + frame[0];
}

// Write a frame of `n` payload words to the outbox. 1 on success, 0 if full.
int mb_send (int type, int *payload, int n) {
	int cap, head, tail, at, len, free, i, *f;
	cap = mb_out[MB_CAP]; head = mb_out[MB_HEAD]; tail = mb_out[MB_TAIL];
	len = MB_HDR + n;
	free = cap - (head - tail);
	at = head % cap;
	if (at + len > cap) {                      // no room before the end: wrap
		if (free < (cap - at) + len) return 0;
		mb_out[MB_DATA + at] = -1;
		head = head + (cap - at);
		at = 0;
		free = cap - (head - tail);
	}
	if (free < len) return 0;
	f = mb_out + MB_DATA + at;
	f[1] = type; f[2] = mb_seq; mb_seq = mb_seq + 1;
	i = 0;
	while (i < n) { f[MB_HDR + i] = payload[i]; i = i + 1; }
	f[0] = len;                                // length last: the frame is whole when it is visible
	mb_out[MB_HEAD] = head + len;
	return 1;
}

void mb_bell (int v) { *(int *)MB_BELL = v; }
int  mb_irqs ()      { return *(int *)MB_BELL; }
include/c4cc_helpers.h 404
#ifndef __C4CC_HELPERS_H
#define __C4CC_HELPERS_H 1

// Helper function to print the stack values
#define STACK_DEPTH 16
#define STACK_WIDTH  8
static void __print_stack (int *sp) {
	int *s, c;
	c = STACK_DEPTH;
	s = sp ? sp : (int *)&sp;
	while (c--) {
		printf("  %16lx", *s++);
		if (c > 0 && (c % STACK_WIDTH == 0))
			printf("\n");
	}
	printf("\n");
}

#undef STACK_DEPTH
#undef STACK_WIDTH

#endif
include/c4dos.h 19290
// c4dos.h -- the transient-side C4DOS API.
//
// C4DOS loads a program into its own memory and jumps to it, so DOS's
// own routines are directly callable -- the only question is how a
// transient names one. The loader answers that: it scans the image's
// symbol section for __c4dos_api and writes the API table's address
// into it (the loader_systable pattern from src/c4ix/loader.c). A
// program that is NOT running under C4DOS is simply left with 0 there,
// which is how it knows.
//
// Why any of this exists: c4 and c4m have no write syscall, and c4bb's
// disk controller is read-only. A tool that wants to produce a file
// asks DOS to put it on the RAM disk (DEVICE=RAMDISK.SYS), or, since v5,
// on a drive that can be written: "B:NAME" names one, and a plain name
// goes to the home drive when CONFIG.SYS gives one (DEVICE=DRIVES.SYS
// HOME=B:). There is no '>' redirection on this system by decision --
// tools write directly.
//
// The calls go through the invoke stub, which is c4l.c's trick: a
// function rewrites its own first instruction to JMP <target>, so
// calling it lands wherever the slot points. That works on an
// unmodified c4, which matters -- a transient should not need a better
// CPU than DOS itself does just to save a file.
//
// Dialect: strict c4. Include it as a SOURCE FILE, the way u0.h is
// used, because c4cc has no preprocessor:
//   ./c4cc -o tool.c4r include/c4dos.h tool.c

// The opcodes the stub writes. Same numbering as every VM in the
// family (c4.c's enum); literal because plain c4's enum parser takes
// numbers only.
enum { C4DOS_JMP = 2, C4DOS_ENT = 6, C4DOS_ADJ = 7 };
enum { C4DOS_MAXSEARCH = 512 };

// ('C' << 16) + ('4' << 8) + 'D', written out because plain c4 cannot
// fold that in an enum.
enum { C4DOS_MAGIC = 4404292 };

// API table slots. Slots 0-8 are v1; 9-14 are v2 and MUST be gated on
// dos_version() >= 2, because a v1 DOS allocated a 16-word table and
// filled only the first nine -- the rest was uninitialised heap. 15 is
// v3 (the clock), 16-27 v4, 28-29 v5, 30 v6 and 31-34 v7 (below); the
// table is 40 words (32 before v7).
enum {
  C4DOS_SLOT_MAGIC   = 0,
  C4DOS_SLOT_EXIT    = 1,   // dos_exit(status): return to the prompt
  C4DOS_SLOT_CREATE  = 2,   // create(name) -> handle, or -1 (on a drive: there once closed)
  C4DOS_SLOT_WRITE   = 3,   // write(handle, buf, len) -> len
  C4DOS_SLOT_CLOSE   = 4,   // close(handle)
  C4DOS_SLOT_VERSION = 5,
  C4DOS_SLOT_OPEN    = 6,   // open(name) -> handle, or -1
  C4DOS_SLOT_READ    = 7,   // read(handle, buf, len) -> len
  C4DOS_SLOT_RCLOSE  = 8,   // close(handle)
  C4DOS_SLOT_COUNT   = 9,   // count() -> RAM disk entries
  C4DOS_SLOT_ENTNAME = 10,  // entname(i) -> char *, or 0
  C4DOS_SLOT_ENTSIZE = 11,  // entsize(i) -> bytes, or -1
  C4DOS_SLOT_ENTDATA = 12,  // entdata(i) -> char *, or 0
  C4DOS_SLOT_TRIM    = 13,  // trim() -> bytes of scratch released
  C4DOS_SLOT_RELEASE = 14   // release() -> bytes of RAM disk released
};

// The first version that has the slots above. See dos_can_enum().
enum { C4DOS_API_V2 = 2 };
// v3 adds slot 15, the clock. See dos_can_time().
enum { C4DOS_API_V3 = 3 };
enum { C4DOS_SLOT_TIME = 15 };

int *__c4dos_api;        // patched by the loader; 0 when not under DOS
int *__c4dos_slot;       // the stub's operand cell

// The pc of our caller's ENT, found by walking back from the return
// address. c4l.c's, verbatim in spirit.
int __c4dos_caller (int dummy) {
  int *addr, *next, i;
  addr = (int *)(*(&addr + 2));
  i = 0;
  next = addr;
  while (++i <= C4DOS_MAXSEARCH) {
    --next;
    if (*addr == C4DOS_ENT) {
      if (*next > C4DOS_ADJ) return (int)addr;
    }
    addr = next;
  }
  return 0;
}

int __c4dos_stub () {
  int *self;
  if (!(self = (int *)__c4dos_caller(0))) return 0 - 1;
  *self = C4DOS_JMP;
  __c4dos_slot = self + 1;
  return 0;
}

// Arm the stub, once. The call that does it runs PAST the instruction
// it just rewrote and returns normally; every later call to
// __c4dos_stub lands on the JMP instead. Until this happens
// __c4dos_slot is 0, and writing through it would be a store to
// address 0 -- which is exactly what an unarmed stub does.
int __c4dos_arm () {
  if (!__c4dos_slot) __c4dos_stub();
  return __c4dos_slot != 0;
}

// call0 passes a dummy argument on purpose: c4lc -O turns a bare
// "JSR f; LEV" into a tail call that enters f past its first word, and
// the stub's first word is the JMP it rewrote itself into -- so a
// zero-argument call re-ran the stub's body and rewrote the caller.
// With an argument the call is followed by ADJ and stays a call.
// (src/c4dos/c4dos.c's invoke0 had the same bug, 2026-09-30.)
int __c4dos_call0 (int *code) {
  *__c4dos_slot = (int)code;
  return __c4dos_stub(0);
}
int __c4dos_call1 (int *code, int a) {
  *__c4dos_slot = (int)code;
  return __c4dos_stub(a);
}
int __c4dos_call2 (int *code, int a, int b) {
  *__c4dos_slot = (int)code;
  return __c4dos_stub(a, b);
}
int __c4dos_call3 (int *code, int a, int b, int c) {
  *__c4dos_slot = (int)code;
  return __c4dos_stub(a, b, c);
}

// 1 when a C4DOS with a working API table loaded us.
int dos_present () {
  if (!__c4dos_api) return 0;
  return __c4dos_api[C4DOS_SLOT_MAGIC] == C4DOS_MAGIC;
}

// 1 when that DOS also has somewhere to put a file.
int dos_can_write () {
  if (!dos_present()) return 0;
  return __c4dos_api[C4DOS_SLOT_CREATE] != 0;
}

int dos_create (char *name) {
  if (!dos_can_write()) return 0 - 1;
  if (!__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_CREATE], (int)name);
}
int dos_write (int h, char *buf, int len) {
  if (!dos_can_write()) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call3((int *)__c4dos_api[C4DOS_SLOT_WRITE], h, (int)buf, len);
}
int dos_close (int h) {
  if (!dos_can_write()) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_CLOSE], h);
}

// Reading, the other half. A pipeline is only a pipeline if the next
// stage can see what the last one produced, and a transient's own
// open() goes straight to the host -- it has never heard of the RAM
// disk. These ask DOS instead, and DOS checks RAM before the disk, so
// one call finds a file wherever it actually lives.
int dos_readable () {
  if (!dos_present()) return 0;
  return __c4dos_api[C4DOS_SLOT_OPEN] != 0;
}
int dos_fopen (char *name) {
  if (!dos_readable()) return 0 - 1;
  if (!__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_OPEN], (int)name);
}
int dos_fread (int h, char *buf, int len) {
  if (!dos_readable()) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call3((int *)__c4dos_api[C4DOS_SLOT_READ], h, (int)buf, len);
}
int dos_fclose (int h) {
  if (!dos_readable()) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_RCLOSE], h);
}

// Read a whole file into `buf`, RAM disk or real disk, DOS's rules.
// Returns bytes read, or -1 when there is no DOS to ask.
int dos_slurp (char *name, char *buf, int max) {
  int h, n, total;
  if ((h = dos_fopen(name)) < 0) return 0 - 1;
  total = 0;
  n = 1;
  while (n > 0 && total < max) {
    if ((n = dos_fread(h, buf + total, 4096)) > 0) total = total + n;
  }
  dos_fclose(h);
  return total;
}

// Save a whole buffer under `name`. The shape every tool here wants:
// render the image in memory, then hand it over in one go.
int dos_put (char *name, char *buf, int len) {
  int h;
  if ((h = dos_create(name)) < 0) return 0 - 1;
  dos_write(h, buf, len);
  dos_close(h);
  return len;
}

// ---- v2: enumeration, and handing memory back ----------------------------
//
// The loader's half of the API. A tool asks for a file by name; a
// program taking the machine over -- dosload handing an initrd to a
// kernel -- needs the whole RAM disk without being told what is on it.
//
// Every one of these is gated twice: the version word AND the slot
// itself, because slots 9-12 are only advertised when a RAM disk was
// actually installed by CONFIG.SYS.

int dos_version () {
  if (!dos_present()) return 0;
  return __c4dos_api[C4DOS_SLOT_VERSION];
}

// 1 when this DOS can be asked what it is holding.
int dos_can_enum () {
  if (dos_version() < C4DOS_API_V2) return 0;
  return __c4dos_api[C4DOS_SLOT_COUNT] != 0;
}

// ---- v3: the clock ------------------------------------------------------
//
// TIME is opcode 53, above EXIT, so a program that calls it directly
// leaves the base rung. Asking DOS costs nothing above EXIT (this
// header reaches the table through the invoke STUB, not an indirect
// call), which is what lets c4m keep its place in RUNG_BASE and still
// have a clock -- see src/c4dos/c4dos.c dos_api_time.
//
// Gated on BOTH the version word and the slot, the rule every slot at 9
// and above follows: a v1 DOS allocated sixteen words and filled nine,
// so slot 15 on one of those is uninitialised heap, not a zero.
int dos_can_time () {
  if (!dos_present()) return 0;
  if (dos_version() < C4DOS_API_V3) return 0;
  return __c4dos_api[C4DOS_SLOT_TIME] != 0;
}

// Milliseconds since the machine came up, or 0 when there is no clock
// to ask. 0 is also a legitimate reading for the first millisecond of
// uptime, so callers that need to distinguish "no clock" ask
// dos_can_time() first rather than testing the result.
int dos_time () {
  if (!dos_can_time()) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call0((int *)__c4dos_api[C4DOS_SLOT_TIME]);
}

int dos_count () {
  if (!dos_can_enum()) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call0((int *)__c4dos_api[C4DOS_SLOT_COUNT]);
}
char *dos_entname (int i) {
  if (!dos_can_enum()) return 0;
  if (!__c4dos_arm()) return 0;
  return (char *)__c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_ENTNAME], i);
}
int dos_entsize (int i) {
  if (!dos_can_enum()) return 0 - 1;
  if (!__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_ENTSIZE], i);
}
char *dos_entdata (int i) {
  if (!dos_can_enum()) return 0;
  if (!__c4dos_arm()) return 0;
  return (char *)__c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_ENTDATA], i);
}

// Ask DOS for its 4MB read scratch back. Returns bytes released. DOS
// re-allocates it the next time it reads a file, so this costs a
// malloc later, not correctness.
int dos_trim () {
  if (dos_version() < C4DOS_API_V2) return 0;
  if (!__c4dos_api[C4DOS_SLOT_TRIM]) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call0((int *)__c4dos_api[C4DOS_SLOT_TRIM]);
}

// Ask DOS to drop the RAM disk contents. Returns bytes released.
// CALL THIS ONLY AFTER COPYING OUT WHAT YOU WANTED: every pointer
// dos_entdata() returned is dead the moment this returns.
int dos_release () {
  if (dos_version() < C4DOS_API_V2) return 0;
  if (!__c4dos_api[C4DOS_SLOT_RELEASE]) return 0;
  if (!__c4dos_arm()) return 0;
  return __c4dos_call0((int *)__c4dos_api[C4DOS_SLOT_RELEASE]);
}

// ---- slot 1: exit ---------------------------------------------------------
//
// Back to whoever ran us, from any depth, with a status: DOS's prompt,
// or the program that exec'd or started us, or the caller of a catch.
// It does not return. Under no DOS it returns -1, and the caller had
// better return from main itself.
int dos_exit (int status) {
  if (!dos_present()) return 0 - 1;
  if (!__c4dos_api[C4DOS_SLOT_EXIT]) return 0 - 1;
  if (!__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_EXIT], status);
}

// ---- v4: the console, running programs, deleting files ------------------
//
// What a shell needs to be one without a loader of its own (grin,
// docs/grin-plan.md 3.2), and what lets DOS decide where a program's
// console goes. Gated, like everything from slot 9 up, on the version
// word AND the slot; 18 is there only with a RAM disk.
enum { C4DOS_API_V4 = 4 };
enum {
  C4DOS_SLOT_CONWRITE = 16, // conwrite(buf, n) -> n: console output
  C4DOS_SLOT_CONREAD  = 17, // conread(buf, n) -> bytes, at most a line; 0 at end
  C4DOS_SLOT_UNLINK   = 18, // unlink(name) -> 0, or -1: the RAM disk's, or a drive's (v5)
  C4DOS_SLOT_EXEC     = 19, // exec(cmdline) -> its status, as the prompt runs it
  C4DOS_SLOT_LOAD     = 20, // load(path) -> handle, constructors run; 0 on failure
  C4DOS_SLOT_START    = 21, // start(h, argc, argv) -> main's status; h stays loaded
  C4DOS_SLOT_UNLOAD   = 22, // unload(h) -> 0: destructors, image and heap freed; -1
  C4DOS_SLOT_CATCH    = 23, // catch(fn, arg, &exited) -> fn(arg), or exit()'s status
  C4DOS_SLOT_SINK     = 24, // sink(write, read, ctx): console to f(ctx, buf, n); 0 = DOS's
  C4DOS_SLOT_SHELL    = 25, // data, not code: the shell's table (grin's), or 0
  C4DOS_SLOT_GEN      = 26, // gen(h) -> h's heap generation (0: the running image's); 0 without HEAP.SYS
  C4DOS_SLOT_SETGEN   = 27  // setgen(g) -> the previous generation; -1 without HEAP.SYS
};

int dos_v4 (int slot) {
  if (dos_version() < C4DOS_API_V4) return 0;
  return __c4dos_api[slot] != 0;
}

int dos_conwrite (char *buf, int n) {
  if (!dos_v4(C4DOS_SLOT_CONWRITE) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call2((int *)__c4dos_api[C4DOS_SLOT_CONWRITE], (int)buf, n);
}
int dos_conread (char *buf, int n) {
  if (!dos_v4(C4DOS_SLOT_CONREAD) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call2((int *)__c4dos_api[C4DOS_SLOT_CONREAD], (int)buf, n);
}
int dos_unlink (char *name) {
  if (!dos_v4(C4DOS_SLOT_UNLINK) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_UNLINK], (int)name);
}
int dos_exec (char *cmdline) {
  if (!dos_v4(C4DOS_SLOT_EXEC) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_EXEC], (int)cmdline);
}
int dos_load (char *path) {
  if (!dos_v4(C4DOS_SLOT_LOAD) || !__c4dos_arm()) return 0;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_LOAD], (int)path);
}
int dos_start (int h, int argc, char **argv) {
  if (!dos_v4(C4DOS_SLOT_START) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call3((int *)__c4dos_api[C4DOS_SLOT_START], h, argc, (int)argv);
}
int dos_unload (int h) {
  if (!dos_v4(C4DOS_SLOT_UNLOAD) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_UNLOAD], h);
}
// fn is a function's address (&f); exited may be 0
int dos_catch (int *fn, int arg, int *exited) {
  if (!dos_v4(C4DOS_SLOT_CATCH) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call3((int *)__c4dos_api[C4DOS_SLOT_CATCH], (int)fn, arg, (int)exited);
}
int dos_sink (int *w, int *r, int ctx) {
  if (!dos_v4(C4DOS_SLOT_SINK) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call3((int *)__c4dos_api[C4DOS_SLOT_SINK], (int)w, (int)r, ctx);
}
int *dos_shell () {
  if (dos_version() < C4DOS_API_V4) return 0;
  return (int *)__c4dos_api[C4DOS_SLOT_SHELL];
}
// Heap generations (DEVICE=HEAP.SYS), for a shell that runs code of
// several images and must say whose memory a call allocates.
int dos_gen (int h) {
  if (!dos_v4(C4DOS_SLOT_GEN) || !__c4dos_arm()) return 0;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_GEN], h);
}
int dos_setgen (int g) {
  if (!dos_v4(C4DOS_SLOT_SETGEN) || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_SETGEN], g);
}

// ---- v5: drives that can be written ---------------------------------------
//
// create, write and close reach a writable drive (DEVICE=DRIVES.SYS):
// "B:NAME" there, and a plain name on the home drive (HOME=B:) when
// there is one. unlink takes a file off either. DOS keeps each drive's
// c4dos.dir, which DIR B: types. These two say where things are.
enum { C4DOS_API_V5 = 5 };
enum {
  C4DOS_SLOT_HOME   = 28,   // home() -> the home drive, 0 = A:; -1 for none
  C4DOS_SLOT_DRIVES = 29    // drives() -> how many drives (1 without DRIVES.SYS)
};
int dos_home () {
  if (dos_version() < C4DOS_API_V5 || !__c4dos_api[C4DOS_SLOT_HOME] || !__c4dos_arm()) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_HOME], 0);
}
int dos_drives () {
  if (dos_version() < C4DOS_API_V5 || !__c4dos_api[C4DOS_SLOT_DRIVES] || !__c4dos_arm()) return 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_DRIVES], 0);
}

// ---- v6: redirection, and the prompt's drive -------------------------------
//
// With DEVICE=REDIR.SYS a command line takes > >> < and |; conwrite and
// conread (16, 17) follow them, so a program that uses them is
// redirected with nothing more to do (docs/c4dos-design.md
// "Redirection"). The prompt's drive is DOS's, one for every caller: a
// DOS Prompt window asks it after each line it runs.
enum { C4DOS_API_V6 = 6 };
enum { C4DOS_SLOT_DRIVE = 30 };   // drive() -> the drive the prompt is on, 0 = A:
int dos_drive () {
  if (dos_version() < C4DOS_API_V6 || !__c4dos_api[C4DOS_SLOT_DRIVE] || !__c4dos_arm()) return 0;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_DRIVE], 0);
}

// ---- v7: directories --------------------------------------------------------
//
// Every drive has a current directory, and every name DOS takes is a
// path: "GAMES\DOOM\DOOM.C4R", "..\X", "\X" from the root, "B:X" in B:'s
// current directory, "/" as good as "\" (docs/c4dos-design.md
// "Directories"). open, create and unlink (6, 2, 18) and load (20) take
// them as they are; these four are CD, getting it back, MD and RD.
enum { C4DOS_API_V7 = 7 };
enum {
  C4DOS_SLOT_CHDIR  = 31,   // chdir(path) -> 0, or -1: path's drive's current directory
  C4DOS_SLOT_GETCWD = 32,   // getcwd(drive) -> char *: "\GAMES\DOOM"; drive -1 the prompt's
  C4DOS_SLOT_MKDIR  = 33,   // mkdir(path) -> 0, or -1
  C4DOS_SLOT_RMDIR  = 34    // rmdir(path) -> 0, or -1: an empty directory
};
int dos_v7 (int slot) {
  if (dos_version() < C4DOS_API_V7) return 0;
  return __c4dos_api[slot] != 0 && __c4dos_arm();
}
int dos_chdir (char *path) {
  if (!dos_v7(C4DOS_SLOT_CHDIR)) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_CHDIR], (int)path);
}
// DOS's own buffer, good until the next call; 0 before v7
char *dos_getcwd (int drive) {
  if (!dos_v7(C4DOS_SLOT_GETCWD)) return 0;
  return (char *)__c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_GETCWD], drive);
}
int dos_mkdir (char *path) {
  if (!dos_v7(C4DOS_SLOT_MKDIR)) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_MKDIR], (int)path);
}
int dos_rmdir (char *path) {
  if (!dos_v7(C4DOS_SLOT_RMDIR)) return 0 - 1;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_RMDIR], (int)path);
}

// ---- v8: whose code is running ---------------------------------------------
//
// The image DOS counts as running is the parent of what it loads, the
// owner of the files it opens for writing, and gen(0)'s answer. A shell
// whose code a child calls directly, not through DOS, says "this is mine
// now" with image(its own handle) and gives the old one back after:
// grin's game window, whose poll runs grin's loop for the game
// (docs/grin-plan.md 3.6). image(0) only asks; it is the caller's own
// handle when asked from its main.
enum { C4DOS_API_V8 = 8 };
enum { C4DOS_SLOT_IMAGE = 35 };   // image(h) -> the image that was running (h = 0: no change)
int dos_image (int h) {
  if (dos_version() < C4DOS_API_V8 || !__c4dos_api[C4DOS_SLOT_IMAGE] || !__c4dos_arm()) return 0;
  return __c4dos_call1((int *)__c4dos_api[C4DOS_SLOT_IMAGE], h);
}
include/c4dos_native.h 1942
// c4dos_native.h -- the C4DOS API, stubbed out for a host build.
//
// include/c4dos.h cannot be compiled by gcc: its invoke stub calls one
// function with varying argument counts, which is an ordinary c4 idiom
// and a hard error in C. A tool that wants to save a file under C4DOS
// therefore gets the real API when it is built for the machine
//   ./c4cc -o tool.c4r include/c4dos.h tool.c
// and these stubs when it is built for the host
//   gcc -include include/c4dos_native.h -o tool tool.c
// so the same source compiles both ways and reports honestly that
// there is no DOS here rather than pretending to write.
static int dos_present () { return 0; }
static int dos_can_write () { return 0; }
static int dos_create (char *name) { (void)name; return -1; }
static int dos_write (int h, char *buf, int len) { (void)h; (void)buf; (void)len; return 0; }
static int dos_close (int h) { (void)h; return 0; }
static int dos_put (char *name, char *buf, int len) { (void)name; (void)buf; (void)len; return -1; }
static int dos_readable () { return 0; }
static int dos_fopen (char *name) { (void)name; return -1; }
static int dos_fread (int h, char *buf, int len) { (void)h; (void)buf; (void)len; return 0; }
static int dos_fclose (int h) { (void)h; return 0; }
static int dos_slurp (char *name, char *buf, int max) { (void)name; (void)buf; (void)max; return -1; }
// v2: enumeration and memory hand-back. A host build has no RAM disk
// to enumerate and no DOS to give memory back to, so these report an
// empty, version-0 system -- the same honest answer the v1 stubs give.
static int dos_version () { return 0; }
static int dos_can_enum () { return 0; }
static int dos_count () { return 0; }
static char *dos_entname (int i) { (void)i; return 0; }
static int dos_entsize (int i) { (void)i; return -1; }
static char *dos_entdata (int i) { (void)i; return 0; }
static int dos_trim () { return 0; }
static int dos_release () { return 0; }
include/c4_float.h 14084
//
// C4 Standard Library: c4_float.h
//
// IEEE-754 binary32 ("float") arithmetic implemented entirely in C4.
//
// C4 has no float type, so a value is carried in an ordinary int as its 32-bit
// bit pattern -- exactly the representation c4m's native FLTI_* instructions
// use. Everything here is integer arithmetic on that pattern, so it works on
// unmodified c4, on c4m, and inside C4KE, with no interpreter support at all.
//
//   int x, y, z;
//   x = f32_from_int(7);
//   y = f32_from_string("0.5");
//   z = f32_div(x, y);              // 14.0
//   f32_print(z, 6);                // "14.000000"
//
// Results are bit-for-bit identical to C 'float' arithmetic for normal values,
// including round-to-nearest-even. Verified against a native C reference in
// src/tests/test_float.c.
//
// Supported: finite normals, signed zero, infinity, NaN, and correct rounding
//            for + - * / and conversions.
// Simplified: subnormal values flush to zero (they are the only case where
//            this library and hardware differ). NaN payloads are not
//            preserved; a canonical quiet NaN is produced.
//
// Why binary32 and not binary64: a C4 word is 64 bits, so a 24-bit significand
// product (48 bits) fits with room for guard bits and no unsigned type is
// needed. binary64 would need 106-bit intermediates, i.e. 128-bit multiply
// emulation -- doable, but not a prototype.
//

#ifndef __C4_FLOAT_H
#define __C4_FLOAT_H 1

#include <stddef.h>

// Field layout of IEEE-754 binary32
enum {
	F32_SIGNBIT  = 0x80000000,
	F32_EXPMASK  = 0x7F800000,
	F32_MANMASK  = 0x007FFFFF,
	F32_HIDDEN   = 0x00800000,  // 1 << 23
	F32_EXPMAX   = 0xFF,        // exponent field for inf/nan
	F32_BIAS     = 127,
	F32_WORD     = 0xFFFFFFFF,  // keep results inside 32 bits

	// Working significands carry 3 extra low bits: guard, round, sticky.
	F32_GUARD    = 3,
	F32_TOP27    = 0x08000000,  // 1 << 27
	F32_TOP26    = 0x04000000,  // 1 << 26
	F32_TOP24    = 0x01000000,  // 1 << 24

	// Common values
	F32_ZERO     = 0x00000000,
	F32_NEGZERO  = 0x80000000,
	F32_ONE      = 0x3F800000,
	F32_INF      = 0x7F800000,
	F32_NEGINF   = 0xFF800000,
	F32_NAN      = 0x7FC00000
};

///
/// Classification
///

static int f32_exp_field (int x) { return (x >> 23) & F32_EXPMAX; }
static int f32_man_field (int x) { return x & F32_MANMASK; }
static int f32_sign      (int x) { return (x >> 31) & 1; }

static int f32_is_nan  (int x) { return f32_exp_field(x) == F32_EXPMAX && f32_man_field(x) != 0; }
static int f32_is_inf  (int x) { return f32_exp_field(x) == F32_EXPMAX && f32_man_field(x) == 0; }
static int f32_is_zero (int x) { return (x & 0x7FFFFFFF) == 0; }

///
/// Internal helpers
///

// Assemble a value from its fields.
static int f32_pack (int sign, int exp, int man) {
	return ((sign ? F32_SIGNBIT : 0) | ((exp & F32_EXPMAX) << 23) | (man & F32_MANMASK)) & F32_WORD;
}

static int f32_inf_signed  (int sign) { return sign ? F32_NEGINF : F32_INF; }
static int f32_zero_signed (int sign) { return sign ? F32_NEGZERO : F32_ZERO; }

// Shift right by n, OR-ing everything shifted out into the low (sticky) bit.
static int f32_shr_sticky (int m, int n) {
	int sticky;

	if (n <= 0) return m;
	if (n > 30) return (m != 0) ? 1 : 0;
	sticky = (m & ((1 << n) - 1)) != 0;
	return (m >> n) | sticky;
}

// Round a 27-bit significand (24 value bits + guard/round/sticky) to 24 bits,
// nearest, ties to even.
static int f32_round27 (int m) {
	int extra;

	extra = m & 7;
	m = m >> F32_GUARD;
	if (extra > 4) ++m;
	else if (extra == 4 && (m & 1)) ++m;
	return m;
}

// Normalise a rounded significand and exponent into a finished value.
// Handles significand overflow from rounding, plus over/underflow.
static int f32_finish (int sign, int exp, int m) {
	if (m >= F32_TOP24) { m = m >> 1; ++exp; }
	if (exp >= F32_EXPMAX) return f32_inf_signed(sign);
	if (exp <= 0) return f32_zero_signed(sign);   // subnormals flush to zero
	return f32_pack(sign, exp, m & F32_MANMASK);
}

///
/// Sign
///

static int f32_neg (int x) { return (x ^ F32_SIGNBIT) & F32_WORD; }
static int f32_abs (int x) { return x & 0x7FFFFFFF; }

///
/// Addition and subtraction
///

static int f32_add (int a, int b) {
	int sa, ea, ma, sb, eb, mb;
	int sr, er, mr, d;

	if (f32_is_nan(a) || f32_is_nan(b)) return F32_NAN;

	sa = f32_sign(a); sb = f32_sign(b);

	if (f32_is_inf(a)) {
		// inf + -inf is undefined
		if (f32_is_inf(b) && sa != sb) return F32_NAN;
		return a;
	}
	if (f32_is_inf(b)) return b;

	if (f32_is_zero(a)) {
		// -0 + -0 is -0; every other zero sum is +0
		if (f32_is_zero(b)) return (sa && sb) ? F32_NEGZERO : F32_ZERO;
		return b;
	}
	if (f32_is_zero(b)) return a;

	ea = f32_exp_field(a); ma = f32_man_field(a);
	eb = f32_exp_field(b); mb = f32_man_field(b);

	// Subnormal inputs flush to zero.
	if (ea == 0) return b;
	if (eb == 0) return a;

	// Restore the hidden bit and make room for guard/round/sticky.
	ma = (ma | F32_HIDDEN) << F32_GUARD;
	mb = (mb | F32_HIDDEN) << F32_GUARD;

	// Align to the larger exponent.
	if (ea > eb) {
		d = ea - eb;
		mb = f32_shr_sticky(mb, d);
		eb = ea;
	} else if (eb > ea) {
		d = eb - ea;
		ma = f32_shr_sticky(ma, d);
		ea = eb;
	}
	er = ea;

	if (sa == sb) {
		mr = ma + mb;
		sr = sa;
	} else if (ma >= mb) {
		mr = ma - mb;
		sr = sa;
	} else {
		mr = mb - ma;
		sr = sb;
	}

	// Exact cancellation gives +0 (round-to-nearest rounding direction).
	if (mr == 0) return F32_ZERO;

	// Renormalise.
	while (mr >= F32_TOP27) { mr = f32_shr_sticky(mr, 1); ++er; }
	while (mr < F32_TOP26 && er > 1) { mr = mr << 1; --er; }
	if (mr < F32_TOP26) return f32_zero_signed(sr);   // underflowed to subnormal

	return f32_finish(sr, er, f32_round27(mr));
}

static int f32_sub (int a, int b) { return f32_add(a, f32_neg(b)); }

///
/// Multiplication
///

static int f32_mul (int a, int b) {
	int sa, ea, ma, sb, eb, mb;
	int sr, er, mr;

	if (f32_is_nan(a) || f32_is_nan(b)) return F32_NAN;

	sa = f32_sign(a); sb = f32_sign(b);
	sr = sa ^ sb;

	if (f32_is_inf(a)) return f32_is_zero(b) ? F32_NAN : f32_inf_signed(sr);
	if (f32_is_inf(b)) return f32_is_zero(a) ? F32_NAN : f32_inf_signed(sr);
	if (f32_is_zero(a) || f32_is_zero(b)) return f32_zero_signed(sr);

	ea = f32_exp_field(a); ma = f32_man_field(a);
	eb = f32_exp_field(b); mb = f32_man_field(b);
	if (ea == 0 || eb == 0) return f32_zero_signed(sr);   // subnormal input

	ma = ma | F32_HIDDEN;
	mb = mb | F32_HIDDEN;

	// 24 x 24 = 48 bits, comfortably inside a 64-bit word.
	mr = ma * mb;
	er = ea + eb - F32_BIAS;

	// Two 24-bit significands give a product in [2^46, 2^48). Reduce it to the
	// 27-bit working form, whose leading bit sits at 26. The 1 is cast
	// because a native build widens the int TYPE to 64 bits but a bare
	// literal stays C's 32-bit int, making 1 << 47 undefined.
	if (mr >= ((int)1 << 47)) {
		mr = f32_shr_sticky(mr, 21);
		++er;
	} else {
		mr = f32_shr_sticky(mr, 20);
	}

	if (er >= F32_EXPMAX) return f32_inf_signed(sr);
	if (er <= 0) return f32_zero_signed(sr);

	return f32_finish(sr, er, f32_round27(mr));
}

///
/// Division
///

static int f32_div (int a, int b) {
	int sa, ea, ma, sb, eb, mb;
	int sr, er, mr, rem;

	if (f32_is_nan(a) || f32_is_nan(b)) return F32_NAN;

	sa = f32_sign(a); sb = f32_sign(b);
	sr = sa ^ sb;

	if (f32_is_inf(a)) return f32_is_inf(b) ? F32_NAN : f32_inf_signed(sr);
	if (f32_is_inf(b)) return f32_zero_signed(sr);
	if (f32_is_zero(a)) return f32_is_zero(b) ? F32_NAN : f32_zero_signed(sr);
	if (f32_is_zero(b)) return f32_inf_signed(sr);       // x / 0 is infinity

	ea = f32_exp_field(a); ma = f32_man_field(a);
	eb = f32_exp_field(b); mb = f32_man_field(b);
	if (ea == 0) return f32_zero_signed(sr);
	if (eb == 0) return f32_inf_signed(sr);

	ma = ma | F32_HIDDEN;
	mb = mb | F32_HIDDEN;

	// ma/mb lies in (0.5, 2), so scaling the numerator by 2^27 puts the
	// quotient in (2^26, 2^28). ma < 2^24, so ma << 27 < 2^51 -- no overflow.
	mr  = (ma << 27) / mb;
	rem = (ma << 27) % mb;

	er = ea - eb + F32_BIAS;

	// Normalise into the 27-bit working form, whose leading bit sits at 26.
	// mr >= 2^27 means the quotient is >= 1.0 and needs one shift down;
	// otherwise it is in (0.5, 1.0) and only the exponent moves.
	if (mr >= F32_TOP27) {
		if (mr & 1) rem = 1;         // the bit about to be dropped is sticky too
		mr = mr >> 1;
	} else
		--er;
	if (rem != 0) mr = mr | 1;       // sticky

	if (er >= F32_EXPMAX) return f32_inf_signed(sr);
	if (er <= 0) return f32_zero_signed(sr);

	return f32_finish(sr, er, f32_round27(mr));
}

///
/// Comparison
///
/// f32_cmp returns -1, 0 or 1. Any comparison involving NaN is unordered;
/// f32_cmp reports 2 for that case so callers can tell it apart.
///

static int f32_cmp (int a, int b) {
	int sa, sb;

	if (f32_is_nan(a) || f32_is_nan(b)) return 2;
	if (f32_is_zero(a) && f32_is_zero(b)) return 0;   // -0 == +0

	sa = f32_sign(a); sb = f32_sign(b);
	if (sa != sb) return sa ? -1 : 1;

	// Same sign: the bit patterns order the same way as the values, reversed
	// for negatives.
	a = a & 0x7FFFFFFF;
	b = b & 0x7FFFFFFF;
	if (a == b) return 0;
	if (sa) return (a > b) ? -1 : 1;
	return (a > b) ? 1 : -1;
}

static int f32_eq (int a, int b) { return f32_cmp(a, b) == 0; }
static int f32_lt (int a, int b) { return f32_cmp(a, b) == -1; }
static int f32_le (int a, int b) { int c; c = f32_cmp(a, b); return c == -1 || c == 0; }
static int f32_gt (int a, int b) { return f32_cmp(a, b) == 1; }
static int f32_ge (int a, int b) { int c; c = f32_cmp(a, b); return c == 1 || c == 0; }

///
/// Conversion
///

static int f32_from_int (int v) {
	int sign, exp, m, sticky, bits;

	if (v == 0) return F32_ZERO;

	sign = 0;
	if (v < 0) {
		sign = 1;
		// Do not negate the most negative value; handle it directly.
		if (v == (0 - 0x7FFFFFFFFFFFFFFF) - 1) return f32_pack(1, F32_BIAS + 63, 0);
		v = 0 - v;
	}

	// Find the position of the top set bit.
	bits = 0;
	m = v;
	while (m != 0) { m = (m >> 1) & 0x7FFFFFFFFFFFFFFF; ++bits; }
	exp = F32_BIAS + bits - 1;

	// Reduce to 27 bits (24 value + guard/round/sticky).
	if (bits > 27) {
		sticky = bits - 27;
		m = f32_shr_sticky(v, sticky);
	} else
		m = v << (27 - bits);

	return f32_finish(sign, exp, f32_round27(m));
}

// Truncate toward zero, C-style.
static int f32_to_int (int x) {
	int sign, exp, m, shift;

	if (f32_is_nan(x) || f32_is_zero(x)) return 0;

	sign = f32_sign(x);
	exp  = f32_exp_field(x);
	if (f32_is_inf(x)) return sign ? (0 - 0x7FFFFFFFFFFFFFFF) - 1 : 0x7FFFFFFFFFFFFFFF;
	if (exp == 0) return 0;                     // subnormal

	exp = exp - F32_BIAS;
	if (exp < 0) return 0;                      // |x| < 1
	if (exp > 62) return sign ? (0 - 0x7FFFFFFFFFFFFFFF) - 1 : 0x7FFFFFFFFFFFFFFF;

	m = f32_man_field(x) | F32_HIDDEN;          // 24 bits, binary point after bit 23
	shift = exp - 23;
	if (shift >= 0) m = m << shift;
	else m = m >> (0 - shift);

	return sign ? 0 - m : m;
}

///
/// Text
///

// Parse a decimal number: [+-]digits[.digits][(e|E)[+-]digits]
// Returns the value; *end (if given) receives the first unconsumed character.
static int f32_from_string (char *s, char **end) {
	int sign, r, digits, any, esign, eval, i;
	int ten, frac, scale;

	ten  = f32_from_int(10);
	r    = F32_ZERO;
	sign = 0;
	any  = 0;

	while (*s == ' ' || *s == 9) ++s;
	if (*s == '-') { sign = 1; ++s; }
	else if (*s == '+') ++s;

	// Integer part: accumulate as a float so large inputs still work.
	while (*s >= '0' && *s <= '9') {
		r = f32_add(f32_mul(r, ten), f32_from_int(*s - '0'));
		++s; any = 1;
	}

	// Fraction: gather digits as an integer, then divide by the power of ten.
	if (*s == '.') {
		++s;
		frac = 0; digits = 0;
		while (*s >= '0' && *s <= '9') {
			// Stop accumulating once more digits cannot affect a float.
			if (digits < 9) { frac = frac * 10 + (*s - '0'); ++digits; }
			++s; any = 1;
		}
		if (digits) {
			scale = 1;
			i = 0;
			while (i < digits) { scale = scale * 10; ++i; }
			r = f32_add(r, f32_div(f32_from_int(frac), f32_from_int(scale)));
		}
	}

	if (!any) { if (end) *end = s; return F32_ZERO; }

	// Exponent.
	if (*s == 'e' || *s == 'E') {
		++s;
		esign = 0;
		if (*s == '-') { esign = 1; ++s; }
		else if (*s == '+') ++s;
		eval = 0;
		while (*s >= '0' && *s <= '9') { eval = eval * 10 + (*s - '0'); ++s; }
		if (eval > 60) eval = 60;              // beyond float range either way
		i = 0;
		while (i < eval) {
			if (esign) r = f32_div(r, ten);
			else r = f32_mul(r, ten);
			++i;
		}
	}

	if (end) *end = s;
	return sign ? f32_neg(r) : r;
}

// Render into 'buf' with 'prec' digits after the point, C's %f style.
// Returns the number of characters written (excluding the nul).
// 'buf' should have room for prec + 24 characters.
static int f32_to_string (int x, char *buf, int prec) {
	char *p;
	int ipart, i, d, sign;
	int frac, ten, digit;
	int ip, len, j;
	char *t;

	p = buf;

	if (f32_is_nan(x)) { *p++ = 'n'; *p++ = 'a'; *p++ = 'n'; *p = 0; return 3; }
	sign = f32_sign(x);
	if (f32_is_inf(x)) {
		if (sign) *p++ = '-';
		*p++ = 'i'; *p++ = 'n'; *p++ = 'f'; *p = 0;
		return p - buf;
	}

	if (prec < 0) prec = 6;
	if (prec > 9) prec = 9;

	if (sign) { *p++ = '-'; x = f32_abs(x); }

	ten = f32_from_int(10);

	// Integer part.
	ipart = f32_to_int(x);
	frac  = f32_sub(x, f32_from_int(ipart));

	// Emit the integer part, digits reversed then flipped.
	t = p;
	if (ipart == 0) *p++ = '0';
	else {
		ip = ipart;
		while (ip != 0) { *p++ = '0' + (ip % 10); ip = ip / 10; }
		len = p - t;
		i = 0; j = len - 1;
		while (i < j) { d = t[i]; t[i] = t[j]; t[j] = (char)d; ++i; --j; }
	}

	if (prec > 0) {
		*p++ = '.';
		i = 0;
		while (i < prec) {
			frac  = f32_mul(frac, ten);
			digit = f32_to_int(frac);
			if (digit < 0) digit = 0;
			if (digit > 9) digit = 9;
			*p++ = '0' + digit;
			frac = f32_sub(frac, f32_from_int(digit));
			++i;
		}
	}

	*p = 0;
	return p - buf;
}

// Convenience: print a value with the given precision. Uses the buffer
// supplied so this header needs no allocation of its own.
static int f32_print_buf (int x, char *buf, int prec) {
	f32_to_string(x, buf, prec);
	return printf("%s", buf);
}

#endif /* ifndef __C4_FLOAT_H */
include/c4.h 3453
#ifndef __C4_H
#define __C4_H 1

// Determine whether this is compiled natively or not.
#if __c4cc__
#define NATIVE 0
#elif __GNUC__ // #if __c4cc_
#define NATIVE 1
#else          // #elif __GNUC__
// TODO: MSVC detection
#define NATIVE 1
#endif         // #if __c4cc__

// Make it easier for C4PRE
#if NATIVE
#define NOT_NATIVE 0
#else // #if NATIVE
#define NOT_NATIVE 1
#endif

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <memory.h>
#include <fcntl.h>

#ifdef __GNUC__
#include <unistd.h>
#else
#if _WIN64
#define __INTPTR_TYPE__ long long
#elif _WIN32
#define __INTPTR_TYPE__ int
#endif // if _WIN64
#endif // ifdef __GNUC__

// For windows, remove __attribute__
#ifndef __GNUC__
// ...but NOT under c4cc. __attribute__((constructor)) is how a source
// tells c4cc which functions belong in the image's constructor table,
// and every C4KE extension registers itself from one. Stripping it
// here is why a kernel PREPROCESSED BY OUR OWN cpp (the in-machine
// build: C4DOS runs cpp.c4r, which does not define __GNUC__) came up
// with zero extensions, while the host build via gcc -E did not.
#ifndef __c4cc__
#define __attribute__(x)
#endif
// No SIGRTMAX, define our own
#define SIGRTMAX 64
#endif

#ifdef C4M_SIGNALS
// On C4CC, handle signals differently.
// TODO: Not handled at all right now, but under c4m could work.
#ifdef C4CC
int __c4_signal_init () { return 0; }
int pending_signal; // if a signal is pending
int *signal_handlers;
void __c4_signal_shutdown () { }

// On C4CC, use the direct time and sleep functions supported by c4m.
#define c4m_time() __time()
#define usleep(x)  __c4_usleep(x)
#else // #ifdef C4CC
// On all other platforms, try to implement signal handling.

#pragma GCC diagnostic ignored "-Wformat"
#pragma GCC diagnostic ignored "-Wformat-security"
#pragma GCC diagnostic ignored "-Wunused-result"

// Support signal handlers
#include <signal.h>
#include <stdlib.h>
static __INTPTR_TYPE__ *signal_handlers;
static __INTPTR_TYPE__  pending_signal;
static void c4_sig_handler (int sig) {
	// printf("c4m: sig handler %d\n", sig);
	pending_signal = sig;
}
static int __c4_signal_init () {
	__INTPTR_TYPE__ t;
	if (signal_handlers == 0) {
		// First initialization
		if (!(signal_handlers = malloc(t = sizeof(int) * SIGRTMAX))) {
			printf("c4m: signal handler allocation failure\n");
			return 1;
		}
		// Initialize handlers to 0
		memset(signal_handlers, 0, t);
	}
	return 0;
}
static __INTPTR_TYPE__ *__c4_signal (__INTPTR_TYPE__ sig, __INTPTR_TYPE__ *handler) {
	__INTPTR_TYPE__ *old;
	old = 0;
	// printf("c4m: installing signal handler for signal %d @ 0x%x\n", sig, handler);
	//return (__INTPTR_TYPE__) signal(sig, handler);
	if (signal_handlers[sig]) {
		// printf("c4m: overwriting signal handler\n");
		old = (__INTPTR_TYPE__ *)signal_handlers[sig];
	}
	signal_handlers[sig] = (__INTPTR_TYPE__)handler;
	signal(sig, c4_sig_handler);
	return old;
}
static void __c4_signal_shutdown () {
	if (signal_handlers) {
		free(signal_handlers);
		signal_handlers = 0;
	}
}

static int __c4_sigint () { return SIGINT; }

#ifdef __c4_usleep
// TODO: why is this causing issues?
#undef __c4_usleep
#undef __opcode
static int __c4_usleep (int useconds) {
	return usleep(useconds);
}
#endif // ifdef __c4_usleep

#endif // #ifndef C4CC

#endif // #ifdef C4M_SIGNALS

#ifndef C4CC
// Please define this for your architecture if required.
#define int __INTPTR_TYPE__
#endif

#endif // ifndef __C4_H
include/c4ke.h 19195
// u0.c - C4KE user runtime
// Intended to be compiled with user applications.
//
// - Overrides calls to various system functions like exit so that a
//   C4KE-friendly variant can run instead.
//   See exit() in this file.
// - Discovers opcodes by requesting them from the kernel.
// - C-friendly functions for using the new opcodes.
//
// In the future this will become a library and header file, but for
// now C4CC does not have a preprocessor. It would be better to have
// a header file define the interface instead of requesting opcodes
// from the kernel.

#ifndef __U0_C
#define __U0_C

#include "c4.h"
#include "c4m.h"

enum { U0_DEBUG = 0 };

// C4KE opcode: int request_opcode(char *name)
enum { OP_REQUEST_SYMBOL = 128 };

// Task priveleges
enum { PRIV_NONE, PRIV_USER, PRIV_KERNEL };

// Kernel task information
enum {
	KTI_COUNT,
	KTI_USED,
	KTI_LIST,  // see KTE_*
	KTI__Sz
};

// Kernel task element
enum {
	// First element, so can be referenced as *kte instead of kte[KTE_TASK_STATE]
	KTE_TASK_STATE,    // int
	KTE_TASK_WAITSTATE,// int
	KTE_TASK_ID,       // int
	KTE_TASK_PARENT,   // int
	KTE_TASK_NAME,     // char *
	KTE_TASK_NAMELEN,  // int
	KTE_TASK_PRIORITY, // int
	KTE_TASK_PRIVS,    // int, PRIV_*
	KTE_TASK_NICE,     // int
	KTE_TASK_CYCLES,   // int
	KTE_TASK_CYCLES_HI,// int, billions; total = HI * 1000000000 + CYCLES
	KTE_TASK_TIMEMS,   // int
	KTE_TASK_TRAPS,    // int
	KTE_TASK_STACK,    // int
	KTE_TASK_ALLOC,    // int
	KTE__Sz
};

// Task state, keep up to date with c4ke.c
enum {
	STATE_UNLOADED = 0x0,
	STATE_LOADED   = 0x1,
	STATE_RUNNING  = 0x2,
	STATE_WAITING  = 0x4,
	STATE_TRAPPED  = 0x8,
	STATE_ETHEREAL = 0x10, // Not a real task, used by kernel process
	STATE_ZOMBIE   = 0x20, // Waiting to die
};

// Wait states
enum {
	WSTATE_NONE,     // Not waiting
	WSTATE_TIME,     // Waiting for a time target. WAITARG is target timestamp
	WSTATE_PID,      // Waiting for a process to terminate. WAITARG is the pid.
	WSTATE_SYSCALL,  // Waiting for a system call. WAITARG is syscall status (0 == not done)
	WSTATE_MESSAGE,  // Waiting for a message. WAITARG is the "give up" timestamp
};


// __c4_info() flags

// C4INFO state
enum {
	C4I_NONE = 0x0,  // No C4 info
	C4I_C4   = 0x1,  // Ultimately running under C4
	C4I_C4M  = 0x2,  // Running under c4m (directly or C4)
	C4I_C4P  = 0x4,  // Running under c4plus
	C4I_C4MJS= 0x8,  // Running under C4M.JS host
	C4I_HRT  = 0x10, // High resolution timer
	C4I_SIG  = 0x20, // Signals supported
	C4I_FLT  = 0x40, // Floating point instruction support
	C4I_PROT = 0x80, // Protected mode support
	C4I_C4KE = 0x200, // C4KE is running
};

// TODO: make a c4cc header file
// Trap codes
enum {
	// Illegal opcode, allows custom opcodes to be implemented using
	// install_trap_handler()
	TRAP_ILLOP,
	// Hard IRQ generated by c4m under some condition
	TRAP_HARD_IRQ,
	// Soft IRQ generated by user code
	TRAP_SOFT_IRQ,
	// A POSIX signal was received
	TRAP_SIGNAL,
	// Invalid memory read or write
	TRAP_SEGV,
	// Invalid opcode value (specifically with OPCD)
	TRAP_OPV,
};
// TRAP_HARD_IRQ codes
enum {
	HIRQ_CYCLE       // Cycle, runs every X cycles
};

#ifndef C4CC
#undef __c4_trap
#define __c4_trap(a,b)
#endif

// Signals
// Stop regular compilers from caring about these signals
#undef SIGHUP
#undef SIGINT
#undef SIGQUIT
#undef SIGILL
#undef SIGTRAP
#undef SIGABRT
#undef SIGBUS
#undef SIGFPE
#undef SIGKILL
