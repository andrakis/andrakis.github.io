// execute a task directly with no arguments
int kern_user_exec (char *path) {
	char **argv;
	argv = (char **)"kern_user_exec temporary space";
	argv[0] = path;
	return kern_user_start_c4r(1, argv, path, PRIV_USER);
}

// No longer a kernel call
void kern_print_task_state (int s) {
	//if(s & STATE_LOADED)  { printf("L"); }
	if(s & STATE_ZOMBIE)       printf("Z");
	else if(s & STATE_WAITING) printf("W");
	else if(s & STATE_TRAPPED) printf("T");
	else if(s & STATE_RUNNING) printf("R");
	else                       printf("U");
}

