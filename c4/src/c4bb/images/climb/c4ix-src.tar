static int srand (int seed) { __u0_rand_next = seed; }
static int rand () {
	__u0_rand_next = __u0_rand_next * 1103515245 + 12345;
    return (__u0_rand_next / 65536) % RAND_MAX;
}

// TODO: implement in c4m, also srand() etc
static int random () {
	int fd, result, i;
	// TODO: just calls rand()
	return rand();
	
	// unused for now:
	if ((fd = open("/dev/urandom", 0)) < 0) {
		if ((fd = open("/dev/random", 0)) < 0) {
			printf("u0: random() failure - cannot read from /dev/urandom or /dev/random\n");
			return 0;
		}
	}
	if ((i = read(fd, &result, sizeof(int)) <= 0)) {
		printf("u0: random() failure - read returned %d\n", i);
	}
	close(fd);
	return result;
}
#endif

