#define isalnum((c)) (isnum((c)) || isalpha((c)))
#define tolower((c)) ((c) | ' ')
#define toupper((c)) ((c) & '_')
#endif /* if NO_INLINE/else */
#endif /* ifndef __ctype_defined */


#endif /* ifndef __c4cc__ */

