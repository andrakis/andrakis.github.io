#if NO_INLINE
int isnum (char c) { return c >= '0' && c <= '9'; }
int isspace (char c) { return c <= ' '; }
int isalpha (char c) { return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'); }
int isalnum (char c) { return isnum(c) || isalpha(c); }
char tolower (char c) { return c | ' '; }
